# Run ./docker/configure.sh to create .env and detect the host KVM group.
# Re-running the helper preserves other settings and refreshes KVM_GID.

# The image catalog starts empty. Upload QCOW2 templates through Admin.
# Templates and VM disks persist in the gateway-state volume.

# Local development defaults: bundled LDAP uses public demo credentials.
GATEWAY_BIND=127.0.0.1
GATEWAY_HOST=localhost
GATEWAY_PORT=8443

GATEWAY_ENCODER=auto
GATEWAY_CPUS=2
GATEWAY_MEMORY=4096
GATEWAY_MAX_RUNNING=4
