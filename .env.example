# Compose settings. Run ./docker/configure.sh to create .env and detect KVM_GID.
# Re-running the helper preserves other settings and refreshes KVM_GID.
# The native executable reads exported variables; it does not load .env files.
# See docs/configuration.md for all defaults and the equivalent legacy flags.

# Host deployment settings; these configure Compose's published port.
GATEWAY_BIND=127.0.0.1
GATEWAY_HOST=localhost
GATEWAY_PORT=8443
# PUBLIC_ADDRESS defaults to GATEWAY_HOST:GATEWAY_PORT; uncomment to override.
# PUBLIC_ADDRESS=localhost:8443

# Container paths. Upload QCOW2 templates through Admin; the catalog starts empty.
# Changing paths requires corresponding volume mounts in compose.yaml.
DATA_ROOT_DIR=/var/lib/gokvm
BASE_IMAGE=
VM_BINARY=
UEFI_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
UEFI_VARS_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.fd

# New desktop defaults and admission limits. 0 selects automatic memory budget.
H264_ENCODER=auto
# office caps H.264 at 30 FPS; smooth targets 60 FPS. Bitmap fallback stays at 30 FPS.
RDP_PROFILE=office
VM_KEYBOARD=us
VM_VCPU_COUNT=2
VM_MEMORY_MIB=4096
VM_MEMORY_BUDGET_MIB=0
MAX_VDI_PER_USER=3
MAX_RUNNING_VMS=4
MAX_CONCURRENT_CREATIONS=2
# Maximum bytes per uploaded or normalized file (20 GiB).
IMAGE_UPLOAD_MAX_BYTES=21474836480
IMAGE_UPLOAD_TIMEOUT=30m
VM_CREATE_TIMEOUT=30m
VM_START_TIMEOUT=30s
VM_STOP_TIMEOUT=30s

# Keep the internal port at 8443 unless the Compose port mapping is also changed.
LISTEN_ADDR=0.0.0.0:8443
# Empty PEM paths select automatic self-signed TLS, unless ACME is enabled.
CERT_FILE=
KEY_FILE=
# For ACME, use a public DNS hostname and make public TCP 443 reach the gateway.
ACME_ENABLE=false
ACME_EMAIL=
# production, staging, or an ACME directory URL.
ACME_CA=production

# Bundled development LDAP uses public demo credentials. Replace for remote use.
# These paths/addresses are inside the container, not on the host.
AUTH_FILE=
LDAP_URL=ldaps://ldap:389
LDAP_BASE_DN=dc=glauth,dc=com
LDAP_USER_DOMAIN=example.com
LDAP_USER_FILTER=(mail=%s)
LDAP_USERNAME_ATTRIBUTE=mail
LDAP_REQUIRED_GROUP=ou=team10_r,ou=groups,dc=glauth,dc=com
ADMIN_GROUP=devbox-admins
LDAP_CA_FILE=/etc/gokvm/ldap/cert.pem
LDAP_INSECURE_LOOPBACK=false
LDAP_AUTH_TIMEOUT=10s
SESSION_TTL=8h
MAX_SESSIONS=1024
# Authenticated and pending connections have independent global pools.
MAX_CONCURRENT_CONNECTIONS=128
MAX_HANDSHAKES=64
# Source limits group IPv6 by /64; tune for shared NATs. Connections include both pools.
MAX_CONNECTIONS_PER_IP=32
MAX_HANDSHAKES_PER_IP=8
# Admission rates per second; each token bucket permits an equal-size burst.
CONNECTION_RATE_LIMIT=128
CONNECTION_RATE_LIMIT_PER_IP=8
# Total time from TCP acceptance to application authentication (not just TLS).
HANDSHAKE_TIMEOUT=10s

# Existing Compose GATEWAY_ENCODER/CPUS/MEMORY/MAX_RUNNING and GATEWAY_ACME,
# GATEWAY_ACME_EMAIL/CA remain fallbacks when the canonical variable is unset.
# Canonical names above take precedence, including explicitly empty values.
