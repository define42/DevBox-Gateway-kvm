+    // rounding and scale entries, doubled and halved.
+    const int32_t kiRange = (iTest & 1) ? 4080 : 64;
+    for (int32_t i = 0; i < 64; i++)
+      iResRef[i] = iRes[i] = (int16_t) ((rand() % (2 * kiRange + 1)) - kiRange);
