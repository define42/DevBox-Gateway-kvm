+    movdqa      xmm5, xmm2
+    pavgb       xmm2, xmm0
+
+    pxor        xmm5, xmm0
+    pand        xmm5, [pic(mmx_01bytes)]
+    psubusb     xmm2, xmm5
+
+    pavgb       xmm2, xmm3
+
+    psrlq       xmm2, 8h
+    pxor        xmm2, xmm4
+
+    punpcklbw   xmm1, xmm2
+    psrldq      xmm1, 8             ;MMX punpckhbw mm1,mm2
+    punpcklbw   xmm4, xmm4
+    psrldq      xmm4, 8             ;MMX punpckhbw mm4,mm4
+    punpcklbw   xmm4, xmm4
+    psrldq      xmm4, 8             ;MMX punpckhbw mm4,mm4
+
+    psrlq       xmm4, 20h
+    movd        [r0+12], xmm4
