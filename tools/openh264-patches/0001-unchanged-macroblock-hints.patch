+ *
+ * \file    unchanged.cpp
+ *
+ * \brief   Optional unchanged-macroblock hints (DevBox-Gateway-kvm extension).
+ *          A line-by-line counterpart of the pure-Go port's unchanged.go.
+ */
+#include <stddef.h>
+#include <string.h>
+
+#include "unchanged.h"
+#include "encoder_context.h"
+#include "md.h"
