+
+    psrlq       xmm2, 20h
+    psllq       xmm2, 30h
+    movdqa      xmm4, xmm3
+    psrlq       xmm4, 10h
+    pxor        xmm2, xmm4
+    psrlq       xmm2, 20h
+
+    movd        [r0], xmm2
+    movd        [r0+12], xmm3
+    psrlq       xmm3, 10h
+    movd        [r0+8], xmm3
+    psrlq       xmm3, 10h
+    movd        [r0+4], xmm3
+    DEINIT_X86_32_PIC
+    ret
+
+;   void WelsI4x4LumaPredHU_sse2(uint8_t *pred,uint8_t *pRef,int32_t stride)
+WELS_EXTERN WelsI4x4LumaPredHU_sse2
+    %assign push_num 0
+    INIT_X86_32_PIC r3
+    LOAD_3_PARA
+    SIGN_EXTENSION r2, r2d
+    movd        xmm0, [r1-4]
+    movd        xmm1, [r1+r2-4]
+    punpcklbw   xmm0, xmm1
+    lea         r1, [r1+2*r2]
+    movd        xmm2, [r1-4]
+    movd        xmm4, [r1+r2-4]
+    punpcklbw   xmm2, xmm4
+    punpcklwd   xmm0, xmm2
+    psrldq      xmm0, 8             ;MMX punpckhwd mm0,mm2
+
+    psrlq       xmm4, 18h
+    psllq       xmm4, 38h
+    psrlq       xmm0, 8h
+    pxor        xmm0, xmm4
+
+    movdqa      xmm1, xmm0
+    psllq       xmm1, 8h
+    movdqa      xmm3, xmm1
