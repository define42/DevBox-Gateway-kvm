+package encoder
+
+import (
+	"bytes"
+	"fmt"
+	"reflect"
+	"testing"
+	"unsafe"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+// Build a known reverse-scan prefix independently of the production classifier.
+// The frozen arithmetic writer then checks the complete syntax, not a copied
+// implementation of the new three checks.
+func TestCavlcTrailingPrefixSignMatrix(t *testing.T) {
+	for _, end := range []int32{3, 14, 15} {
+		property := int32(LUMA_4x4)
+		ncs := []int8{0, 3, 7, 16}
+		if end == 3 {
+			property, ncs = int32(CHROMA_DC), []int8{CHROMA_DC_NC_OFFSET}
+		} else if end == 14 {
+			property = int32(LUMA_AC)
+		}
+		for total := 0; total <= int(end)+1; total++ {
+			for trailing := 0; trailing <= min(3, total); trailing++ {
+				t.Run(fmt.Sprintf("end%d/count%d/trailing%d", end, total, trailing), func(t *testing.T) {
+					stoppers := []int16{2, -2, -32768, 32767}
+					if total == trailing {
+						stoppers = []int16{2} // No non-trailing level is present.
+					} else if trailing == 3 {
+						// A fourth +/-1 must remain a level, never another sign bit.
+						stoppers = append(stoppers, 1, -1)
+					}
+					for _, stopper := range stoppers {
+						for signs := 0; signs < 1<<trailing; signs++ {
+							for _, spread := range []bool{false, true} {
+								step := 1
+								if spread && total <= (int(end)+2)/2 {
+									step = 2
+								}
+								var coeff [16]int16
+								for index := 0; index < total; index++ {
+									value := int16(2 + index%5)
+									if index&1 != 0 {
+										value = -value
+									}
+									if index < trailing {
+										value = 1
+										if signs&(1<<(trailing-1-index)) != 0 {
+											value = -1
+										}
+									} else if index == trailing {
+										value = stopper
+									}
+									coeff[int(end)-index*step] = value
+								}
+								if end == 14 {
+									coeff[15] = -1 // Must not enter the end14 prefix.
+								}
+								for _, nc := range ncs {
+									for _, prefix := range []int{0, 7, 17, 31} {
+										assertCavlcWriterParity(t, nil, coeff[:], end, 1, property, nc, prefix)
+										if end != 15 {
+											assertCavlcWriterParity(t, nil, coeff[:end+1], end, 1, property, nc, prefix)
+										}
+									}
+								}
+							}
+						}
+					}
+				})
+			}
+		}
+	}
+}
+
+// Blocks consisting entirely of one, two or three +/-1 coefficients have no
+// level symbols. Construct their expected bits directly from the chosen sign
+// pattern and the published token/total-zero tables; no classifier is reused.
+func TestCavlcTrailingDirectSignBits(t *testing.T) {
+	for _, end := range []int32{3, 14, 15} {
+		property := int32(LUMA_4x4)
+		ncs := []int8{0, 3, 7, 16}
+		if end == 3 {
+			property, ncs = int32(CHROMA_DC), []int8{CHROMA_DC_NC_OFFSET}
+		} else if end == 14 {
+			property = int32(LUMA_AC)
+		}
+		for count := 1; count <= 3; count++ {
+			for signs := 0; signs < 1<<count; signs++ {
+				t.Run(fmt.Sprintf("end%d/count%d/sign%d", end, count, signs), func(t *testing.T) {
+					var coeff [16]int16
+					for i := 0; i < count; i++ {
+						coeff[count-1-i] = 1
+						if signs&(1<<(count-1-i)) != 0 {
+							coeff[count-1-i] = -1
+						}
+					}
+					for _, nc := range ncs {
+						token := g_kuiVlcCoeffToken[g_kuiEncNcMapTable[nc]][count][count]
+						want := uint32(token[0])<<uint(count) | uint32(signs)
+						length := int32(token[1]) + int32(count)
+						zeros := g_kuiVlcTotalZeros[count][0]
+						if end == 3 {
+							zeros = g_kuiVlcTotalZerosChromaDc[count][0]
+						}
+						want = want<<uint(zeros[1]) | uint32(zeros[0])
+						length += int32(zeros[1])
+						if length >= 32 {
+							t.Fatal("fixture unexpectedly needs a flushed word")
+						}
+						buffer := bytes.Repeat([]byte{0xa5}, 32)
+						var bs common.SBitStringAux
+						common.InitBits(&bs, buffer, 0, int32(len(buffer)))
+						result := WriteBlockResidualCavlc(nil, coeff[:], end, 1, property, nc, &bs)
+						if result != ENC_RETURN_SUCCESS || bs.PCurBuf != 0 || bs.UiCurBits != want ||
+							bs.ILeftBits != 32-length || !bytes.Equal(buffer, bytes.Repeat([]byte{0xa5}, 32)) {
+							t.Fatalf("nC%d: result%d cursor%d bits%x left%d; want bits%x length%d", nc,
+								result, bs.PCurBuf, bs.UiCurBits, bs.ILeftBits, want, length)
+						}
+					}
+				})
+			}
+		}
+	}
+}
+
+type cavlcTrailingObservation struct {
+	result    int32
+	panicText string
+	bits      common.SBitStringAux
+	coeff     [16]int16
+	buffer    [32]byte
+}
+
+func observeCavlcTrailing(writer cavlcZeroWriter, input [16]int16, alias bool, output, cursor int,
+	left int32, nc int8) cavlcTrailingObservation {
+	var observation cavlcTrailingObservation
+	observation.coeff = input
+	for i := range observation.buffer {
+		observation.buffer[i] = 0xa5
+	}
+	out := observation.buffer[:output]
+	if alias {
+		out = unsafe.Slice((*byte)(unsafe.Pointer(&observation.coeff[0])), 32)[3 : 3+output]
+	}
+	observation.bits = common.SBitStringAux{
+		PBuf: out, PCurBuf: cursor, PStartBuf: 17, PEndBuf: -12,
+		UiCurBits: 0x8d23f9ab, ILeftBits: left, IBits: 1234, IIndex: -17,
+	}
+	observation.result, observation.panicText = cavlcPackedCallResult(func() int32 {
+		return writer(nil, observation.coeff[:], 15, 1, int32(LUMA_4x4), nc, &observation.bits)
+	})
+	return observation
+}
+
+// All coefficients are extracted before output, including when output aliases
+// the source. Exercise every trailing-one prefix length on incomplete-word
+// failure and level overflow, with malformed pending states and nC as controls.
+func TestCavlcTrailingFailureAndAliasParity(t *testing.T) {
+	for trailing := 0; trailing <= 3; trailing++ {
