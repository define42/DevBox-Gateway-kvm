diff --git a/pkg/h264/internal/common/chroma_ssse3_guard_linux_amd64_test.go b/pkg/h264/internal/common/chroma_ssse3_guard_linux_amd64_test.go
new file mode 100644
index 0000000..c6e42af
--- /dev/null
+++ b/pkg/h264/internal/common/chroma_ssse3_guard_linux_amd64_test.go
@@ -0,0 +1,73 @@
+//go:build linux && amd64
+
+package common
+
+import (
+	"fmt"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+func chromaSSSE3GuardedRows(t *testing.T, rows, width, step int, readOnly bool) ([]byte, int32) {
+	t.Helper()
+	page := unix.Getpagesize()
+	mapping, err := unix.Mmap(-1, 0, rows*step*page, unix.PROT_READ|unix.PROT_WRITE, unix.MAP_ANON|unix.MAP_PRIVATE)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := unix.Munmap(mapping); err != nil {
+			t.Error(err)
+		}
+	})
+	for y := range rows {
+		start := y * step * page
+		for x := range width {
+			mapping[start+page-width+x] = byte(y*37 + x*19 + 7)
+		}
+		if readOnly {
+			if err := unix.Mprotect(mapping[start:start+page], unix.PROT_READ); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := unix.Mprotect(mapping[start+page:start+step*page], unix.PROT_NONE); err != nil {
+			t.Fatal(err)
+		}
+	}
+	end := (rows-1)*step*page + page
+	return mapping[page-width : end : end], int32(step * page)
+}
+
+func TestChromaSSSE3ExactRowsGuardPages(t *testing.T) {
+	requireChromaSSSE3(t)
+	for _, height := range []int32{1, 3, 8, 16} {
+		for _, signs := range [][2]int32{{1, 1}, {-1, 1}, {1, -1}, {-1, -1}} {
+			t.Run(fmt.Sprintf("height%d/signs%v", height, signs), func(t *testing.T) {
+				src, srcStride := chromaSSSE3GuardedRows(t, int(height)+1, 9, 2, true)
+				dst, dstStride := chromaSSSE3GuardedRows(t, int(height), 8, 3, false)
+				srcOff, dstOff := 0, 0
+				if signs[0] < 0 {
+					srcOff, srcStride = int(height*srcStride), -srcStride
+				}
+				if signs[1] < 0 {
+					dstOff, dstStride = int((height-1)*dstStride), -dstStride
+				}
+				for dx := int16(0); dx < 8; dx++ {
+					for dy := int16(0); dy < 8; dy++ {
+						want := make([]byte, 8*height)
+						McChroma_c(src, srcOff, srcStride, want, 0, 8, dx, dy, 8, height)
+						McChroma_ssse3(src, srcOff, srcStride, dst, dstOff, dstStride, dx, dy, 8, height)
+						for y := int32(0); y < height; y++ {
+							for x := range 8 {
+								if got := dst[dstOff+int(y*dstStride)+x]; got != want[8*y+int32(x)] {
+									t.Fatalf("MV(%d,%d) pixel(%d,%d): got=%d want=%d", dx, dy, x, y, got, want[8*y+int32(x)])
+								}
+							}
+						}
+					}
+				}
+			})
+		}
+	}
+}
diff --git a/pkg/h264/internal/common/copy_simd_amd64.go b/pkg/h264/internal/common/copy_simd_amd64.go
new file mode 100644
index 0000000..f675855
--- /dev/null
+++ b/pkg/h264/internal/common/copy_simd_amd64.go
@@ -0,0 +1,63 @@
+//go:build amd64
+
+package common
+
+import "unsafe"
+
+// The fixed-shape kernels amortize span validation over the whole block. They
+// load and store exactly the row width and accept unaligned pictures.
+//
+//go:noescape
+func copy8x16SSE2(dst *byte, dstStride int, src *byte, srcStride int)
+
+//go:noescape
+func copy16x16SSE2(dst *byte, dstStride int, src *byte, srcStride int)
+
+func copySIMDReady(dst []byte, dstOff int, dstStride int32, src []byte, srcOff int, srcStride int32, width, height int) bool {
+	// Positive, disjoint rows are the encoding case. Validate each full span
+	// once, then compare the two starting addresses without indexing row ends.
+	if dstStride >= int32(width) && srcStride >= int32(width) {
+		dstSpan := (height-1)*int(dstStride) + width
+		srcSpan := (height-1)*int(srcStride) + width
+		checkSIMDSpan(dst, int64(dstOff), int64(dstOff)+int64(dstSpan)-1)
+		checkSIMDSpan(src, int64(srcOff), int64(srcOff)+int64(srcSpan)-1)
+		d := uintptr(unsafe.Pointer(&dst[dstOff]))
+		s := uintptr(unsafe.Pointer(&src[srcOff]))
+		return s-d >= uintptr(dstSpan) && d-s >= uintptr(srcSpan)
+	}
+	// Scalar routines preserve the row order for negative, zero and
+	// overlapping strides, including writes visible to later source rows.
+	return false
+}
+
+func WelsCopy8x16_sse2(dst []byte, dstOff int, dstStride int32, src []byte, srcOff int, srcStride int32) {
+	if !copySIMDReady(dst, dstOff, dstStride, src, srcOff, srcStride, 8, 16) {
+		WelsCopy8x16_c(dst, dstOff, dstStride, src, srcOff, srcStride)
+		return
+	}
+	copy8x16SSE2(&dst[dstOff], int(dstStride), &src[srcOff], int(srcStride))
+}
+
+func WelsCopy16x16_sse2(dst []byte, dstOff int, dstStride int32, src []byte, srcOff int, srcStride int32) {
+	if !copySIMDReady(dst, dstOff, dstStride, src, srcOff, srcStride, 16, 16) {
+		WelsCopy16x16_c(dst, dstOff, dstStride, src, srcOff, srcStride)
+		return
+	}
+	copy16x16SSE2(&dst[dstOff], int(dstStride), &src[srcOff], int(srcStride))
+}
+
+// mcCopySSE2 accelerates sixteen-row integer motion without changing McCopy_c's
+// fallback order. Callers route shorter blocks directly to the scalar function:
+// their copies are too small to amortize a separate checked assembly call.
+func mcCopySSE2(src []byte, srcOff int, srcStride int32, dst []byte, dstOff int, dstStride int32, width, height int32) {
+	if (width != 8 && width != 16) || height != 16 ||
+		!copySIMDReady(dst, dstOff, dstStride, src, srcOff, srcStride, int(width), int(height)) {
+		McCopy_c(src, srcOff, srcStride, dst, dstOff, dstStride, width, height)
+		return
+	}
+	if width == 8 {
+		copy8x16SSE2(&dst[dstOff], int(dstStride), &src[srcOff], int(srcStride))
+	} else {
+		copy16x16SSE2(&dst[dstOff], int(dstStride), &src[srcOff], int(srcStride))
+	}
+}
diff --git a/pkg/h264/internal/common/copy_simd_amd64.s b/pkg/h264/internal/common/copy_simd_amd64.s
new file mode 100644
index 0000000..3d2302a
--- /dev/null
+++ b/pkg/h264/internal/common/copy_simd_amd64.s
@@ -0,0 +1,99 @@
+//go:build amd64
+
+#include "textflag.h"
+// func copy8x16SSE2(dst *byte, dstStride int, src *byte, srcStride int)
+TEXT ·copy8x16SSE2(SB), NOSPLIT, $0-32
+	MOVQ dst+0(FP), AX
+	MOVQ dstStride+8(FP), CX
+	MOVQ src+16(FP), DX
+	MOVQ srcStride+24(FP), BX
+	LEAQ (CX)(CX*2), R8
+	LEAQ (BX)(BX*2), R9
+	MOVQ (DX), X0
+	MOVQ (DX)(BX*1), X1
+	MOVQ (DX)(BX*2), X2
