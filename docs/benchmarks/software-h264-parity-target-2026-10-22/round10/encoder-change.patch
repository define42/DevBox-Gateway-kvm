@@ -0,0 +1,27 @@
+//go:build linux && amd64
+
+package encoder
+
+import (
+	"testing"
+	"unsafe"
+)
+
+func TestHadamardQuant2x2GuardPages(t *testing.T) {
+	words := func(n int) []int16 {
+		buffer := idctGuardedBuffer(t, n*2)
+		return unsafe.Slice((*int16)(unsafe.Pointer(&buffer[0])), n)
+	}
+	rs, dct, block := words(49), words(4), words(4)
+	for i := range rs {
+		rs[i] = int16(i*1701 + 13)
+	}
+	var wantRS [49]int16
+	copy(wantRS[:], rs)
+	var wantDCT, wantBlock [4]int16
+	want := WelsHadamardQuant2x2_c(wantRS[:], 32767, 32767, wantDCT[:], wantBlock[:])
+	got := hadamardQuant2x2(rs, 32767, 32767, dct, block)
+	if got != want || *(*[49]int16)(rs) != wantRS || *(*[4]int16)(dct) != wantDCT || *(*[4]int16)(block) != wantBlock {
+		t.Fatal("guarded minimum input/output parity differs")
+	}
+}
diff --git a/pkg/h264/internal/encoder/hadamard_quant_test.go b/pkg/h264/internal/encoder/hadamard_quant_test.go
new file mode 100644
index 0000000..a166562
--- /dev/null
+++ b/pkg/h264/internal/encoder/hadamard_quant_test.go
@@ -0,0 +1,152 @@
+package encoder
+
+import (
+	"fmt"
+	"math/rand/v2"
+	"testing"
+)
+
+func TestHadamardQuant2x2CoefficientDomain(t *testing.T) {
+	for _, quant := range [][2]int16{{0, 0}, {0, 32767}, {32767, 32767}, {32767, 1}} {
+		for value := -32768; value <= 32767; value++ {
+			var input [64]int16
+			for i := range input {
+				input[i] = -12345
+			}
+			// Every DC input independently traverses the entire int16 domain.
+			input[0], input[16] = int16(value), int16(value*17+1)
+			input[32], input[48] = int16(value*73+7), int16(value*8191+13)
+			assertHadamardQuant2x2Parity(t, input, quant[0], quant[1])
+		}
+	}
+}
+
+func TestHadamardQuant2x2ButterflyEdges(t *testing.T) {
+	edges := [...]int16{-32768, -32767, -1, 0, 1, 32766, 32767}
+	for _, a := range edges {
+		for _, b := range edges {
+			for _, c := range edges {
+				for _, d := range edges {
+					var input [64]int16
+					input[0], input[16], input[32], input[48] = a, b, c, d
+					for _, quant := range [][2]int16{{0, 32767}, {32767, 32767}, {20000, 24000}} {
+						assertHadamardQuant2x2Parity(t, input, quant[0], quant[1])
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestHadamardQuant2x2QP(t *testing.T) {
+	rng := rand.New(rand.NewPCG(264, 222))
+	for qp := range 52 {
+		for _, intra := range []int{0, 1} {
+			ff := int16(int32(g_kiQuantInterFF[qp+intra*6][0]) << 1)
+			mf := g_kiQuantMF[qp][0] >> 1
+			for fixture := range 64 {
+				var input [64]int16
+				for i := range input {
+					switch fixture % 4 {
+					case 1:
+						if i%16 == 0 {
+							input[i] = int16(rng.Uint32())
+						}
+					case 2:
+						input[i] = int16(rng.Uint32())
+					case 3:
+						input[i] = int16(rng.IntN(257) - 128)
+					}
+				}
+				assertHadamardQuant2x2Parity(t, input, ff, mf)
+			}
+		}
+	}
+}
+
+func TestHadamardQuant2x2SignedParameters(t *testing.T) {
+	rng := rand.New(rand.NewPCG(264, 223))
+	for fixture := range 4096 {
+		var input [64]int16
+		for i := range input {
+			input[i] = int16(rng.Uint32())
+		}
+		ff, mf := int16(rng.Uint32()), int16(rng.Uint32())
+		if fixture%4 == 0 {
+			ff, mf = -32768, -32768
+		}
+		assertHadamardQuant2x2Parity(t, input, ff, mf)
+	}
+}
+
+func assertHadamardQuant2x2Parity(t *testing.T, input [64]int16, ff, mf int16) {
+	t.Helper()
+	gotRS, wantRS := input, input
+	var gotDCT, wantDCT, gotBlock, wantBlock [8]int16
+	for i := range gotDCT {
+		gotDCT[i], wantDCT[i] = 12345, 12345
+		gotBlock[i], wantBlock[i] = -23456, -23456
+	}
+	want := WelsHadamardQuant2x2_c(wantRS[:], ff, mf, wantDCT[1:5], wantBlock[1:5])
+	got := hadamardQuant2x2(gotRS[:], ff, mf, gotDCT[1:5], gotBlock[1:5])
+	if got != want || gotRS != wantRS || gotDCT != wantDCT || gotBlock != wantBlock {
+		t.Fatalf("DC[%d %d %d %d] FF%d MF%d: count%d/%d DCT%v/%v block%v/%v residual parity=%t", input[0], input[16], input[32], input[48], ff, mf, got, want, gotDCT, wantDCT, gotBlock, wantBlock, gotRS == wantRS)
+	}
+}
+
+func TestHadamardQuant2x2Aliases(t *testing.T) {
+	// Residual DC words are at storage indices 16,32,48,64. Cover coincident
+	// and shifted output aliases, including partial dct/block overlap.
+	offsets := []int{0, 15, 16, 17, 30, 31, 32, 33, 47, 48, 49, 63, 64, 65, 80, 81, 96}
+	for _, dctOffset := range offsets {
+		for _, blockOffset := range offsets {
+			for _, quant := range [][2]int16{{0, 32767}, {32767, 32767}, {-32768, 32767}} {
+				var got [104]int16
+				for i := range got {
+					got[i] = int16(i*1701 + 13)
+				}
+				want := got
+				wantCount := WelsHadamardQuant2x2_c(want[16:65], quant[0], quant[1], want[dctOffset:dctOffset+4], want[blockOffset:blockOffset+4])
+				gotCount := hadamardQuant2x2(got[16:65], quant[0], quant[1], got[dctOffset:dctOffset+4], got[blockOffset:blockOffset+4])
+				if gotCount != wantCount || got != want {
+					t.Fatalf("DCT%d block%d FF%d MF%d: count%d/%d or aliased storage differs", dctOffset, blockOffset, quant[0], quant[1], gotCount, wantCount)
+				}
+			}
+		}
+	}
+}
+
+func TestHadamardQuant2x2ShortSliceParity(t *testing.T) {
+	for _, layout := range [][3]int{{16, 80, 88}, {16, 16, 17}, {16, 32, 33}} {
+		for argument, limit := range []int{49, 4, 4} {
+			for length := 0; length < limit; length++ {
+				var got [104]int16
+				for i := range got {
+					got[i] = int16(i*1701 + 13)
+				}
+				want := got
+				lengths := [3]int{49, 4, 4}
+				lengths[argument] = length
+				wantCount, wantPanic := hadamardQuantCallResult(func() int32 {
+					return WelsHadamardQuant2x2_c(want[layout[0]:layout[0]+lengths[0]], 32767, 32767, want[layout[1]:layout[1]+lengths[1]], want[layout[2]:layout[2]+lengths[2]])
+				})
+				gotCount, gotPanic := hadamardQuantCallResult(func() int32 {
+					return hadamardQuant2x2(got[layout[0]:layout[0]+lengths[0]], 32767, 32767, got[layout[1]:layout[1]+lengths[1]], got[layout[2]:layout[2]+lengths[2]])
+				})
+				if wantPanic == "" || gotPanic != wantPanic || gotCount != wantCount || got != want {
+					t.Fatalf("layout%v argument%d length%d: count%d/%d panic%q/%q or partial writes differ", layout, argument, length, gotCount, wantCount, gotPanic, wantPanic)
+				}
+			}
+		}
+	}
+}
+
+func hadamardQuantCallResult(call func() int32) (result int32, panicText string) {
+	defer func() {
+		if value := recover(); value != nil {
+			panicText = fmt.Sprintf("%T: %v", value, value)
+		}
+	}()
+	result = call()
+	return result, ""
+}
diff --git a/pkg/h264/internal/encoder/hadamard_skip_caller_bench_test.go b/pkg/h264/internal/encoder/hadamard_skip_caller_bench_test.go
new file mode 100644
index 0000000..19b4749
--- /dev/null
+++ b/pkg/h264/internal/encoder/hadamard_skip_caller_bench_test.go
@@ -0,0 +1,86 @@
+package encoder
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+// This entire file uses pre-existing APIs and can be copied unchanged into
+// round7 for a complete-caller benchmark without a compatibility shim.
+type chromaSkipCallerFixture struct {
+	ctx          sWelsEncCtx
+	layer        SDqLayer
+	pps          SWelsPPS
+	funcs        SWelsFuncPtrList
+	mb           SMB
+	cache        SMbCache
+	coefficients [384]int16
+	levels       SDCTCoeff
+	input        [64]int16
+	offset       int
+	uv           int32
+}
+
+func newChromaSkipCallerFixture(qp int, uv int32, content string) *chromaSkipCallerFixture {
+	f := &chromaSkipCallerFixture{mb: SMB{uiLumaQp: uint8(qp)}, uv: uv, offset: 256}
+	if uv != 1 {
+		f.offset = 320
+	}
+	f.ctx.pCurDqLayer, f.ctx.pFuncList = &f.layer, &f.funcs
+	f.layer.sLayerInfo.pPpsP = &f.pps
+	f.cache.pCoeffLevel, f.cache.pDct = f.coefficients[:], &f.levels
+	WelsInitEncodingFuncs(&f.funcs, common.WELS_CPU_SSE2)
+	for i := range f.coefficients {
+		f.coefficients[i] = int16(i*31 + 19)
+	}
+	for i := range f.levels.iChromaBlock {
+		f.levels.iChromaBlock[i] = int16(i*13 + 71)
+	}
+	chromaQP := common.G_kuiChromaQpTable[qp]
+	ff, mf := int32(g_kiQuantInterFF[chromaQP][0]), int32(g_kiQuantMF[chromaQP][0])
+	threshold := 65535/(mf>>1) - (ff << 1)
+	switch content {
+	case "DCReject":
+		f.input[0] = int16(threshold + 1)
+	case "DCBoundary":
+		f.input[0] = int16(threshold)
+	case "SparseAC":
+		for _, offset := range []int{1, 17, 33, 49} {
+			f.input[offset] = int16((65536+mf-1)/mf - ff)
+		}
+	case "ACReject":
+		f.input[1] = 32767
+	case "Dense":
+		for i := range f.input {
+			f.input[i] = int16(i*71 - 2000)
+		}
+	case "Extremes":
+		for i := range f.input {
+			f.input[i] = []int16{-32768, 32767, -1, 0, 1}[i%5]
+		}
+	}
+	return f
+}
+
+func (f *chromaSkipCallerFixture) reset() { copy(f.coefficients[f.offset:f.offset+64], f.input[:]) }
+
+var chromaSkipCallerBenchmarkSink bool
+
+func BenchmarkChromaSkipCaller(b *testing.B) {
+	for _, qp := range []int{0, 26, 51} {
+		for _, uv := range []int32{1, 2} {
+			for _, content := range []string{"Zero", "DCReject", "DCBoundary", "SparseAC", "ACReject", "Dense"} {
+				b.Run(fmt.Sprintf("QP%d/UV%d/%s", qp, uv, content), func(b *testing.B) {
+					f := newChromaSkipCallerFixture(qp, uv, content)
+					b.ReportAllocs()
+					for b.Loop() {
+						f.reset()
+						chromaSkipCallerBenchmarkSink = WelsTryPUVskip(&f.ctx, &f.mb, &f.cache, f.uv)
+					}
+				})
+			}
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/hadamard_skip_qp.go b/pkg/h264/internal/encoder/hadamard_skip_qp.go
new file mode 100644
index 0000000..6011fb9
--- /dev/null
+++ b/pkg/h264/internal/encoder/hadamard_skip_qp.go
@@ -0,0 +1,43 @@
+package encoder
+
+// A small snapshot of the effective DC quantization parameters. The source
+// tables remain mutable: use a cached threshold only when both live parameters
+// still equal this tuple. Other quantization table entries are not cached.
+var chromaSkipQPThresholds = func() [52]struct{ ff, mf, threshold int16 } {
+	var result [52]struct{ ff, mf, threshold int16 }
+	for qp := range result {
+		ff, mf := int16(int32(g_kiQuantInterFF[qp][0])<<1), g_kiQuantMF[qp][0]>>1
+		result[qp].ff, result[qp].mf = ff, mf
+		if mf != 0 {
+			result[qp].threshold = int16(65535/int32(mf) - int32(ff))
+		}
+	}
+	return result
+}()
+
+func hadamardQuant2x2SkipQP(rs []int16, qp uint8, ff, mf int16) int32 {
+	if qp >= uint8(len(chromaSkipQPThresholds)) || mf == 0 {
+		return WelsHadamardQuant2x2Skip_c(rs, ff, mf)
+	}
+	entry := &chromaSkipQPThresholds[qp]
+	if ff != entry.ff || mf != entry.mf {
+		return WelsHadamardQuant2x2Skip_c(rs, ff, mf)
+	}
+	threshold := int32(entry.threshold)
+
+	// Preserve the scalar int16 wrap and DC read order. All four source
+	// positions are read before any early return, including short inputs.
+	s0 := rs[0] + rs[32]
+	s1 := rs[0] - rs[32]
+	s2 := rs[16] + rs[48]
+	s3 := rs[16] - rs[48]
+	a, b := int32(s0+s2), int32(s0-s2)
+	c, d := int32(s1+s3), int32(s1-s3)
+	// The widened signed comparisons include abs(MinInt16)==32768 and
+	// preserve the scalar result even when the cached int16 threshold is <0.
+	if a > threshold || a < -threshold || b > threshold || b < -threshold ||
+		c > threshold || c < -threshold || d > threshold || d < -threshold {
+		return 1
+	}
+	return 0
+}
diff --git a/pkg/h264/internal/encoder/hadamard_skip_qp_caller_test.go b/pkg/h264/internal/encoder/hadamard_skip_qp_caller_test.go
new file mode 100644
index 0000000..79dc8c8
--- /dev/null
+++ b/pkg/h264/internal/encoder/hadamard_skip_qp_caller_test.go
@@ -0,0 +1,225 @@
+package encoder
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+	"unsafe"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+type chromaSkipOutcome struct {
+	accepted     bool
+	panicText    string
+	coefficients [384]int16
+	levels       SDCTCoeff
+	events       []string
+}
+
+func runChromaSkipCaller(qp int, uv int32, content, scenario string, scalar bool) (out chromaSkipOutcome) {
+	f := newChromaSkipCallerFixture(qp, uv, content)
+	defer func() {
+		if value := recover(); value != nil {
+			out.panicText = fmt.Sprintf("%T: %v", value, value)
+		}
+		out.coefficients, out.levels = f.coefficients, f.levels
+	}()
+	f.reset()
+	switch scenario {
+	case "aliasLevels":
+		// All fields are int16 arrays. Alias residual storage with the complete
+		// SDCTCoeff allocation so the unchanged AC scan can overwrite later
+		// residual/level views after the pure DC skip check.
+		f.cache.pCoeffLevel = unsafe.Slice((*int16)(unsafe.Pointer(&f.levels)), 384)
+		copy(f.cache.pCoeffLevel[f.offset:f.offset+64], f.input[:])
+	case "short0":
+		f.cache.pCoeffLevel = f.coefficients[:0]
+	case "short48":
+		f.cache.pCoeffLevel = f.coefficients[:f.offset+48]
+	case "short49":
+		f.cache.pCoeffLevel = f.coefficients[:f.offset+49]
+	case "short63":
+		f.cache.pCoeffLevel = f.coefficients[:f.offset+63]
+	case "nilDct":
+		f.cache.pDct = nil
+	case "nilPPS":
+		f.layer.sLayerInfo.pPpsP = nil
+	case "nilFunctions":
+		f.ctx.pFuncList = nil
+	case "invalidUV":
+		uv = 0
+	}
+	scan, score := f.funcs.pfScan4x4Ac, f.funcs.pfCalculateSingleCtr4x4
+	f.funcs.pfScan4x4Ac = func(level, residual []int16) {
+		out.events = append(out.events, "scan")
+		scan(level, residual)
+		if scenario == "callbackMutation" {
+			residual[17] ^= 15
+		}
+	}
+	f.funcs.pfCalculateSingleCtr4x4 = func(level []int16) int32 {
+		out.events = append(out.events, "score")
+		if scenario == "callbackPanic" {
+			panic("score callback")
+		}
+		return score(level)
+	}
+	if scalar {
+		out.accepted = originalChromaSkipCaller(&f.ctx, &f.mb, &f.cache, uv)
+	} else {
+		out.accepted = WelsTryPUVskip(&f.ctx, &f.mb, &f.cache, uv)
+	}
+	return out
+}
+
+func TestChromaSkipQPCompleteCallerParity(t *testing.T) {
+	for qp := range 52 {
+		for _, uv := range []int32{1, 2} {
+			for _, content := range []string{"Zero", "DCReject", "DCBoundary", "SparseAC", "ACReject", "Dense", "Extremes"} {
+				t.Run(fmt.Sprintf("QP%d/UV%d/%s", qp, uv, content), func(t *testing.T) {
+					want, got := runChromaSkipCaller(qp, uv, content, "normal", true), runChromaSkipCaller(qp, uv, content, "normal", false)
+					if !reflect.DeepEqual(got, want) || want.panicText != "" {
+						t.Fatalf("got=%+v want=%+v", got, want)
+					}
+					if content == "Zero" && !got.accepted || content == "DCReject" && got.accepted {
+						t.Fatal("fixture did not exercise expected DC decision")
+					}
+				})
+			}
+		}
+	}
+	for _, uv := range []int32{1, 2} {
+		for _, content := range []string{"Zero", "DCReject", "SparseAC"} {
+			for _, scenario := range []string{"aliasLevels", "short0", "short48", "short49", "short63", "nilDct", "nilPPS", "nilFunctions", "invalidUV", "callbackMutation", "callbackPanic"} {
+				t.Run(fmt.Sprintf("fallback/UV%d/%s/%s", uv, content, scenario), func(t *testing.T) {
+					want, got := runChromaSkipCaller(26, uv, content, scenario, true), runChromaSkipCaller(26, uv, content, scenario, false)
+					if !reflect.DeepEqual(got, want) {
+						t.Fatalf("got=%+v want=%+v", got, want)
+					}
+				})
+			}
+		}
+	}
+}
+
+// Frozen complete production caller with the original scalar DC decision.
+func originalChromaSkipCaller(pEncCtx *sWelsEncCtx, pCurMb *SMB, pMbCache *SMbCache, iUV int32) bool {
+	var pRes []int16
+	if iUV == 1 {
+		pRes = pMbCache.pCoeffLevel[256:]
+	} else {
+		pRes = pMbCache.pCoeffLevel[256+64:]
+	}
+
+	kuiQp := common.G_kuiChromaQpTable[common.CLIP3_QP_0_51(int32(pCurMb.uiLumaQp)+
+		int32(pEncCtx.pCurDqLayer.sLayerInfo.pPpsP.uiChromaQpIndexOffset))]
+
+	pMF := g_kiQuantMF[kuiQp][:]
+	pFF := g_kiQuantInterFF[kuiQp][:]
+
+	if WelsHadamardQuant2x2Skip_c(pRes, int16(int32(pFF[0])<<1), pMF[0]>>1) != 0 {
+		return false
+	} else {
+		var aMax [4]int16 // uint16_t aMax[4] in C, passed as (int16_t*)
+		iSingleCtrMb := int32(0)
+		pBlock := pMbCache.pDct.iChromaBlock[((iUV-1)<<2)*16:]
+		WelsQuantFour4x4Max_sse2(pRes, pFF, pMF, aMax[:])
+
+		iResOff := 0
+		iBlockOff := 0
+		for j := 0; j < 4; j++ {
+			if uint16(aMax[j]) > 1 {
+				return false // iSingleCtrMb += 9, can't be P_SKIP
+			} else if uint16(aMax[j]) == 1 {
+				pEncCtx.pFuncList.pfScan4x4Ac(pBlock[iBlockOff:], pRes[iResOff:])
+				iSingleCtrMb += pEncCtx.pFuncList.pfCalculateSingleCtr4x4(pBlock[iBlockOff:])
+			}
+			if iSingleCtrMb >= 7 {
+				return false //from JVT-O079
+			}
+			iResOff += 16
+			iBlockOff += 16
+		}
+		return true
+	}
+}
+
+func observeChromaSkipQPFixture(f *chromaSkipCallerFixture, scalar bool) (out chromaSkipOutcome) {
+	defer func() {
+		if value := recover(); value != nil {
+			out.panicText = fmt.Sprintf("%T: %v", value, value)
+		}
+		out.coefficients, out.levels = f.coefficients, f.levels
+	}()
+	f.reset()
+	if scalar {
+		out.accepted = originalChromaSkipCaller(&f.ctx, &f.mb, &f.cache, f.uv)
+	} else {
+		out.accepted = WelsTryPUVskip(&f.ctx, &f.mb, &f.cache, f.uv)
+	}
+	return out
+}
+
+func TestChromaSkipQPChangedTableCaller(t *testing.T) {
+	for _, qp := range []int{0, 20, 51} {
+		for _, uv := range []int32{1, 2} {
+			for _, content := range []string{"Zero", "DCBoundary", "DCReject", "SparseAC", "Dense"} {
+				for _, change := range []string{"FF", "MF", "zeroMF", "negativeFF", "negativeMF", "equivalentDC", "ACOnly"} {
+					t.Run(fmt.Sprintf("QP%d/UV%d/%s/%s", qp, uv, content, change), func(t *testing.T) {
+						// Build the same ordinary fixture before changing the tables;
+						// in particular, the fixture must not divide by the new zero MF.
+						gotFixture := newChromaSkipCallerFixture(qp, uv, content)
+						wantFixture := newChromaSkipCallerFixture(qp, uv, content)
+						chromaQP := common.G_kuiChromaQpTable[qp]
+						oldFF, oldMF := g_kiQuantInterFF[chromaQP], g_kiQuantMF[chromaQP]
+						defer func() { g_kiQuantInterFF[chromaQP], g_kiQuantMF[chromaQP] = oldFF, oldMF }()
+						switch change {
+						case "FF":
+							g_kiQuantInterFF[chromaQP][0] ^= 1
+						case "MF":
+							g_kiQuantMF[chromaQP][0] ^= 2
+						case "zeroMF":
+							g_kiQuantMF[chromaQP][0] = 0
+						case "negativeFF":
+							g_kiQuantInterFF[chromaQP][0] = 16384
+						case "negativeMF":
+							g_kiQuantMF[chromaQP][0] = -32768
+						case "equivalentDC":
+							g_kiQuantInterFF[chromaQP][0] ^= -32768
+							g_kiQuantMF[chromaQP][0] ^= 1
+						case "ACOnly":
+							g_kiQuantInterFF[chromaQP][1] = -32768
+							g_kiQuantMF[chromaQP][1] = -1
+						}
+						got, want := observeChromaSkipQPFixture(gotFixture, false), observeChromaSkipQPFixture(wantFixture, true)
+						if !reflect.DeepEqual(got, want) {
+							t.Fatalf("live table result/state differs: got=%+v want=%+v", got, want)
+						}
+					})
+				}
+			}
+		}
+	}
+}
+
+func TestChromaSkipQPIgnoresUnusedCallback(t *testing.T) {
+	for _, nilCallback := range []bool{false, true} {
+		for _, content := range []string{"Zero", "DCReject", "SparseAC"} {
+			gotFixture, wantFixture := newChromaSkipCallerFixture(20, 1, content), newChromaSkipCallerFixture(20, 1, content)
+			for _, f := range []*chromaSkipCallerFixture{gotFixture, wantFixture} {
+				if nilCallback {
+					f.funcs.pfQuantizationHadamard2x2Skip = nil
+				} else {
+					f.funcs.pfQuantizationHadamard2x2Skip = func([]int16, int16, int16) int32 {
+						panic("the direct DC skip path must not invoke this callback")
+					}
+				}
+			}
+			got, want := observeChromaSkipQPFixture(gotFixture, false), observeChromaSkipQPFixture(wantFixture, true)
+			if !reflect.DeepEqual(got, want) || got.panicText != "" {
+				t.Fatalf("nil%t %s: ignored callback changed result: got=%+v want=%+v", nilCallback, content, got, want)
+			}
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/hadamard_skip_qp_test.go b/pkg/h264/internal/encoder/hadamard_skip_qp_test.go
new file mode 100644
index 0000000..42d689a
--- /dev/null
+++ b/pkg/h264/internal/encoder/hadamard_skip_qp_test.go
@@ -0,0 +1,122 @@
+package encoder
+
+import (
+	"fmt"
+	"math/rand/v2"
+	"reflect"
+	"testing"
+)
+
+func assertChromaSkipQP(t *testing.T, rs []int16, qp uint8, ff, mf int16) {
+	t.Helper()
+	before := append([]int16(nil), rs...)
+	got, gp := hadamardQuantCallResult(func() int32 { return hadamardQuant2x2SkipQP(rs, qp, ff, mf) })
+	want, wp := hadamardQuantCallResult(func() int32 { return WelsHadamardQuant2x2Skip_c(rs, ff, mf) })
+	if got != want || gp != wp || !reflect.DeepEqual(rs, before) && len(rs) != 0 {
+		t.Fatalf("QP%d len%d FF%d MF%d: got%d/%q want%d/%q or input changed", qp, len(rs), ff, mf, got, gp, want, wp)
+	}
+}
+
+func TestChromaSkipQPThresholdBoundaries(t *testing.T) {
+	for qp := range 52 {
+		ff, mf := int16(int32(g_kiQuantInterFF[qp][0])<<1), g_kiQuantMF[qp][0]>>1
+		entry := chromaSkipQPThresholds[qp]
+		threshold := int16(65535/int32(mf) - int32(ff))
+		if entry.ff != ff || entry.mf != mf || entry.threshold != threshold {
+			t.Fatalf("QP%d snapshot differs from original scalar threshold", qp)
+		}
+		for _, offset := range []int{0, 16, 32, 48} {
+			for delta := int32(-1); delta <= 1; delta++ {
+				for _, sign := range []int32{-1, 1} {
+					var input [64]int16
+					input[offset] = int16(sign * (int32(threshold) + delta))
+					assertChromaSkipQP(t, input[:49], uint8(qp), ff, mf)
+				}
+			}
+		}
+		for length := 0; length <= 64; length++ {
+			var input [64]int16
+			for i := range input {
+				input[i] = int16(i*1701 + 13)
+			}
+			assertChromaSkipQP(t, input[:length], uint8(qp), ff, mf)
+		}
+	}
+}
+
+func TestChromaSkipQPFullCoefficientDomain(t *testing.T) {
+	for _, qp := range []uint8{0, 51} {
+		ff, mf := int16(int32(g_kiQuantInterFF[qp][0])<<1), g_kiQuantMF[qp][0]>>1
+		for _, offset := range []int{0, 16, 32, 48} {
+			for value := -32768; value <= 32767; value++ {
+				var input [49]int16
+				input[offset] = int16(value)
+				got := hadamardQuant2x2SkipQP(input[:], qp, ff, mf)
+				want := WelsHadamardQuant2x2Skip_c(input[:], ff, mf)
+				if got != want {
+					t.Fatalf("QP%d offset%d value%d: got%d want%d", qp, offset, value, got, want)
+				}
+			}
+		}
+	}
+	// Full-range combinations exercise wrap at both butterfly stages.
+	rng := rand.New(rand.NewPCG(264, 522))
+	for trial := range 16384 {
+		var input [80]int16
+		for i := range input {
+			input[i] = int16(rng.Uint32())
+		}
+		qp := uint8(trial % 52)
+		ff, mf := int16(int32(g_kiQuantInterFF[qp][0])<<1), g_kiQuantMF[qp][0]>>1
+		offset := trial % 16
+		before := input
+		assertChromaSkipQP(t, input[offset:offset+49], qp, ff, mf)
+		if input != before {
+			t.Fatal("unaligned input or canaries changed")
+		}
+	}
+}
+
+func TestChromaSkipQPFallbackParameters(t *testing.T) {
+	for _, qp := range []uint8{0, 20, 51, 52, 255} {
+		for _, params := range [][2]int16{{0, 0}, {-32768, 0}, {0, 1}, {0, 2}, {32767, 32767}, {-32768, 2}, {32767, -32768}, {32767, -1}} {
+			for _, length := range []int{0, 1, 16, 32, 48, 49, 64} {
+				var input [64]int16
+				for i := range input {
+					input[i] = int16(i*1701 + 13)
+				}
+				assertChromaSkipQP(t, input[:length], qp, params[0], params[1])
+			}
+			assertChromaSkipQP(t, nil, qp, params[0], params[1])
+		}
+	}
+}
+
+func TestChromaSkipQPMutableTables(t *testing.T) {
+	for qp := range 52 {
+		t.Run(fmt.Sprintf("QP%d", qp), func(t *testing.T) {
+			oldFF, oldMF := g_kiQuantInterFF[qp], g_kiQuantMF[qp]
+			defer func() { g_kiQuantInterFF[qp], g_kiQuantMF[qp] = oldFF, oldMF }()
+			entry := chromaSkipQPThresholds[qp]
+			for _, params := range [][2]int16{
+				{oldFF[0] ^ 1, oldMF[0]}, {oldFF[0], oldMF[0] ^ 2},
+				{16384, oldMF[0]}, {-32768, -32768}, {oldFF[0], 0}, {oldFF[0], 1},
+				// Different raw words with identical effective DC parameters.
+				{oldFF[0] ^ -32768, oldMF[0] ^ 1},
+			} {
+				g_kiQuantInterFF[qp][0], g_kiQuantMF[qp][0] = params[0], params[1]
+				ff, mf := int16(int32(params[0])<<1), params[1]>>1
+				for _, length := range []int{0, 32, 48, 49, 64} {
+					var input [64]int16
+					for i := range input {
+						input[i] = int16(i*1701 + 13)
+					}
+					assertChromaSkipQP(t, input[:length], uint8(qp), ff, mf)
+				}
+			}
+			if chromaSkipQPThresholds[qp] != entry {
+				t.Fatal("mutable source table changed the cached snapshot")
+			}
+		})
+	}
+}
diff --git a/pkg/h264/internal/encoder/idct_four_amd64_test.go b/pkg/h264/internal/encoder/idct_four_amd64_test.go
new file mode 100644
index 0000000..73c1507
--- /dev/null
+++ b/pkg/h264/internal/encoder/idct_four_amd64_test.go
@@ -0,0 +1,92 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"bytes"
+	"math/rand/v2"
+	"slices"
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/cpu"
+)
+
+func TestIDctFourPackedAVX2Parity(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 unavailable")
+	}
+	rng := rand.New(rand.NewPCG(264, 416))
+	extremes := [...]int16{-32768, -32767, -16385, -16384, -8193, -8192, -65, -64, -33, -32, -1, 1, 31, 32, 63, 64, 8191, 8192, 16383, 16384, 32766, 32767}
+	for run := range 4096 {
+		var coeff [64]int16
+		if run < len(coeff)*len(extremes) {
+			coeff[run/len(extremes)] = extremes[run%len(extremes)]
+		} else {
+			for i := range coeff {
+				if run%2 == 0 {
+					coeff[i] = extremes[rng.IntN(len(extremes))]
+				} else {
+					coeff[i] = int16(rng.Uint32())
+				}
+			}
+		}
+		before := coeff
+		recStride, predStride := 8+run%29, 8+(run/3)%31
+		recOffset, predOffset := run%17, (run/5)%19
+		pred := make([]byte, predOffset+7*predStride+8)
+		for i := range pred {
+			pred[i] = byte(rng.Uint32())
+		}
+		predBefore := slices.Clone(pred)
+		got := bytes.Repeat([]byte{0xa5}, recOffset+7*recStride+8+19)
+		want := slices.Clone(got)
+		if run%3 == 0 {
+			for i := range got {
+				got[i] = byte(rng.Uint32())
+			}
+			copy(want, got)
+			WelsIDctFourT4Rec_c(want, recOffset, int32(recStride), want, recOffset, int32(recStride), coeff[:])
+			idctFourT4RecPackedAVX2(&got[recOffset], recStride, &got[recOffset], recStride, &coeff)
+		} else {
+			WelsIDctFourT4Rec_c(want, recOffset, int32(recStride), pred, predOffset, int32(predStride), coeff[:])
+			idctFourT4RecPackedAVX2(&got[recOffset], recStride, &pred[predOffset], predStride, &coeff)
+		}
+		if !bytes.Equal(got, want) || !bytes.Equal(pred, predBefore) || coeff != before {
+			t.Fatalf("run %d: packed reconstruction differs from scalar", run)
+		}
+	}
+}
+
+// Loading all four blocks up front must not change the previous paired
+// kernel's order when byte output shares storage with later coefficients.
+func TestIDctFourPackedCoefficientAliases(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 unavailable")
+	}
+	for _, recOffset := range []int{384, 416, 448, 480, 512, 544, 576, 608, 640, 672} {
+		for _, inPlace := range []bool{false, true} {
+			got := make([]byte, 1024)
+			for i := range got {
+				got[i] = byte(i*37 + 11)
+			}
+			want := slices.Clone(got)
+			gotCoeff := unsafe.Slice((*int16)(unsafe.Pointer(&got[512])), 64)
+			wantCoeff := unsafe.Slice((*int16)(unsafe.Pointer(&want[512])), 64)
+			pred := make([]byte, 256)
+			for i := range pred {
+				pred[i] = byte(i*13 + 7)
+			}
+			if inPlace {
+				idctFourT4RecAVX2(want[recOffset:], 16, want[recOffset:], 16, wantCoeff)
+				WelsIDctFourT4Rec_sse2(got, recOffset, 16, got, recOffset, 16, gotCoeff)
+			} else {
+				idctFourT4RecAVX2(want[recOffset:], 16, pred, 31, wantCoeff)
+				WelsIDctFourT4Rec_sse2(got, recOffset, 16, pred, 0, 31, gotCoeff)
+			}
+			if !bytes.Equal(got, want) {
+				t.Fatalf("output offset %d, in place %t: coefficient alias changed", recOffset, inPlace)
+			}
+		}
+	}
+}
