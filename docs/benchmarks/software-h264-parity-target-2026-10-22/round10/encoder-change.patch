+)
+
+func BenchmarkQuantScanAVX2(b *testing.B) {
+	if !cpu.X86.HasAVX2 || !cpu.X86.HasSSSE3 {
+		b.Skip("AVX2/SSSE3 unavailable")
+	}
+	for _, blocks := range []int{4, 16} {
+		for _, density := range []string{"Zero", "Sparse", "Dense"} {
+			for _, avx2 := range []bool{false, true} {
+				b.Run(fmt.Sprintf("blocks%d/%s/AVX2%t", blocks, density, avx2), func(b *testing.B) {
+					var input, dct, levels [256]int16
+					var maxima [16]int16
+					var masks [16]uint16
+					ff, mf := g_kiQuantInterFF[20], g_kiQuantMF[20]
+					for i := range blocks * 16 {
+						if density == "Dense" || (density == "Sparse" && i%17 == 0) {
+							input[i] = int16(i*71 - 9000)
+						}
+					}
+					b.ReportAllocs()
+					if blocks == 4 {
+						if avx2 {
+							for b.Loop() {
+								copy(dct[:64], input[:64])
+								quantScanFour4x4AVX2((*[64]int16)(dct[:]), (*[64]int16)(levels[:]), &ff, &mf, (*[4]int16)(maxima[:]), (*[4]uint16)(masks[:]), 0)
+							}
+						} else {
+							for b.Loop() {
+								copy(dct[:64], input[:64])
+								quantScanFour4x4SSSE3((*[64]int16)(dct[:]), (*[64]int16)(levels[:]), &ff, &mf, (*[4]int16)(maxima[:]), (*[4]uint16)(masks[:]), 0)
+							}
+						}
+					} else if avx2 {
+						for b.Loop() {
+							dct = input
+							quantScanLumaAVX2(&dct, &levels, &ff, &mf, &maxima, &masks)
+						}
+					} else {
+						for b.Loop() {
+							dct = input
+							quantScanLumaSSSE3(&dct, &levels, &ff, &mf, &maxima, &masks)
+						}
+					}
+				})
+			}
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/quant_scan_intra_amd64.go b/pkg/h264/internal/encoder/quant_scan_intra_amd64.go
new file mode 100644
index 0000000..32b9fdd
--- /dev/null
+++ b/pkg/h264/internal/encoder/quant_scan_intra_amd64.go
@@ -0,0 +1,41 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"reflect"
+	"unsafe"
+
+	"golang.org/x/sys/cpu"
+)
+
+var intraACQuantFourSSE2PC = reflect.ValueOf(WelsQuantFour4x4_sse2).Pointer()
+
+//go:noescape
+func quantScanIntraLumaAVX2(dct, levels *[256]int16, ff, mf *[8]int16, masks *[16]uint16)
+
+// Try after DCT, so a custom transform can replace the quantization callback.
+// Only the exact built-in SSE2 quantizer has this packed unsigned arithmetic;
+// custom/scalar callbacks retain the original group-by-group call sequence.
+// Unlike inter/chroma quant-scan, intra16 always scans every coefficient: a
+// signed maximum of zero must not discard unsigned magnitudes >= 32768.
+func tryQuantScanIntraLuma(funcs *SWelsFuncPtrList, dct, levels, ff, mf []int16, masks *[16]uint16) bool {
+	if !cpu.X86.HasAVX2 || funcs == nil || len(dct) < 256 || len(levels) < 256 ||
+		len(ff) < 8 || len(mf) < 8 || masks == nil ||
+		reflect.ValueOf(funcs.pfQuantizationFour4x4).Pointer() != intraACQuantFourSSE2PC {
+		return false
+	}
+	d, l := unsafe.Pointer(&dct[0]), unsafe.Pointer(&levels[0])
+	f, q, m := unsafe.Pointer(&ff[0]), unsafe.Pointer(&mf[0]), unsafe.Pointer(masks)
+	// The batch snapshots tables once and interleaves raster/scan stores.
+	// Reject overlaps across the entire macroblock, including future groups.
+	// FF and MF may alias each other: neither is written on this path.
+	if quantScanRangesOverlap(d, 512, l, 512) ||
+		quantScanRangesOverlap(d, 512, m, 32) || quantScanRangesOverlap(l, 512, m, 32) ||
+		quantScanRangesOverlap(f, 16, d, 512) || quantScanRangesOverlap(f, 16, l, 512) || quantScanRangesOverlap(f, 16, m, 32) ||
+		quantScanRangesOverlap(q, 16, d, 512) || quantScanRangesOverlap(q, 16, l, 512) || quantScanRangesOverlap(q, 16, m, 32) {
+		return false
+	}
+	quantScanIntraLumaAVX2((*[256]int16)(dct), (*[256]int16)(levels), (*[8]int16)(ff), (*[8]int16)(mf), masks)
+	return true
+}
diff --git a/pkg/h264/internal/encoder/quant_scan_intra_amd64.s b/pkg/h264/internal/encoder/quant_scan_intra_amd64.s
new file mode 100644
index 0000000..b4bbe14
--- /dev/null
+++ b/pkg/h264/internal/encoder/quant_scan_intra_amd64.s
@@ -0,0 +1,84 @@
+//go:build amd64
+
+// Packed quantization follows Cisco OpenH264 codec/encoder/core/x86/quant.asm.
+// Copyright (c) 2009-2013, Cisco Systems.
+// BSD-2-Clause; see LICENSE-OpenH264 in the repository root.
+
+#include "textflag.h"
+
+// I16 AC always scans all sixteen quantized blocks. There is no signed maximum
+// reduction or zero shortcut: out-of-table magnitudes retain every bit exactly
+// as WelsQuantFour4x4_sse2 followed by coefficientScanMask(ac=true).
+// The checked entry excludes all output/table overlaps across the full spans.
+// func quantScanIntraLumaAVX2(dct, levels *[256]int16, ff, mf *[8]int16, masks *[16]uint16)
+TEXT ·quantScanIntraLumaAVX2(SB), NOSPLIT, $0-40
+	MOVQ dct+0(FP), AX
+	MOVQ levels+8(FP), BX
+	MOVQ ff+16(FP), CX
+	MOVQ mf+24(FP), DX
+	MOVQ masks+32(FP), SI
+	MOVL $8, R8
+	VBROADCASTI128 (CX), Y8
+	VBROADCASTI128 (DX), Y9
+	VPXOR Y10, Y10, Y10
+	VPCMPEQW Y11, Y11, Y11
+	VPSRLW $1, Y11, Y11
+	LEAQ intraACScanShuffle<>(SB), R10
+	VBROADCASTI128 (R10), Y12
+	VBROADCASTI128 16(R10), Y13
+	VBROADCASTI128 32(R10), Y14
+	VBROADCASTI128 48(R10), Y15
+intra_ac_quant_scan_pair:
+	VMOVDQU (AX), X0
+	VINSERTI128 $1, 32(AX), Y0, Y0
+	VMOVDQU 16(AX), X1
+	VINSERTI128 $1, 48(AX), Y1, Y1
+	VPABSW Y0, Y2
+	VPOR Y11, Y0, Y0
+	VPADDUSW Y8, Y2, Y2
+	VPMULHUW Y9, Y2, Y2
+	VPSIGNW Y0, Y2, Y0
+	VPABSW Y1, Y3
+	VPOR Y11, Y1, Y1
+	VPADDUSW Y8, Y3, Y3
+	VPMULHUW Y9, Y3, Y3
+	VPSIGNW Y1, Y3, Y1
+	VMOVDQU X0, (AX)
+	VEXTRACTI128 $1, Y0, 32(AX)
+	VMOVDQU X1, 16(AX)
+	VEXTRACTI128 $1, Y1, 48(AX)
+
+	VPSHUFB Y12, Y0, Y2
+	VPSHUFB Y13, Y1, Y3
+	VPOR Y3, Y2, Y2
+	VPSHUFB Y14, Y0, Y4
+	VPSHUFB Y15, Y1, Y5
+	VPOR Y5, Y4, Y4
+	VMOVDQU X2, (BX)
+	VEXTRACTI128 $1, Y2, 32(BX)
+	VMOVDQU X4, 16(BX)
+	VEXTRACTI128 $1, Y4, 48(BX)
+	VPCMPEQW Y10, Y2, Y2
+	VPCMPEQW Y10, Y4, Y4
+	VPACKSSWB Y4, Y2, Y2
+	VPMOVMSKB Y2, R9
+	XORL $-1, R9
+	MOVL R9, (SI)
+	ADDQ $64, AX
+	ADDQ $64, BX
+	ADDQ $4, SI
+	DECL R8
+	JNZ intra_ac_quant_scan_pair
+	VZEROUPPER
+	RET
+
+// AC zigzag omits coefficient zero and explicitly writes the trailing zero.
+DATA intraACScanShuffle<>+0(SB)/8, $0x0b0a808009080302
+DATA intraACScanShuffle<>+8(SB)/8, $0x80800d0c07060504
+DATA intraACScanShuffle<>+16(SB)/8, $0x8080010080808080
+DATA intraACScanShuffle<>+24(SB)/8, $0x0302808080808080
+DATA intraACScanShuffle<>+32(SB)/8, $0x0f0e808080808080
+DATA intraACScanShuffle<>+40(SB)/8, $0x8080808080808080
+DATA intraACScanShuffle<>+48(SB)/8, $0x808005040b0a0908
+DATA intraACScanShuffle<>+56(SB)/8, $0x80800f0e0d0c0706
+GLOBL intraACScanShuffle<>(SB), RODATA|NOPTR, $64
diff --git a/pkg/h264/internal/encoder/quant_scan_intra_amd64_test.go b/pkg/h264/internal/encoder/quant_scan_intra_amd64_test.go
new file mode 100644
index 0000000..158c981
--- /dev/null
+++ b/pkg/h264/internal/encoder/quant_scan_intra_amd64_test.go
@@ -0,0 +1,202 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"fmt"
+	"math/rand/v2"
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/cpu"
+)
+
+// Independent unsigned-word model of the selected SSE2 callback, including
+// saturating FF addition and signed FF/MF values interpreted as word bits.
+func intraACUnsignedReference(dct, levels []int16, ff, mf []int16) (masks [16]uint16) {
+	for i, value := range dct[:256] {
+		magnitude := int32(value)
+		if magnitude < 0 {
+			magnitude = -magnitude
+		}
+		rounded := min(uint32(magnitude)+uint32(uint16(ff[i%8])), uint32(65535))
+		quantized := uint16((rounded * uint32(uint16(mf[i%8]))) >> 16)
+		if value < 0 {
+			quantized = -quantized
+		}
+		dct[i] = int16(quantized)
+	}
+	for block := range 16 {
+		WelsScan4x4Ac_c(levels[block*16:], dct[block*16:])
+		for i, value := range levels[block*16 : block*16+16] {
+			if value != 0 {
+				masks[block] |= 1 << i
+			}
+		}
+	}
+	return masks
+}
+
+func TestIntraACRawAndCheckedParity(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 required")
+	}
+	rng := rand.New(rand.NewPCG(264, 164))
+	var funcs SWelsFuncPtrList
+	funcs.pfQuantizationFour4x4 = WelsQuantFour4x4_sse2
+	for trial := range 4096 {
+		var input [260]int16
+		var output [262]int16
+		var ff, mf [8]int16
+		for i := range input {
+			input[i] = int16(rng.Uint32())
+		}
+		for i := range output {
+			output[i] = -12345
+		}
+		if trial < 52 {
+			copy(ff[:], g_iQuantIntraFF[trial][:])
+			copy(mf[:], g_kiQuantMF[trial][:])
+		} else {
+			for i := range ff {
+				ff[i], mf[i] = int16(rng.Uint32()), int16(rng.Uint32())
+			}
+		}
+		if trial%8 == 0 {
+			clear(input[2:258])
+		}
+		if trial%8 == 1 {
+			for i := range ff {
+				ff[i], mf[i] = -1, -1
+			}
+		}
+		wantDct, wantLevels := input, output
+		wantMask := intraACUnsignedReference(wantDct[2:258], wantLevels[3:259], ff[:], mf[:])
+		for _, raw := range []bool{false, true} {
+			gotDct, gotLevels := input, output
+			gotMask := [18]uint16{0x1234}
+			gotMask[17] = 0x5678
+			if raw {
+				quantScanIntraLumaAVX2((*[256]int16)(gotDct[2:258]), (*[256]int16)(gotLevels[3:259]), &ff, &mf, (*[16]uint16)(gotMask[1:17]))
+			} else {
+				if !tryQuantScanIntraLuma(&funcs, gotDct[2:258], gotLevels[3:259], ff[:], mf[:], (*[16]uint16)(gotMask[1:17])) {
+					t.Fatal("valid built-in call declined")
+				}
+			}
+			if gotDct != wantDct || gotLevels != wantLevels || *(*[16]uint16)(gotMask[1:17]) != wantMask || gotMask[0] != 0x1234 || gotMask[17] != 0x5678 {
+				t.Fatalf("trial%d raw%v: raster, complete AC scan, masks or canaries differ", trial, raw)
+			}
+		}
+	}
+}
+
+func TestIntraACRawCoefficientDomain(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 required")
+	}
+	ff := [8]int16{0, 1, 32767, -32768, -1, 17, -1, 0}
+	mf := [8]int16{-1, 32767, -1, -32768, 1, 8192, -1, 0}
+	for value := -32768; value <= 32767; value++ {
+		var got, want [256]int16
+		for _, offset := range []int{0, 1, 7, 8, 15, 16, 63, 64, 127, 128, 239, 255} {
+			got[offset] = int16(value)
+		}
+		want = got
+		var gotLevels, wantLevels [256]int16
+		var gotMask [16]uint16
+		wantMask := intraACUnsignedReference(want[:], wantLevels[:], ff[:], mf[:])
+		quantScanIntraLumaAVX2(&got, &gotLevels, &ff, &mf, &gotMask)
+		if got != want || gotLevels != wantLevels || gotMask != wantMask {
+			t.Fatalf("coefficient%d: output differs", value)
+		}
+	}
+}
+
+func TestIntraACPreflightNoMutation(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 required")
+	}
+	for _, scenario := range []string{"shortDct", "shortLevels", "shortFF", "shortMF", "nilMasks", "nilFuncs", "nilQuant", "scalarQuant", "customQuant", "sameOutput", "futureGroupOutput", "ffDct", "mfDct", "ffLevels", "mfLevels", "masksDct", "masksLevels", "ffMasks", "mfMasks"} {
+		t.Run(scenario, func(t *testing.T) {
+			var data [1024]int16
+			for i := range data {
+				data[i] = int16(i*71 - 30000)
+			}
+			var funcs SWelsFuncPtrList
+			funcs.pfQuantizationFour4x4 = WelsQuantFour4x4_sse2
+			funcPtr := &funcs
+			dct, levels, ff, mf := data[:256], data[256:512], data[512:520], data[520:528]
+			masks := (*[16]uint16)(unsafe.Pointer(&data[528]))
+			switch scenario {
+			case "shortDct":
+				dct = dct[:255]
+			case "shortLevels":
+				levels = levels[:255]
+			case "shortFF":
+				ff = ff[:7]
+			case "shortMF":
+				mf = mf[:7]
+			case "nilMasks":
+				masks = nil
+			case "nilFuncs":
+				funcPtr = nil
+			case "nilQuant":
+				funcs.pfQuantizationFour4x4 = nil
+			case "scalarQuant":
+				funcs.pfQuantizationFour4x4 = WelsQuantFour4x4_c
+			case "customQuant":
+				funcs.pfQuantizationFour4x4 = func(d, f, m []int16) { WelsQuantFour4x4_sse2(d, f, m) }
+			case "sameOutput":
+				levels = dct
+			case "futureGroupOutput":
+				levels = data[192:448]
+			case "ffDct":
+				ff = data[240:248]
+			case "mfDct":
+				mf = data[240:248]
+			case "ffLevels":
+				ff = data[496:504]
+			case "mfLevels":
+				mf = data[496:504]
+			case "masksDct":
+				masks = (*[16]uint16)(unsafe.Pointer(&data[240]))
+			case "masksLevels":
+				masks = (*[16]uint16)(unsafe.Pointer(&data[496]))
+			case "ffMasks":
+				ff = data[528:536]
+			case "mfMasks":
+				mf = data[528:536]
+			}
+			before := data
+			if tryQuantScanIntraLuma(funcPtr, dct, levels, ff, mf, masks) || data != before {
+				t.Fatal("rejected input performed work")
+			}
+		})
+	}
+}
+
+func TestIntraACReadOnlyTableAlias(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 required")
+	}
+	for _, shift := range []int{0, 1, 7} {
+		t.Run(fmt.Sprint(shift), func(t *testing.T) {
+			var tables [16]int16
+			for i := range tables {
+				tables[i] = int16(i*4093 - 32768)
+			}
+			var got, want, gotLevels, wantLevels [256]int16
+			for i := range got {
+				got[i] = int16(i*293 - 32768)
+			}
+			want = got
+			before := tables
+			wantMasks := intraACUnsignedReference(want[:], wantLevels[:], tables[:8], tables[shift:shift+8])
+			var masks [16]uint16
+			funcs := SWelsFuncPtrList{pfQuantizationFour4x4: WelsQuantFour4x4_sse2}
+			if !tryQuantScanIntraLuma(&funcs, got[:], gotLevels[:], tables[:8], tables[shift:shift+8], &masks) || got != want || gotLevels != wantLevels || masks != wantMasks || tables != before {
+				t.Fatal("read-only table alias differs")
+			}
+		})
+	}
+}
diff --git a/pkg/h264/internal/encoder/quant_scan_intra_caller_reference_test.go b/pkg/h264/internal/encoder/quant_scan_intra_caller_reference_test.go
new file mode 100644
index 0000000..17d3ad3
--- /dev/null
+++ b/pkg/h264/internal/encoder/quant_scan_intra_caller_reference_test.go
@@ -0,0 +1,95 @@
+package encoder
+
+import (
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+	"math/bits"
+)
+
+// Frozen round8 complete I16 caller, retaining the separate quant/scan sequence.
+func intraACOriginalCaller(pEncCtx *sWelsEncCtx, pCurMb *SMB, pMbCache *SMbCache) {
+	var aDctT4Dc [16]int16
+	pFuncList := pEncCtx.pFuncList
+	pCurDqLayer := pEncCtx.pCurDqLayer
+	kiEncStride := pCurDqLayer.iEncStride[0]
+	pRes := pMbCache.pCoeffLevel
+	pPred := pMbCache.SPicData.pCsMb[0]
+	iPredOff := pMbCache.SPicData.iCsMbOff[0]
+	kiRecStride := pCurDqLayer.iCsStride[0]
+	pBlock := pMbCache.pDct.iLumaBlock[:]
+	pBestPred := pMbCache.pMemPredLuma
+	kpNoneZeroCountIdx := common.G_kuiMbCountScan4Idx[:]
+	uiQp := pCurMb.uiLumaQp
+	var uiNoneZeroCount, uiNoneZeroCountMbAc, uiCountI16x16Dc uint32
+
+	pMF := g_kiQuantMF[uiQp][:]
+	pFF := g_iQuantIntraFF[uiQp][:]
+
+	WelsDctMb(pRes, pMbCache.SPicData.pEncMb[0], pMbCache.SPicData.iEncMbOff[0], kiEncStride, pBestPred, 0, pEncCtx.pFuncList.pfDctFourT4)
+
+	WelsHadamardT4Dc_c(aDctT4Dc[:], pRes)
+	WelsQuant4x4Dc_sse2(aDctT4Dc[:], int16(int32(pFF[0])<<1), pMF[0]>>1)
+	dcMask := coefficientScanMask(pMbCache.pDct.iLumaI16x16Dc[:], aDctT4Dc[:], false)
+	uiCountI16x16Dc = uint32(bits.OnesCount16(dcMask))
+	var masks [16]uint16
+
+	for i := 0; i < 4; i++ {
+		r := pRes[i*64:]
+		b := pBlock[i*64:]
+		pFuncList.pfQuantizationFour4x4(r, pFF, pMF)
+		masks[i*4] = coefficientScanMask(b, r, true)
+		masks[i*4+1] = coefficientScanMask(b[16:], r[16:], true)
+		masks[i*4+2] = coefficientScanMask(b[32:], r[32:], true)
+		masks[i*4+3] = coefficientScanMask(b[48:], r[48:], true)
+	}
+
+	for i := 0; i < 16; i++ {
+		uiNoneZeroCount = uint32(bits.OnesCount16(masks[i]))
+		pCurMb.pNonZeroCount[kpNoneZeroCountIdx[i]] = int8(uiNoneZeroCount)
+		uiNoneZeroCountMbAc += uiNoneZeroCount
+	}
+
+	if uiCountI16x16Dc > 0 {
+		if uiQp < 12 {
+			WelsIHadamard4x4Dc(aDctT4Dc[:])
+			WelsDequantLumaDc4x4(aDctT4Dc[:], int32(uiQp))
+		} else {
+			WelsDequantIHadamard4x4_c(aDctT4Dc[:], common.G_kuiDequantCoeff[uiQp][0]>>2)
+		}
+	}
+
+	if uiNoneZeroCountMbAc > 0 {
+		pCurMb.uiCbp = 15
+		pFuncList.pfDequantizationFour4x4(pRes, common.G_kuiDequantCoeff[uiQp][:])
+		pFuncList.pfDequantizationFour4x4(pRes[64:], common.G_kuiDequantCoeff[uiQp][:])
+		pFuncList.pfDequantizationFour4x4(pRes[128:], common.G_kuiDequantCoeff[uiQp][:])
+		pFuncList.pfDequantizationFour4x4(pRes[192:], common.G_kuiDequantCoeff[uiQp][:])
+
+		pRes[0] = aDctT4Dc[0]
+		pRes[16] = aDctT4Dc[1]
+		pRes[32] = aDctT4Dc[4]
+		pRes[48] = aDctT4Dc[5]
+		pRes[64] = aDctT4Dc[2]
+		pRes[80] = aDctT4Dc[3]
+		pRes[96] = aDctT4Dc[6]
+		pRes[112] = aDctT4Dc[7]
+		pRes[128] = aDctT4Dc[8]
+		pRes[144] = aDctT4Dc[9]
+		pRes[160] = aDctT4Dc[12]
+		pRes[176] = aDctT4Dc[13]
+		pRes[192] = aDctT4Dc[10]
+		pRes[208] = aDctT4Dc[11]
+		pRes[224] = aDctT4Dc[14]
+		pRes[240] = aDctT4Dc[15]
+
+		pFuncList.pfIDctFourT4(pPred, iPredOff, kiRecStride, pBestPred, 0, 16, pRes)
+		pFuncList.pfIDctFourT4(pPred, iPredOff+8, kiRecStride, pBestPred, 8, 16, pRes[64:])
+		pFuncList.pfIDctFourT4(pPred, iPredOff+int(kiRecStride)*8, kiRecStride, pBestPred, 128, 16, pRes[128:])
+		pFuncList.pfIDctFourT4(pPred, iPredOff+int(kiRecStride)*8+8, kiRecStride, pBestPred, 136, 16, pRes[192:])
+	} else if uiCountI16x16Dc > 0 {
+		// A direct call keeps the local DC coefficients on the stack. The amd64
+		// wrapper uses baseline SSE2; other architectures keep the scalar path.
+		WelsIDctRecI16x16Dc_sse2(pPred, iPredOff, kiRecStride, pBestPred, 0, 16, aDctT4Dc[:])
+	} else {
+		pFuncList.pfCopy16x16Aligned(pPred, iPredOff, kiRecStride, pBestPred, 0, 16)
+	}
+}
diff --git a/pkg/h264/internal/encoder/quant_scan_intra_caller_test.go b/pkg/h264/internal/encoder/quant_scan_intra_caller_test.go
new file mode 100644
index 0000000..ea6fcd7
--- /dev/null
+++ b/pkg/h264/internal/encoder/quant_scan_intra_caller_test.go
@@ -0,0 +1,175 @@
+package encoder
+
+import (
+	"bytes"
+	"fmt"
+	"reflect"
+	"testing"
+	"unsafe"
+)
+
+func sameIntraACState(got, want *intraDCFixture) bool {
+	g, w := got.base, want.base
+	return g.mb.uiCbp == w.mb.uiCbp && g.nonzero == w.nonzero && g.coefficients == w.coefficients && g.dct == w.dct &&
+		got.prediction == want.prediction && bytes.Equal(g.source, w.source) && bytes.Equal(g.reconstructed, w.reconstructed) &&
+		reflect.DeepEqual(g.mb.pNonZeroCount, w.mb.pNonZeroCount)
+}
+
+func intraACCallPanic(call func()) (message string) {
+	defer func() {
+		if value := recover(); value != nil {
+			message = fmt.Sprintf("%T: %v", value, value)
+		}
+	}()
+	call()
+	return
+}
+
+func TestIntraACCompleteCallerParity(t *testing.T) {
+	for _, strides := range [][2]int32{{16, 16}, {23, 29}, {1920, 1984}} {
+		for _, content := range []string{"Zero", "DC", "Sparse", "Dense"} {
+			t.Run(fmt.Sprintf("%s/Stride%d_%d", content, strides[0], strides[1]), func(t *testing.T) {
+				for qp := uint8(0); qp <= 51; qp++ {
+					got, want := newIntraDCFixture(strides[0], strides[1], qp, content), newIntraDCFixture(strides[0], strides[1], qp, content)
+					WelsEncRecI16x16Y(&got.base.ctx, &got.base.mb, &got.base.cache)
+					intraACOriginalCaller(&want.base.ctx, &want.base.mb, &want.base.cache)
+					if !sameIntraACState(got, want) {
+						t.Fatalf("QP%d: full coefficient/count/reconstruction state differs", qp)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestIntraACCustomCallbacksAndAliases(t *testing.T) {
+	for _, scenario := range []string{"customQuant", "customAfterDCT", "builtinAfterDCT", "nilAfterDCT", "quantChangesNext", "quantPartialPanic", "scalarQuant", "fullRangeDCT", "snapshotFunctions", "snapshotResidual", "sameOutput", "futureOutput", "aliasedCounts", "shortCounts0", "shortCounts1", "shortCounts7", "shortCounts15"} {
+		for _, qp := range []uint8{0, 11, 12, 26, 51} {
+			t.Run(fmt.Sprintf("%s/QP%d", scenario, qp), func(t *testing.T) {
+				got, want := newIntraDCFixture(23, 29, qp, "Dense"), newIntraDCFixture(23, 29, qp, "Dense")
+				var events [2][]string
+				for route, f := range []*intraDCFixture{got, want} {
+					g := f.base
+					quantCalls := 0
+					customQuant := func(res, ff, mf []int16) {
+						quantCalls++
+						events[route] = append(events[route], fmt.Sprintf("Q%d", quantCalls))
+						WelsQuantFour4x4_sse2(res, ff, mf)
+						res[1] ^= 123
+						if scenario == "quantPartialPanic" {
+							panic("quantization callback")
+						}
+						if scenario == "quantChangesNext" && quantCalls == 1 {
+							g.functions.pfQuantizationFour4x4 = func(res, ff, mf []int16) {
+								events[route] = append(events[route], "replacementQ")
+								WelsQuantFour4x4_sse2(res, ff, mf)
+								res[7] ^= 77
+							}
+						}
+					}
+					switch scenario {
+					case "customQuant", "quantChangesNext", "quantPartialPanic", "snapshotFunctions":
+						g.functions.pfQuantizationFour4x4 = customQuant
+					case "builtinAfterDCT":
+						g.functions.pfQuantizationFour4x4 = func([]int16, []int16, []int16) { panic("stale quantizer") }
+					case "scalarQuant":
+						g.functions.pfQuantizationFour4x4 = WelsQuantFour4x4_c
+					case "sameOutput":
+						g.cache.pCoeffLevel = g.dct.iLumaBlock[:]
+					case "futureOutput":
+						g.cache.pCoeffLevel = unsafe.Slice((*int16)(unsafe.Pointer(&g.dct)), 408)[16:272]
+					case "aliasedCounts":
+						g.mb.pNonZeroCount = unsafe.Slice((*int8)(unsafe.Pointer(&g.coefficients[0])), 24)
+					case "shortCounts0":
+						g.mb.pNonZeroCount = g.nonzero[:0]
+					case "shortCounts1":
+						g.mb.pNonZeroCount = g.nonzero[:1]
+					case "shortCounts7":
+						g.mb.pNonZeroCount = g.nonzero[:7]
+					case "shortCounts15":
+						g.mb.pNonZeroCount = g.nonzero[:15]
+					}
+					dctCalls := 0
+					dct := g.functions.pfDctFourT4
+					g.functions.pfDctFourT4 = func(res []int16, a []uint8, aOff int, aStride int32, b []uint8, bOff int, bStride int32) {
+						dctCalls++
+						events[route] = append(events[route], fmt.Sprintf("D%d", dctCalls))
+						if scenario == "fullRangeDCT" {
+							for i := range 64 {
+								res[i] = int16((i+dctCalls*17)*1701 - 32768)
+							}
+						} else {
+							dct(res, a, aOff, aStride, b, bOff, bStride)
+						}
+						if dctCalls == 4 {
+							switch scenario {
+							case "customAfterDCT":
+								g.functions.pfQuantizationFour4x4 = customQuant
+							case "builtinAfterDCT":
+								g.functions.pfQuantizationFour4x4 = WelsQuantFour4x4_sse2
+							case "nilAfterDCT":
+								g.functions.pfQuantizationFour4x4 = nil
+							case "snapshotFunctions":
+								g.ctx.pFuncList = &SWelsFuncPtrList{}
+							case "snapshotResidual":
+								g.cache.pCoeffLevel = nil
+							}
+						}
+					}
+					// These custom scan callbacks were already bypassed by the
+					// separate coefficientScanMask calls and must remain unused.
+					g.functions.pfScan4x4Ac = func([]int16, []int16) { panic("unexpected scan callback") }
+				}
+				gp := intraACCallPanic(func() { WelsEncRecI16x16Y(&got.base.ctx, &got.base.mb, &got.base.cache) })
+				wp := intraACCallPanic(func() { intraACOriginalCaller(&want.base.ctx, &want.base.mb, &want.base.cache) })
+				if gp != wp || !reflect.DeepEqual(events[0], events[1]) || !sameIntraACState(got, want) {
+					t.Fatalf("panic%q/%q events%v/%v or full state differs", gp, wp, events[0], events[1])
+				}
+				if scenario == "customAfterDCT" || scenario == "customQuant" || scenario == "snapshotFunctions" {
+					if !reflect.DeepEqual(events[0], []string{"D1", "D2", "D3", "D4", "Q1", "Q2", "Q3", "Q4"}) {
+						t.Fatalf("callback capture/order differs: %v", events[0])
+					}
+				}
+				if scenario == "quantChangesNext" && !reflect.DeepEqual(events[0], []string{"D1", "D2", "D3", "D4", "Q1", "replacementQ", "replacementQ", "replacementQ"}) {
+					t.Fatalf("callback replacement was not observed: %v", events[0])
+				}
+				wantPanic := scenario == "nilAfterDCT" || scenario == "quantPartialPanic" || scenario == "shortCounts0" || scenario == "shortCounts1" || scenario == "shortCounts7" || scenario == "shortCounts15"
+				if (gp != "") != wantPanic {
+					t.Fatalf("fixture panic=%q, wantPanic=%v", gp, wantPanic)
+				}
+			})
+		}
+	}
+}
+
+func TestIntraACShortResidualPartialState(t *testing.T) {
+	for _, length := range []int{0, 63, 64, 127, 128, 191, 192, 240, 241, 255, 256, 384} {
+		t.Run(fmt.Sprint(length), func(t *testing.T) {
+			got, want := newIntraDCFixture(23, 29, 26, "Dense"), newIntraDCFixture(23, 29, 26, "Dense")
+			var calls [2]int
+			for route, f := range []*intraDCFixture{got, want} {
+				f.base.cache.pCoeffLevel = f.base.coefficients[:length]
+				f.base.functions.pfDctFourT4 = func(res []int16, a []uint8, aOff int, aStride int32, b []uint8, bOff int, bStride int32) {
+					calls[route]++
+					for i := range min(len(res), 64) {
+						res[i] = int16((i+calls[route]*17)*1701 - 32768)
+					}
+				}
+			}
+			gp := intraACCallPanic(func() { WelsEncRecI16x16Y(&got.base.ctx, &got.base.mb, &got.base.cache) })
+			wp := intraACCallPanic(func() { intraACOriginalCaller(&want.base.ctx, &want.base.mb, &want.base.cache) })
+			if gp != wp || calls[0] != calls[1] || !sameIntraACState(got, want) || (gp == "") != (length >= 256) {
+				t.Fatalf("len%d panic%q/%q calls%v or partial state differs", length, gp, wp, calls)
+			}
+		})
+	}
+}
+
+func TestIntraACCompleteCallerNoAllocs(t *testing.T) {
+	for _, content := range []string{"Zero", "DC", "Sparse", "Dense"} {
+		f := newIntraDCFixture(1920, 1984, 20, content)
+		if n := testing.AllocsPerRun(100, func() { f.base.mb.uiCbp = 0x30; WelsEncRecI16x16Y(&f.base.ctx, &f.base.mb, &f.base.cache) }); n != 0 {
+			t.Fatalf("%s: %.2f allocations, want zero", content, n)
+		}
+	}
+}
