@@ -0,0 +1,52 @@
+package encoder
+
+import (
+	"fmt"
+	"testing"
+)
+
+var intraDCBenchmarkSink int16
+
+// Copy this file to the baseline with the supplied test-only dispatcher shim.
+// Both routes include their public-length checks and inverse input reset cost.
+func BenchmarkIntraDCTransforms(b *testing.B) {
+	for _, scalar := range []bool{false, true} {
+		b.Run(fmt.Sprintf("Forward/scalar=%t", scalar), func(b *testing.B) {
+			var source [241]int16
+			for i := range source {
+				source[i] = int16(i*1701 - 32768)
+			}
+			var output [16]int16
+			b.ReportAllocs()
+			if scalar {
+				for b.Loop() {
+					WelsHadamardT4Dc_c(output[:], source[:])
+				}
+			} else {
+				for b.Loop() {
+					hadamardT4Dc(output[:], source[:])
+				}
+			}
+			intraDCBenchmarkSink = output[0]
+		})
+		for _, mf := range []uint16{10, 104, 832, 65535} {
+			b.Run(fmt.Sprintf("Inverse/mf%d/scalar=%t", mf, scalar), func(b *testing.B) {
+				input := [16]int16{-32768, 32767, -1, 1, 16384, -16385, 8191, -8192, 32766, -32767, 3, -5, 7, -11, 13, -17}
+				var output [16]int16
+				b.ReportAllocs()
+				if scalar {
+					for b.Loop() {
+						output = input
+						WelsDequantIHadamard4x4_c(output[:], mf)
+					}
+				} else {
+					for b.Loop() {
+						output = input
+						dequantIHadamard4x4(output[:], mf)
+					}
+				}
+				intraDCBenchmarkSink = output[0]
+			})
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/intra_dc_caller_bench_test.go b/pkg/h264/internal/encoder/intra_dc_caller_bench_test.go
new file mode 100644
index 0000000..c9390ee
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_dc_caller_bench_test.go
@@ -0,0 +1,55 @@
+package encoder
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+type intraDCFixture struct {
+	base       *intraReconstructionFixture
+	prediction [256]byte
+}
+
+func newIntraDCFixture(encStride, recStride int32, qp uint8, content string) *intraDCFixture {
+	f := &intraDCFixture{base: newIntraReconstructionFixture(encStride, recStride, qp, content, common.WelsCPUFeatureDetect(nil))}
+	f.base.mb.uiMbType = common.MB_TYPE_INTRA16x16
+	for i := range f.prediction {
+		f.prediction[i] = 128
+	}
+	f.base.cache.pMemPredLuma = f.prediction[:]
+	if content == "DC" {
+		for y := 0; y < 16; y++ {
+			for x := 0; x < 16; x++ {
+				f.base.source[3+y*int(encStride)+x] = 144
+			}
+		}
+	}
+	return f
+}
+
+var intraDCCallerBenchmarkSink uint8
+
+// Baseline-compatible complete I16 entry: sixteen DCTs, DC Hadamard/quant/scan,
+// AC quantization and bookkeeping, inverse DC and reconstruction/copy branches.
+// Fixture and source setup are outside the timed loop. Use alongside raw DC
+// timings so a faster transform is not mistaken for a faster production caller.
+func BenchmarkI16Reconstruction(b *testing.B) {
+	for _, strides := range [][2]int32{{64, 64}, {1920, 1984}} {
+		for _, qp := range []uint8{8, 20, 32} {
+			for _, content := range []string{"Zero", "DC", "Sparse", "Dense"} {
+				b.Run(fmt.Sprintf("%s/QP%d/Stride%d_%d", content, qp, strides[0], strides[1]), func(b *testing.B) {
+					f := newIntraDCFixture(strides[0], strides[1], qp, content)
+					b.ReportAllocs()
+					for b.Loop() {
+						f.base.mb.uiCbp = 0x30
+						WelsEncRecI16x16Y(&f.base.ctx, &f.base.mb, &f.base.cache)
+					}
+					b.ReportMetric(1, "macroblocks/op")
+					intraDCCallerBenchmarkSink = f.base.mb.uiCbp
+				})
+			}
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/intra_dc_caller_reference_test.go b/pkg/h264/internal/encoder/intra_dc_caller_reference_test.go
new file mode 100644
index 0000000..450b8a4
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_dc_caller_reference_test.go
@@ -0,0 +1,97 @@
+package encoder
+
+import (
+	"math/bits"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+// Preserved round7 complete caller; only its two DC transforms differ from
+// the candidate. Other callbacks, quantizers, bookkeeping and stores are shared.
+func welsEncRecI16x16ScalarDCReference(pEncCtx *sWelsEncCtx, pCurMb *SMB, pMbCache *SMbCache) {
+	var aDctT4Dc [16]int16
+	pFuncList := pEncCtx.pFuncList
+	pCurDqLayer := pEncCtx.pCurDqLayer
+	kiEncStride := pCurDqLayer.iEncStride[0]
+	pRes := pMbCache.pCoeffLevel
+	pPred := pMbCache.SPicData.pCsMb[0]
+	iPredOff := pMbCache.SPicData.iCsMbOff[0]
+	kiRecStride := pCurDqLayer.iCsStride[0]
+	pBlock := pMbCache.pDct.iLumaBlock[:]
+	pBestPred := pMbCache.pMemPredLuma
+	kpNoneZeroCountIdx := common.G_kuiMbCountScan4Idx[:]
+	uiQp := pCurMb.uiLumaQp
+	var uiNoneZeroCount, uiNoneZeroCountMbAc, uiCountI16x16Dc uint32
+
+	pMF := g_kiQuantMF[uiQp][:]
+	pFF := g_iQuantIntraFF[uiQp][:]
+
+	WelsDctMb(pRes, pMbCache.SPicData.pEncMb[0], pMbCache.SPicData.iEncMbOff[0], kiEncStride, pBestPred, 0, pEncCtx.pFuncList.pfDctFourT4)
+
+	WelsHadamardT4Dc_c(aDctT4Dc[:], pRes)
+	WelsQuant4x4Dc_sse2(aDctT4Dc[:], int16(int32(pFF[0])<<1), pMF[0]>>1)
+	dcMask := coefficientScanMask(pMbCache.pDct.iLumaI16x16Dc[:], aDctT4Dc[:], false)
+	uiCountI16x16Dc = uint32(bits.OnesCount16(dcMask))
+	var masks [16]uint16
+
+	for i := 0; i < 4; i++ {
+		r := pRes[i*64:]
+		b := pBlock[i*64:]
+		pFuncList.pfQuantizationFour4x4(r, pFF, pMF)
+		masks[i*4] = coefficientScanMask(b, r, true)
+		masks[i*4+1] = coefficientScanMask(b[16:], r[16:], true)
+		masks[i*4+2] = coefficientScanMask(b[32:], r[32:], true)
+		masks[i*4+3] = coefficientScanMask(b[48:], r[48:], true)
+	}
+
+	for i := 0; i < 16; i++ {
+		uiNoneZeroCount = uint32(bits.OnesCount16(masks[i]))
+		pCurMb.pNonZeroCount[kpNoneZeroCountIdx[i]] = int8(uiNoneZeroCount)
+		uiNoneZeroCountMbAc += uiNoneZeroCount
+	}
+
+	if uiCountI16x16Dc > 0 {
+		if uiQp < 12 {
+			WelsIHadamard4x4Dc(aDctT4Dc[:])
+			WelsDequantLumaDc4x4(aDctT4Dc[:], int32(uiQp))
+		} else {
+			WelsDequantIHadamard4x4_c(aDctT4Dc[:], common.G_kuiDequantCoeff[uiQp][0]>>2)
+		}
+	}
+
+	if uiNoneZeroCountMbAc > 0 {
+		pCurMb.uiCbp = 15
+		pFuncList.pfDequantizationFour4x4(pRes, common.G_kuiDequantCoeff[uiQp][:])
+		pFuncList.pfDequantizationFour4x4(pRes[64:], common.G_kuiDequantCoeff[uiQp][:])
+		pFuncList.pfDequantizationFour4x4(pRes[128:], common.G_kuiDequantCoeff[uiQp][:])
+		pFuncList.pfDequantizationFour4x4(pRes[192:], common.G_kuiDequantCoeff[uiQp][:])
+
+		pRes[0] = aDctT4Dc[0]
+		pRes[16] = aDctT4Dc[1]
+		pRes[32] = aDctT4Dc[4]
+		pRes[48] = aDctT4Dc[5]
+		pRes[64] = aDctT4Dc[2]
+		pRes[80] = aDctT4Dc[3]
+		pRes[96] = aDctT4Dc[6]
+		pRes[112] = aDctT4Dc[7]
+		pRes[128] = aDctT4Dc[8]
+		pRes[144] = aDctT4Dc[9]
+		pRes[160] = aDctT4Dc[12]
+		pRes[176] = aDctT4Dc[13]
+		pRes[192] = aDctT4Dc[10]
+		pRes[208] = aDctT4Dc[11]
+		pRes[224] = aDctT4Dc[14]
+		pRes[240] = aDctT4Dc[15]
+
+		pFuncList.pfIDctFourT4(pPred, iPredOff, kiRecStride, pBestPred, 0, 16, pRes)
+		pFuncList.pfIDctFourT4(pPred, iPredOff+8, kiRecStride, pBestPred, 8, 16, pRes[64:])
+		pFuncList.pfIDctFourT4(pPred, iPredOff+int(kiRecStride)*8, kiRecStride, pBestPred, 128, 16, pRes[128:])
+		pFuncList.pfIDctFourT4(pPred, iPredOff+int(kiRecStride)*8+8, kiRecStride, pBestPred, 136, 16, pRes[192:])
+	} else if uiCountI16x16Dc > 0 {
+		// A direct call keeps the local DC coefficients on the stack. The amd64
+		// wrapper uses baseline SSE2; other architectures keep the scalar path.
+		WelsIDctRecI16x16Dc_sse2(pPred, iPredOff, kiRecStride, pBestPred, 0, 16, aDctT4Dc[:])
+	} else {
+		pFuncList.pfCopy16x16Aligned(pPred, iPredOff, kiRecStride, pBestPred, 0, 16)
+	}
+}
diff --git a/pkg/h264/internal/encoder/intra_dc_caller_test.go b/pkg/h264/internal/encoder/intra_dc_caller_test.go
new file mode 100644
index 0000000..ca909af
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_dc_caller_test.go
@@ -0,0 +1,82 @@
+package encoder
+
+import (
+	"bytes"
+	"fmt"
+	"testing"
+)
+
+func sameIntraDCFixture(got, want *intraDCFixture) bool {
+	g, w := got.base, want.base
+	return g.mb.uiCbp == w.mb.uiCbp && g.nonzero == w.nonzero && g.coefficients == w.coefficients && g.dct == w.dct &&
+		got.prediction == want.prediction && bytes.Equal(g.source, w.source) && bytes.Equal(g.reconstructed, w.reconstructed)
+}
+
+func TestIntraDCCallerParity(t *testing.T) {
+	for _, strides := range [][2]int32{{16, 16}, {23, 29}, {1920, 1984}} {
+		for _, content := range []string{"Zero", "DC", "Sparse", "Dense"} {
+			t.Run(fmt.Sprintf("%s/Stride%d_%d", content, strides[0], strides[1]), func(t *testing.T) {
+				for qp := uint8(0); qp <= 51; qp++ {
+					got := newIntraDCFixture(strides[0], strides[1], qp, content)
+					want := newIntraDCFixture(strides[0], strides[1], qp, content)
+					WelsEncRecI16x16Y(&got.base.ctx, &got.base.mb, &got.base.cache)
+					welsEncRecI16x16ScalarDCReference(&want.base.ctx, &want.base.mb, &want.base.cache)
+					if !sameIntraDCFixture(got, want) {
+						t.Fatalf("QP%d: complete reconstruction state differs", qp)
+					}
+					if content == "Zero" && got.base.mb.uiCbp != 0x30 {
+						t.Fatalf("QP%d: zero residual unexpectedly set luma CBP", qp)
+					}
+					if content == "DC" {
+						if got.base.mb.uiCbp != 0x30 || got.base.dct.iLumaI16x16Dc == [16]int16{} {
+							t.Fatalf("QP%d: DC-only fixture did not exercise inverse DC reconstruction", qp)
+						}
+					}
+					if content == "Dense" && got.base.mb.uiCbp&15 == 0 {
+						t.Fatalf("QP%d: dense fixture did not exercise AC reconstruction", qp)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestIntraDCCallerCustomTransformAndFailures(t *testing.T) {
+	for _, length := range []int{0, 63, 64, 127, 128, 191, 192, 240, 241, 255, 256, 384} {
+		for _, qp := range []uint8{0, 11, 12, 20, 51} {
+			got := newIntraDCFixture(23, 29, qp, "Dense")
+			want := newIntraDCFixture(23, 29, qp, "Dense")
+			var calls [2]int
+			for route, f := range []*intraDCFixture{got, want} {
+				f.base.cache.pCoeffLevel = f.base.coefficients[:length]
+				f.base.functions.pfDctFourT4 = func(res []int16, a []uint8, aOff int, aStride int32, b []uint8, bOff int, bStride int32) {
+					calls[route]++
+					for i := 0; i < len(res) && i < 64; i++ {
+						res[i] = int16((i+calls[route]*17)*1701 - 32768)
+					}
+				}
+				// These callbacks were bypassed by the old direct scalar calls.
+				// Installing optimized direct calls must not newly consult them.
+				f.base.functions.pfTransformHadamard4x4Dc = func([]int16, []int16) { panic("unexpected Hadamard callback") }
+				f.base.functions.pfDequantizationIHadamard4x4 = func([]int16, uint16) { panic("unexpected inverse callback") }
+			}
+			gotPanic := intraDCPanic(func() { WelsEncRecI16x16Y(&got.base.ctx, &got.base.mb, &got.base.cache) })
+			wantPanic := intraDCPanic(func() { welsEncRecI16x16ScalarDCReference(&want.base.ctx, &want.base.mb, &want.base.cache) })
+			if gotPanic != wantPanic || calls[0] != calls[1] || !sameIntraDCFixture(got, want) || (length >= 256 && gotPanic != "") {
+				t.Fatalf("length%d QP%d: panic%q/%q calls%v or partial state differs", length, qp, gotPanic, wantPanic, calls)
+			}
+		}
+	}
+}
+
+func TestIntraDCCallerNoAllocs(t *testing.T) {
+	for _, content := range []string{"Zero", "DC", "Sparse", "Dense"} {
+		f := newIntraDCFixture(1920, 1984, 20, content)
+		if allocations := testing.AllocsPerRun(100, func() {
+			f.base.mb.uiCbp = 0x30
+			WelsEncRecI16x16Y(&f.base.ctx, &f.base.mb, &f.base.cache)
+		}); allocations != 0 {
+			t.Fatalf("%s: %.2f allocations, want zero", content, allocations)
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/intra_dc_guard_linux_amd64_test.go b/pkg/h264/internal/encoder/intra_dc_guard_linux_amd64_test.go
new file mode 100644
index 0000000..1db6bb0
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_dc_guard_linux_amd64_test.go
@@ -0,0 +1,72 @@
+//go:build linux && amd64
+
+package encoder
+
+import (
+	"fmt"
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+func intraDCGuardedBuffer(t *testing.T, size int, atEnd bool) ([]byte, func()) {
+	t.Helper()
+	page := unix.Getpagesize()
+	mapping, err := unix.Mmap(-1, 0, 3*page, unix.PROT_READ|unix.PROT_WRITE, unix.MAP_ANON|unix.MAP_PRIVATE)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := unix.Munmap(mapping); err != nil {
+			t.Error(err)
+		}
+	})
+	if err := unix.Mprotect(mapping[:page], unix.PROT_NONE); err != nil {
+		t.Fatal(err)
+	}
+	if err := unix.Mprotect(mapping[2*page:], unix.PROT_NONE); err != nil {
+		t.Fatal(err)
+	}
+	start := page
+	if atEnd {
+		start = 2*page - size
+	}
+	return mapping[start : start+size : start+size], func() {
+		t.Helper()
+		if err := unix.Mprotect(mapping[page:2*page], unix.PROT_READ); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestIntraDCRawGuards(t *testing.T) {
+	for _, atEnd := range []bool{false, true} {
+		t.Run(fmt.Sprintf("end%t", atEnd), func(t *testing.T) {
+			sourceBytes, readOnly := intraDCGuardedBuffer(t, 241*2, atEnd)
+			source := (*[241]int16)(unsafe.Pointer(&sourceBytes[0]))
+			for i := range source {
+				source[i] = int16(i*1701 - 32768)
+			}
+			before := *source
+			readOnly()
+			dcBytes, _ := intraDCGuardedBuffer(t, 32, atEnd)
+			dc := (*[16]int16)(unsafe.Pointer(&dcBytes[0]))
+			var wantDc [16]int16
+			WelsHadamardT4Dc_c(wantDc[:], before[:])
+			hadamardT4DcSSE2(dc, source)
+			if *dc != wantDc || *source != before {
+				t.Fatal("guarded forward output differs or input changed")
+			}
+			for _, mf := range []uint16{0, 1, 32768, 65535} {
+				*dc = [16]int16{-32768, 32767, -1, 1, 16384, -16385, 8191, -8192, 32766, -32767, 3, -5, 7, -11, 13, -17}
+				want := *dc
+				WelsDequantIHadamard4x4_c(want[:], mf)
+				dequantIHadamard4x4SSE2(dc, uint64(mf))
+				if *dc != want {
+					t.Fatalf("guarded inverse mf%d differs", mf)
+				}
+			}
+		})
+	}
+}
diff --git a/pkg/h264/internal/encoder/intra_dc_simd_amd64.go b/pkg/h264/internal/encoder/intra_dc_simd_amd64.go
new file mode 100644
index 0000000..619ffa3
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_dc_simd_amd64.go
@@ -0,0 +1,28 @@
+//go:build amd64
+
+package encoder
+
+//go:noescape
+func hadamardT4DcSSE2(dc *[16]int16, residual *[241]int16)
+
+//go:noescape
+func dequantIHadamard4x4SSE2(residual *[16]int16, mf uint64)
+
+func hadamardT4Dc(dc, residual []int16) {
+	// The scalar routine gathers every DC before its first output store, so
+	// overlapping input/output remains valid. Short slices retain its exact
+	// read/write and panic order, including partial column-ordered output.
+	if len(dc) < 16 || len(residual) < 241 {
+		WelsHadamardT4Dc_c(dc, residual)
+		return
+	}
+	hadamardT4DcSSE2((*[16]int16)(dc), (*[241]int16)(residual))
+}
+
+func dequantIHadamard4x4(residual []int16, mf uint16) {
+	if len(residual) < 16 {
+		WelsDequantIHadamard4x4_c(residual, mf)
+		return
+	}
+	dequantIHadamard4x4SSE2((*[16]int16)(residual), uint64(mf))
+}
diff --git a/pkg/h264/internal/encoder/intra_dc_simd_amd64.s b/pkg/h264/internal/encoder/intra_dc_simd_amd64.s
new file mode 100644
index 0000000..00bafec
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_dc_simd_amd64.s
@@ -0,0 +1,143 @@
+//go:build amd64
+
+// The widened forward DC and packed inverse/dequant Hadamard patterns follow
+// Cisco OpenH264 codec/encoder/core/x86/{dct,quant}.asm. The forward gather uses
+// exact word reads and both entries allow unaligned buffers.
+// Copyright (c) 2009-2013, Cisco Systems. All rights reserved.
+// BSD-2-Clause; see LICENSE-OpenH264 in the repository root.
+
+#include "textflag.h"
+
+// A column of spatial DCs, sign-extended from four exact int16 input loads.
+#define DC_COLUMN(OUT, A, B, C, D) \
+    PXOR OUT, OUT; \
+    PINSRW $0, A(SI), OUT; \
+    PINSRW $1, B(SI), OUT; \
+    PINSRW $2, C(SI), OUT; \
+    PINSRW $3, D(SI), OUT; \
+    PXOR X4, X4; \
+    PCMPGTW OUT, X4; \
+    PUNPCKLWL X4, OUT
+
+// Four independent transforms across X0..X3. Every forward intermediate is
+// int32, not a wrapping word: full signed input may exceed the native residual
+// range and must still round and saturate exactly like WelsHadamardT4Dc_c.
+#define DC_HADAMARD_D \
+    MOVOU X0, X4; \
+    PADDL X3, X4; \
+    MOVOU X0, X5; \
+    PSUBL X3, X5; \
+    MOVOU X1, X6; \
+    PADDL X2, X6; \
+    MOVOU X1, X7; \
+    PSUBL X2, X7; \
+    MOVOU X4, X0; \
+    PADDL X6, X0; \
+    MOVOU X4, X2; \
+    PSUBL X6, X2; \
+    MOVOU X5, X1; \
+    PADDL X7, X1; \
+    MOVOU X5, X3; \
+    PSUBL X7, X3
+
+#define DC_TRANSPOSE_D \
+    MOVOU X0, X4; \
+    PUNPCKLLQ X1, X0; \
+    PUNPCKHLQ X1, X4; \
+    MOVOU X2, X5; \
+    PUNPCKLLQ X3, X2; \
+    PUNPCKHLQ X3, X5; \
+    MOVOU X0, X1; \
+    PUNPCKLQDQ X2, X0; \
+    PUNPCKHQDQ X2, X1; \
+    MOVOU X4, X3; \
+    PUNPCKLQDQ X5, X4; \
+    PUNPCKHQDQ X5, X3; \
+    MOVOU X4, X2
+
+TEXT ·hadamardT4DcSSE2(SB), NOSPLIT, $0-16
+    MOVQ dc+0(FP), DI
+    MOVQ residual+8(FP), SI
+    // Spatial columns in the encoder's grouped 4x4 coefficient layout.
+    DC_COLUMN(X0, 0, 64, 256, 320)
+    DC_COLUMN(X1, 32, 96, 288, 352)
+    DC_COLUMN(X2, 128, 192, 384, 448)
+    DC_COLUMN(X3, 160, 224, 416, 480)
+    DC_HADAMARD_D
+    DC_TRANSPOSE_D
+    DC_HADAMARD_D
+    PCMPEQL X4, X4
+    PSRLL $31, X4
+    PADDL X4, X0
+    PADDL X4, X1
+    PADDL X4, X2
+    PADDL X4, X3
+    PSRAL $1, X0
+    PSRAL $1, X1
+    PSRAL $1, X2
+    PSRAL $1, X3
+    PACKSSLW X1, X0
+    PACKSSLW X3, X2
+    MOVOU X0, (DI)
+    MOVOU X2, 16(DI)
+    RET
+
+// Every addition/subtraction and final product is observed modulo 2^16 by
+// the scalar inverse/dequant routine. Multiplication commutes with the two
+// linear Hadamard stages, including uint16 multipliers above MaxInt16.
+#define DC_HADAMARD_W \
+    MOVOU X0, X4; \
+    PADDW X3, X4; \
+    MOVOU X0, X5; \
+    PSUBW X3, X5; \
+    MOVOU X1, X6; \
+    PADDW X2, X6; \
+    MOVOU X1, X7; \
+    PSUBW X2, X7; \
+    MOVOU X4, X0; \
+    PADDW X6, X0; \
+    MOVOU X4, X2; \
+    PSUBW X6, X2; \
+    MOVOU X5, X1; \
+    PADDW X7, X1; \
+    MOVOU X5, X3; \
+    PSUBW X7, X3
+
+// Transpose the low four words of X0..X3 into their low four output words.
+#define DC_TRANSPOSE_W \
+    MOVOU X0, X4; \
+    PUNPCKLWL X1, X4; \
+    MOVOU X2, X5; \
+    PUNPCKLWL X3, X5; \
+    MOVOU X4, X0; \
+    PUNPCKLLQ X5, X0; \
+    PUNPCKHLQ X5, X4; \
+    MOVOU X0, X1; \
+    PSRLDQ $8, X1; \
+    MOVOU X4, X2; \
+    MOVOU X4, X3; \
+    PSRLDQ $8, X3
+
+TEXT ·dequantIHadamard4x4SSE2(SB), NOSPLIT, $0-16
+    MOVQ residual+0(FP), DI
+    MOVQ mf+8(FP), AX
+    MOVL AX, X8
+    PSHUFLW $0, X8, X8
+    PSHUFD $0, X8, X8
+    MOVOU (DI), X0
+    MOVOU 16(DI), X2
+    PMULLW X8, X0
+    PMULLW X8, X2
+    MOVOU X0, X1
+    PSRLDQ $8, X1
+    MOVOU X2, X3
+    PSRLDQ $8, X3
+    DC_HADAMARD_W
+    DC_TRANSPOSE_W
+    DC_HADAMARD_W
+    DC_TRANSPOSE_W
+    PUNPCKLQDQ X1, X0
+    PUNPCKLQDQ X3, X2
+    MOVOU X0, (DI)
+    MOVOU X2, 16(DI)
+    RET
diff --git a/pkg/h264/internal/encoder/intra_dc_simd_amd64_test.go b/pkg/h264/internal/encoder/intra_dc_simd_amd64_test.go
new file mode 100644
index 0000000..6c6a7c4
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_dc_simd_amd64_test.go
@@ -0,0 +1,50 @@
+//go:build amd64
+
+package encoder
+
+import "testing"
+
+func TestIntraDCRawCoefficientDomain(t *testing.T) {
+	for value := -32768; value <= 32767; value++ {
+		// Vary the active position across the full-domain sweep; separate
+		// impulses below exercise every position at all overflow boundaries.
+		position := value & 15
+		var source [241]int16
+		source[intraDCDcOffsets[position]] = int16(value)
+		var gotDc, wantDc [16]int16
+		hadamardT4DcSSE2(&gotDc, &source)
+		WelsHadamardT4Dc_c(wantDc[:], source[:])
+		if gotDc != wantDc {
+			t.Fatalf("raw forward value%d pos%d: %v want%v", value, position, gotDc, wantDc)
+		}
+		var got, want [16]int16
+		got[position], want[position] = int16(value), int16(value)
+		mf := uint16(value*73 + 193)
+		dequantIHadamard4x4SSE2(&got, uint64(mf))
+		WelsDequantIHadamard4x4_c(want[:], mf)
+		if got != want {
+			t.Fatalf("raw inverse value%d pos%d mf%d: %v want%v", value, position, mf, got, want)
+		}
+	}
+	for position := range 16 {
+		for _, value := range []int16{-32768, -32767, -16384, -1, 0, 1, 16384, 32767} {
+			var source [241]int16
+			source[intraDCDcOffsets[position]] = value
+			var gotDc, wantDc [16]int16
+			hadamardT4DcSSE2(&gotDc, &source)
+			WelsHadamardT4Dc_c(wantDc[:], source[:])
+			if gotDc != wantDc {
+				t.Fatalf("raw forward impulse value%d pos%d: %v want%v", value, position, gotDc, wantDc)
+			}
+			for _, mf := range []uint16{0, 1, 2, 32767, 32768, 65535} {
+				var got, want [16]int16
+				got[position], want[position] = value, value
+				dequantIHadamard4x4SSE2(&got, uint64(mf))
+				WelsDequantIHadamard4x4_c(want[:], mf)
+				if got != want {
+					t.Fatalf("raw inverse impulse value%d pos%d mf%d: %v want%v", value, position, mf, got, want)
+				}
+			}
+		}
+	}
+}
