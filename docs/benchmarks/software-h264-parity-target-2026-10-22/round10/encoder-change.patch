@@ -0,0 +1,62 @@
+package encoder
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+var hadamardChromaBenchmarkSink uint8
+
+// Baseline-compatible production entry: DC quantization, AC quantize/scan,
+// coefficient decisions, dequantization, and reconstructed DC for both planes.
+func BenchmarkChromaCoefficientEncoding(b *testing.B) {
+	for _, qp := range []uint8{20, 32} {
+		for _, intra := range []bool{false, true} {
+			for _, content := range []string{"Dense", "Motion", "Sparse", "Zero"} {
+				b.Run(fmt.Sprintf("QP%d/intra=%t/%s", qp, intra, content), func(b *testing.B) {
+					var input, residual [128]int16
+					for i := range input {
+						value := int16((i*1701+13)%2049 - 1024)
+						switch content {
+						case "Motion":
+							if i%7 >= 3 {
+								value = 0
+							}
+						case "Sparse":
+							if i%17 != 0 {
+								value = 0
+							}
+							value /= 8
+						case "Zero":
+							value = 0
+						}
+						input[i] = value
+					}
+					var functions SWelsFuncPtrList
+					flags := common.WelsCPUFeatureDetect(nil)
+					WelsInitEncodingFuncs(&functions, flags)
+					WelsInitReconstructionFuncs(&functions, flags)
+					functions.pfSetMemZeroSize64 = WelsSetMemZero_c
+					var dct SDCTCoeff
+					var nonzero [24]int8
+					mb := SMB{uiMbType: common.MB_TYPE_16x16, uiChromaQp: qp, pNonZeroCount: nonzero[:]}
+					if intra {
+						mb.uiMbType = common.MB_TYPE_INTRA16x16
+					}
+					cache := SMbCache{pCoeffLevel: residual[:], pDct: &dct}
+					b.ReportAllocs()
+					for b.Loop() {
+						residual = input
+						mb.uiCbp = 0
+						WelsEncRecUV(&functions, &mb, &cache, residual[:64], 1)
+						WelsEncRecUV(&functions, &mb, &cache, residual[64:], 2)
+					}
+					hadamardChromaBenchmarkSink = mb.uiCbp
+					b.ReportMetric(2, "planes/op")
+				})
+			}
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/hadamard_quant_amd64.go b/pkg/h264/internal/encoder/hadamard_quant_amd64.go
new file mode 100644
index 0000000..411b835
--- /dev/null
+++ b/pkg/h264/internal/encoder/hadamard_quant_amd64.go
@@ -0,0 +1,16 @@
+//go:build amd64
+
+package encoder
+
+//go:noescape
+func hadamardQuant2x2SSE2(rs *[49]int16, ff, mf int64, dct, block *[4]int16) int32
+
+func hadamardQuant2x2(rs []int16, ff, mf int16, dct, block []int16) int32 {
+	// The packed unsigned arithmetic matches the scalar quantizer throughout
+	// its nonnegative FF/MF domain. Retain signed-parameter behavior and the
+	// original partial writes/panic order for short input or output slices.
+	if len(rs) < 49 || len(dct) < 4 || len(block) < 4 || ff < 0 || mf < 0 {
+		return WelsHadamardQuant2x2_c(rs, ff, mf, dct, block)
+	}
+	return hadamardQuant2x2SSE2((*[49]int16)(rs), int64(ff), int64(mf), (*[4]int16)(dct), (*[4]int16)(block))
+}
diff --git a/pkg/h264/internal/encoder/hadamard_quant_amd64.s b/pkg/h264/internal/encoder/hadamard_quant_amd64.s
new file mode 100644
index 0000000..200ff49
--- /dev/null
+++ b/pkg/h264/internal/encoder/hadamard_quant_amd64.s
@@ -0,0 +1,74 @@
+//go:build amd64
+
+// The fused Hadamard/quantization pattern follows Cisco OpenH264,
+// codec/encoder/core/x86/quant.asm (WelsHadamardQuant2x2_mmx).
+// Copyright (c) 2009-2013, Cisco Systems.
+// BSD-2-Clause; see LICENSE-OpenH264 in the repository root.
+
+#include "textflag.h"
+
+// Gather only the four DC words, including when rs has exactly 49 words.
+// Both Hadamard stages wrap in int16. All inputs are captured before clears;
+// outputs follow the scalar order: clear residual DC, write dct, copy to block.
+// Keeping the completed vector in a register makes the copy overlap-safe.
+// func hadamardQuant2x2SSE2(rs *[49]int16, ff, mf int64, dct, block *[4]int16) int32
+TEXT ·hadamardQuant2x2SSE2(SB), NOSPLIT, $0-44
+	MOVQ rs+0(FP), AX
+	MOVQ dct+24(FP), BX
+	MOVQ block+32(FP), CX
+	PXOR X0, X0
+	PINSRW $0, (AX), X0
+	PINSRW $1, 32(AX), X0
+	PINSRW $2, 64(AX), X0
+	PINSRW $3, 96(AX), X0
+
+	// [a,b,c,d] -> [a+c,b+d,a-c,b-d].
+	PSHUFLW $0x4e, X0, X1
+	MOVOU X0, X2
+	PADDW X1, X2
+	PSUBW X1, X0
+	PUNPCKLLQ X0, X2
+	// [s0,s2,s1,s3] -> [s0+s2,s0-s2,s1+s3,s1-s3].
+	PSHUFLW $0xb1, X2, X1
+	MOVOU X2, X0
+	PADDW X1, X0
+	PSUBW X1, X2
+	PUNPCKLWL X2, X0
+	PSHUFD $0x88, X0, X0
+
+	MOVQ ff+8(FP), DX
+	MOVD DX, X4
+	PSHUFLW $0, X4, X4
+	PSHUFD $0, X4, X4
+	MOVQ mf+16(FP), DX
+	MOVD DX, X5
+	PSHUFLW $0, X5, X5
+	PSHUFD $0, X5, X5
+	PXOR X3, X3
+	PCMPGTW X0, X3
+	PXOR X3, X0
+	PSUBW X3, X0
+	PADDUSW X4, X0
+	PMULHUW X5, X0
+	PXOR X3, X0
+	PSUBW X3, X0
+
+	MOVW $0, (AX)
+	MOVW $0, 32(AX)
+	MOVW $0, 64(AX)
+	MOVW $0, 96(AX)
+	MOVQ X0, (BX)
+	MOVQ X0, (CX)
+
+	// Saturating byte packing preserves zero/nonzero. Zero the unused words
+	// first, since quantizing a zero input can produce a nonzero rounded value.
+	MOVQ X0, X0
+	PXOR X1, X1
+	PACKSSWB X1, X0
+	PCMPEQB X1, X0
+	PCMPEQB X2, X2
+	PSUBSB X2, X0
+	PSADBW X1, X0
+	MOVD X0, DX
+	MOVL DX, ret+40(FP)
+	RET
diff --git a/pkg/h264/internal/encoder/hadamard_quant_bench_test.go b/pkg/h264/internal/encoder/hadamard_quant_bench_test.go
