+// sampleSadBlockPointer checks the complete visible block span before returning
+// its first tracked pointer. The private SAD kernels do not consume a slice,
+// so no intermediate slice length/capacity needs to be constructed or checked.
+func sampleSadBlockPointer(buf []byte, off int, stride int32, width, height int) *byte {
+	if stride < 0 {
