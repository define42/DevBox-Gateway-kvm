@@ -0,0 +1,73 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+// BenchmarkSampleSatdWrapperDispatch measures the actual encoder callbacks.
+// The unchanged generic helper and 4x4 dispatch are code-layout/noise controls.
+// This file can be copied unchanged to the baseline tree.
+func BenchmarkSampleSatdWrapperDispatch(b *testing.B) {
+	flags := common.WelsCPUFeatureDetect(nil)
+	required := uint32(common.WELS_CPU_AVX2 | common.WELS_CPU_SSSE3 | common.WELS_CPU_SSE41)
+	if flags&required != required {
+		b.Skip("AVX2, SSSE3 and SSE4.1 required")
+	}
+	var funcs SWelsFuncPtrList
+	WelsInitSampleSadFunc(&funcs, flags)
+	for _, shape := range []struct {
+		width, height, block int
+	}{
+		{8, 8, BLOCK_8x8}, {16, 8, BLOCK_16x8},
+		{8, 16, BLOCK_8x16}, {16, 16, BLOCK_16x16},
+		{4, 4, BLOCK_4x4},
+	} {
+		for _, magnitude := range []int{32, 1984} {
+			for _, negative := range []bool{false, true} {
+				if shape.width == 4 && negative {
+					continue // The unchanged SSE4.1 4x4 entry rejects negative strides.
+				}
+				stride, offset := int32(magnitude), 7
+				direction := "positive"
+				if negative {
+					stride = -stride
+					offset += (shape.height - 1) * magnitude
+					direction = "negative"
+				}
+				for _, generic := range []bool{false, true} {
+					if shape.width == 4 && generic {
+						continue
+					}
+					kind := "dispatch"
+					fn := funcs.sSampleDealingFuncs.pfSampleSatd[shape.block]
+					if shape.width == 4 {
+						kind = "dispatchControl"
+					} else if generic {
+						kind = "genericControl"
+						fn = func(a []byte, aOff int, aStride int32, ref []byte, refOff int, refStride int32) int32 {
+							return sampleSatdBlockAVX2(a, aOff, aStride, ref, refOff, refStride, shape.width, shape.height)
+						}
+					}
+					b.Run(fmt.Sprintf("%dx%d/stride%d/%s/%s", shape.width, shape.height, magnitude, direction, kind), func(b *testing.B) {
+						span := 7 + (shape.height-1)*magnitude + shape.width
+						a, ref := make([]byte, span), make([]byte, span)
+						for i := range a {
+							a[i], ref[i] = byte(i*17+5), byte(i*29+3)
+						}
+						var cost int32
+						b.ReportAllocs()
+						for b.Loop() {
+							cost = fn(a, offset, stride, ref, offset, stride)
+						}
+						sampleSatdBenchmarkSink = cost
+					})
+				}
+			}
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/sample_satd_wrapper_guard_linux_amd64_test.go b/pkg/h264/internal/encoder/sample_satd_wrapper_guard_linux_amd64_test.go
new file mode 100644
index 0000000..e876770
--- /dev/null
+++ b/pkg/h264/internal/encoder/sample_satd_wrapper_guard_linux_amd64_test.go
@@ -0,0 +1,75 @@
+//go:build linux && amd64
+
+package encoder
+
+import (
+	"fmt"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+// Guard each row separately on both sides. Moving the row to either end of
+// its read-only page detects horizontal overreads and accidental writes.
+func sampleSatdWrapperGuardedRows(t *testing.T, width, height, seed int, atEnd bool) ([]byte, int32) {
+	t.Helper()
+	page := unix.Getpagesize()
+	mapping, err := unix.Mmap(-1, 0, height*3*page, unix.PROT_READ|unix.PROT_WRITE, unix.MAP_ANON|unix.MAP_PRIVATE)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := unix.Munmap(mapping); err != nil {
+			t.Error(err)
+		}
+	})
+	start := page
+	if atEnd {
+		start += page - width
+	}
+	for y := range height {
+		base := y * 3 * page
+		for x := range width {
+			mapping[base+start+x] = byte(y*31 + x*17 + seed)
+		}
+		if err := unix.Mprotect(mapping[base:base+page], unix.PROT_NONE); err != nil {
+			t.Fatal(err)
+		}
+		if err := unix.Mprotect(mapping[base+page:base+2*page], unix.PROT_READ); err != nil {
+			t.Fatal(err)
+		}
+		if err := unix.Mprotect(mapping[base+2*page:base+3*page], unix.PROT_NONE); err != nil {
+			t.Fatal(err)
+		}
+	}
+	end := (height-1)*3*page + start + width
+	return mapping[start:end:end], int32(3 * page)
+}
+
+func TestSampleSatdWrapperGuardPages(t *testing.T) {
+	requireSampleAVX2(t)
+	for _, tc := range sampleSatdWrapperCases() {
+		for _, atEnd := range []bool{false, true} {
+			for _, reverse := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%dx%d/end%v/reverse%v", tc.width, tc.height, atEnd, reverse), func(t *testing.T) {
+					a, stride := sampleSatdWrapperGuardedRows(t, tc.width, tc.height, 3, atEnd)
+					ref, _ := sampleSatdWrapperGuardedRows(t, tc.width, tc.height, 29, atEnd)
+					off := 0
+					if reverse {
+						off = (tc.height - 1) * int(stride)
+						stride = -stride
+					}
+					got := tc.fn(a, off, stride, ref, off, stride)
+					legacy := sampleSatdBlockAVX2(a, off, stride, ref, off, stride, tc.width, tc.height)
+					want := sampleSatdWrapperScalar(a, off, stride, ref, off, stride, tc.width, tc.height)
+					if got != want || got != legacy {
+						t.Fatalf("got=%d legacy=%d scalar=%d", got, legacy, want)
+					}
+					if got := tc.fn(a, off, stride, a, off, stride); got != 0 {
+						t.Fatalf("identical planes: got=%d", got)
+					}
+				})
+			}
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/skip_dct_quant_amd64.go b/pkg/h264/internal/encoder/skip_dct_quant_amd64.go
new file mode 100644
index 0000000..c7f1d10
--- /dev/null
+++ b/pkg/h264/internal/encoder/skip_dct_quant_amd64.go
@@ -0,0 +1,77 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"reflect"
+	"unsafe"
+
+	"golang.org/x/sys/cpu"
+)
+
+// The exact builtin check preserves instrumentation and callbacks that replace
+// a transform after normal initialization. A wrapper around the builtin must
+// still run. The reflection check occurs once per lazy 16x16 skip attempt.
+var skipDctQuantBuiltinPC = reflect.ValueOf(WelsDctFourT4_sse2).Pointer()
+
+// The caller validates exact spans and requires coefficient output to be
+// disjoint from both pixel inputs and FF/MF; maxima is private stack scratch.
+//
+//go:noescape
+func skipDctQuant8x8AVX2(dct *[64]int16, pixel1 *byte, stride1 int,
+	pixel2 *byte, stride2 int, ff, mf *[8]int16, maxima *[4]int16)
+
+// trySkipDctQuantPixels fuses only the built-in lazy skip path. The complete
+// preflight does not write or panic: unusual inputs retain the original
+// per-group checks, callback order, partial writes and early rejection. No
+// future group is transformed before its predecessor has passed the skip test.
+func trySkipDctQuantPixels(ctx *sWelsEncCtx, cache *SMbCache, source []byte,
+	sourceOffset int, stride int32, qp uint8) (handled, accepted bool) {
+	if !cpu.X86.HasAVX2 || ctx.pFuncList == nil || reflect.ValueOf(ctx.pFuncList.pfDctFourT4).Pointer() != skipDctQuantBuiltinPC {
+		return false, false
+	}
+	if qp >= 52 || cache.pDct == nil || len(cache.pCoeffLevel) < 256 || len(cache.pSkipMb) < 256 ||
+		stride < 0 || sourceOffset < 0 || sourceOffset > len(source) || len(source)-sourceOffset < 16 ||
+		int64(stride)*15 > int64(len(source)-sourceOffset-16) {
+		return false, false
+	}
+	coefficients := cache.pCoeffLevel
+	prediction := cache.pSkipMb
+	ff, mf := &g_kiQuantInterFF[qp], &g_kiQuantMF[qp]
+	dctStart := unsafe.Pointer(&coefficients[0])
+	// The existing DCT snapshots all pixels only on its disjoint AVX2 path.
+	// FF/MF must also be disjoint from the DCT output: the old sequence loads
+	// them after the transform has written its unquantized coefficients.
+	if quantScanRangesOverlap(dctStart, 512, unsafe.Pointer(&source[sourceOffset]), uintptr(stride)*15+16) ||
+		quantScanRangesOverlap(dctStart, 512, unsafe.Pointer(&prediction[0]), 256) ||
+		quantScanRangesOverlap(dctStart, 512, unsafe.Pointer(ff), 16) ||
+		quantScanRangesOverlap(dctStart, 512, unsafe.Pointer(mf), 16) {
+		return false, false
+	}
+	var score int32
+	var maximum [4]int16
+	for group := 0; group < 4; group++ {
+		x, y := (group&1)*8, (group>>1)*8
+		offset := group * 64
+		// Keep each group's scan after its complete quantization, including
+		// zero-max blocks whose scanned scratch must remain untouched.
+		levels := cache.pDct.iLumaBlock[offset:]
+		skipDctQuant8x8AVX2((*[64]int16)(coefficients[offset:]),
+			&source[sourceOffset+y*int(stride)+x], int(stride),
+			&prediction[y*16+x], 16, ff, mf, &maximum)
+		for block, value := range maximum {
+			if uint16(value) > 1 {
+				return true, false
+			}
+			if value == 1 {
+				blockOffset := block * 16
+				mask := coefficientScanMask(levels[blockOffset:], coefficients[offset+blockOffset:], false)
+				score += coefficientScoreMask(mask)
+			}
+			if score >= 6 {
+				return true, false
+			}
+		}
+	}
+	return true, true
+}
diff --git a/pkg/h264/internal/encoder/skip_dct_quant_amd64.s b/pkg/h264/internal/encoder/skip_dct_quant_amd64.s
new file mode 100644
index 0000000..e363387
--- /dev/null
+++ b/pkg/h264/internal/encoder/skip_dct_quant_amd64.s
@@ -0,0 +1,202 @@
+// This forward transform follows OpenH264 2.6.0's AVX2 implementation in
+// codec/common/x86/dct.asm.
+// Copyright (c) 2009-2013, Cisco Systems.
+// All rights reserved.
+// BSD-2-Clause; see LICENSE-OpenH264 in the repository root.
+
+#include "textflag.h"
+
+DATA skipDctQuantShufflePixels<>+0(SB)/8, $0x8002800180038000
+DATA skipDctQuantShufflePixels<>+8(SB)/8, $0x8006800580078004
+GLOBL skipDctQuantShufflePixels<>(SB), RODATA|NOPTR, $16
+
+DATA skipDctQuantShufflePairs<>+0(SB)/8, $0x0504070601000302
+DATA skipDctQuantShufflePairs<>+8(SB)/8, $0x0d0c0f0e09080b0a
+GLOBL skipDctQuantShufflePairs<>(SB), RODATA|NOPTR, $16
+
+DATA skipDctQuantHorizontalSigns<>+0(SB)/8, $0xffff0001ffff0001
+DATA skipDctQuantHorizontalSigns<>+8(SB)/8, $0xffff0001ffff0001
+DATA skipDctQuantHorizontalSigns<>+16(SB)/8, $0xffff0001ffff0001
+DATA skipDctQuantHorizontalSigns<>+24(SB)/8, $0xffff0001ffff0001
+GLOBL skipDctQuantHorizontalSigns<>(SB), RODATA|NOPTR, $32
+
+DATA skipDctQuantHorizontalFactors<>+0(SB)/8, $0xfffeffff00020001
+DATA skipDctQuantHorizontalFactors<>+8(SB)/8, $0xfffeffff00020001
+DATA skipDctQuantHorizontalFactors<>+16(SB)/8, $0xfffeffff00020001
+DATA skipDctQuantHorizontalFactors<>+24(SB)/8, $0xfffeffff00020001
+GLOBL skipDctQuantHorizontalFactors<>(SB), RODATA|NOPTR, $32
+
+// func skipDctQuant8x8AVX2(dct *[64]int16, pixel1 *byte, stride1 int,
+//     pixel2 *byte, stride2 int, ff, mf *[8]int16, maxima *[4]int16)
+// Each 128-bit lane holds one horizontal pair; the upper lanes hold the
+// bottom pair. Eight-byte loads touch exactly the validated pixel columns.
+TEXT ·skipDctQuant8x8AVX2(SB), NOSPLIT, $0-64
+	MOVQ dct+0(FP), AX
+	MOVQ pixel1+8(FP), BX
+	MOVQ stride1+16(FP), CX
+	MOVQ pixel2+24(FP), DX
+	MOVQ stride2+32(FP), SI
+	VBROADCASTI128 skipDctQuantShufflePixels<>(SB), Y6
+
+	VMOVQ (BX), X0
+	VPBROADCASTQ (BX)(CX*4), Y4
+	VPBLENDD $0xf0, Y4, Y0, Y0
+	VPSHUFB Y6, Y0, Y0
+	VMOVQ (DX), X4
+	VPBROADCASTQ (DX)(SI*4), Y5
+	VPBLENDD $0xf0, Y5, Y4, Y4
+	VPSHUFB Y6, Y4, Y4
+	VPSUBW Y4, Y0, Y0
+	ADDQ CX, BX
+	ADDQ SI, DX
+	VMOVQ (BX), X1
+	VPBROADCASTQ (BX)(CX*4), Y4
+	VPBLENDD $0xf0, Y4, Y1, Y1
+	VPSHUFB Y6, Y1, Y1
+	VMOVQ (DX), X4
+	VPBROADCASTQ (DX)(SI*4), Y5
+	VPBLENDD $0xf0, Y5, Y4, Y4
+	VPSHUFB Y6, Y4, Y4
+	VPSUBW Y4, Y1, Y1
+	ADDQ CX, BX
+	ADDQ SI, DX
+	VMOVQ (BX), X2
+	VPBROADCASTQ (BX)(CX*4), Y4
+	VPBLENDD $0xf0, Y4, Y2, Y2
+	VPSHUFB Y6, Y2, Y2
+	VMOVQ (DX), X4
+	VPBROADCASTQ (DX)(SI*4), Y5
+	VPBLENDD $0xf0, Y5, Y4, Y4
+	VPSHUFB Y6, Y4, Y4
+	VPSUBW Y4, Y2, Y2
+	ADDQ CX, BX
+	ADDQ SI, DX
+	VMOVQ (BX), X3
+	VPBROADCASTQ (BX)(CX*4), Y4
+	VPBLENDD $0xf0, Y4, Y3, Y3
+	VPSHUFB Y6, Y3, Y3
+	VMOVQ (DX), X4
+	VPBROADCASTQ (DX)(SI*4), Y5
+	VPBLENDD $0xf0, Y5, Y4, Y4
+	VPSHUFB Y6, Y4, Y4
+	VPSUBW Y4, Y3, Y3
+
+	// Vertical 4-point transform of all four blocks together.
+	VPSUBW Y3, Y0, Y5
+	VPADDW Y3, Y0, Y0
+	VPSUBW Y2, Y1, Y3
+	VPADDW Y2, Y1, Y1
+	VPSUBW Y1, Y0, Y2
+	VPADDW Y1, Y0, Y0
+	VPSLLW $1, Y5, Y1
+	VPADDW Y3, Y1, Y1
+	VPSLLW $1, Y3, Y3
+	VPSUBW Y3, Y5, Y3
+
+	// The byte shuffle loaded each row as [x0,x3,x1,x2], allowing each
+	// horizontal transform to use signs, a word multiply and two shuffles.
+	VBROADCASTI128 skipDctQuantShufflePairs<>(SB), Y6
+	VPSIGNW skipDctQuantHorizontalSigns<>(SB), Y0, Y5
+	VPSHUFB Y6, Y0, Y0
+	VPADDW Y5, Y0, Y0
+	VPMULLW skipDctQuantHorizontalFactors<>(SB), Y0, Y5
+	VPSHUFD $0xb1, Y0, Y0
+	VPADDW Y5, Y0, Y0
+	VPSIGNW skipDctQuantHorizontalSigns<>(SB), Y1, Y5
+	VPSHUFB Y6, Y1, Y1
+	VPADDW Y5, Y1, Y1
+	VPMULLW skipDctQuantHorizontalFactors<>(SB), Y1, Y5
+	VPSHUFD $0xb1, Y1, Y1
+	VPADDW Y5, Y1, Y1
+	VPSIGNW skipDctQuantHorizontalSigns<>(SB), Y2, Y5
+	VPSHUFB Y6, Y2, Y2
+	VPADDW Y5, Y2, Y2
+	VPMULLW skipDctQuantHorizontalFactors<>(SB), Y2, Y5
+	VPSHUFD $0xb1, Y2, Y2
+	VPADDW Y5, Y2, Y2
+	VPSIGNW skipDctQuantHorizontalSigns<>(SB), Y3, Y5
+	VPSHUFB Y6, Y3, Y3
+	VPADDW Y5, Y3, Y3
+	VPMULLW skipDctQuantHorizontalFactors<>(SB), Y3, Y5
+	VPSHUFD $0xb1, Y3, Y3
+	VPADDW Y5, Y3, Y3
+
+	// Keep each block's first/last eight coefficients in the corresponding
+	// 128-bit lane. Upper lanes are the bottom pair of blocks.
+	VPUNPCKLQDQ Y1, Y0, Y4
+	VPUNPCKHQDQ Y1, Y0, Y5
+	VPUNPCKLQDQ Y3, Y2, Y6
+	VPUNPCKHQDQ Y3, Y2, Y7
+	MOVQ ff+40(FP), BX
+	MOVQ mf+48(FP), CX
+	MOVQ maxima+56(FP), DI
+	VBROADCASTI128 (BX), Y8
+	VBROADCASTI128 (CX), Y9
+	VPXOR Y10, Y10, Y10
+	VPCMPEQW Y11, Y11, Y11
+	VPSRLW $1, Y11, Y11
+
+	// Match quantFour4x4MaxAVX2 for every FF/MF bit pattern: unsigned
+	// saturation/multiply, signed maxima clamped at zero, and positive
+	// sign for zero coefficients that rounding makes nonzero.
+	VPABSW Y4, Y0
+	VPOR Y11, Y4, Y4
+	VPADDUSW Y8, Y0, Y0
+	VPMULHUW Y9, Y0, Y0
+	VPSIGNW Y4, Y0, Y4
+	VPMAXSW Y10, Y0, Y12
+	VPABSW Y6, Y0
+	VPOR Y11, Y6, Y6
+	VPADDUSW Y8, Y0, Y0
+	VPMULHUW Y9, Y0, Y0
+	VPSIGNW Y6, Y0, Y6
+	VPMAXSW Y0, Y12, Y12
+
+	VPABSW Y5, Y0
+	VPOR Y11, Y5, Y5
+	VPADDUSW Y8, Y0, Y0
+	VPMULHUW Y9, Y0, Y0
+	VPSIGNW Y5, Y0, Y5
+	VPMAXSW Y10, Y0, Y13
+	VPABSW Y7, Y0
+	VPOR Y11, Y7, Y7
+	VPADDUSW Y8, Y0, Y0
+	VPMULHUW Y9, Y0, Y0
+	VPSIGNW Y7, Y0, Y7
+	VPMAXSW Y0, Y13, Y13
+
+	VMOVDQU X4, 0(AX)
+	VEXTRACTI128 $1, Y4, 64(AX)
+	VMOVDQU X5, 32(AX)
+	VEXTRACTI128 $1, Y5, 96(AX)
+	VMOVDQU X6, 16(AX)
+	VEXTRACTI128 $1, Y6, 80(AX)
+	VMOVDQU X7, 48(AX)
+	VEXTRACTI128 $1, Y7, 112(AX)
+
+	VPSRLDQ $8, Y12, Y0
+	VPMAXSW Y0, Y12, Y12
+	VPSRLDQ $4, Y12, Y0
+	VPMAXSW Y0, Y12, Y12
+	VPSRLDQ $2, Y12, Y0
+	VPMAXSW Y0, Y12, Y12
+	VPSRLDQ $8, Y13, Y0
+	VPMAXSW Y0, Y13, Y13
+	VPSRLDQ $4, Y13, Y0
+	VPMAXSW Y0, Y13, Y13
+	VPSRLDQ $2, Y13, Y0
+	VPMAXSW Y0, Y13, Y13
+	VPEXTRW $0, X12, R8
+	VPEXTRW $0, X13, R9
+	SHLL $16, R9
+	ORL R9, R8
+	MOVL R8, (DI)
+	VEXTRACTI128 $1, Y12, X0
+	VEXTRACTI128 $1, Y13, X1
+	VPEXTRW $0, X0, R8
+	VPEXTRW $0, X1, R9
+	SHLL $16, R9
+	ORL R9, R8
+	MOVL R8, 4(DI)
+	VZEROUPPER
+	RET
diff --git a/pkg/h264/internal/encoder/skip_dct_quant_amd64_test.go b/pkg/h264/internal/encoder/skip_dct_quant_amd64_test.go
new file mode 100644
index 0000000..2b91bd7
--- /dev/null
+++ b/pkg/h264/internal/encoder/skip_dct_quant_amd64_test.go
@@ -0,0 +1,173 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"fmt"
+	"math/rand/v2"
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/cpu"
+)
+
+func TestSkipDctQuantRawParameterDomain(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 unavailable")
+	}
+	rng := rand.New(rand.NewPCG(264, 864))
+	for fixture := 0; fixture < 8192; fixture++ {
+		stride1, stride2 := []int{0, 1, 8, 19, 127}[fixture%5], []int{0, 3, 8, 23, 128}[(fixture/5)%5]
+		p1, p2 := make([]byte, 3+7*stride1+8), make([]byte, 5+7*stride2+8)
+		for i := range p1 {
+			p1[i] = byte(rng.Uint32())
+		}
+		for i := range p2 {
+			p2[i] = byte(rng.Uint32())
+		}
+		if fixture%4 == 0 {
+			// Zero coefficients exercise the special positive sign rule.
+			for i := range p1 {
+				p1[i] = 128
+			}
+			for i := range p2 {
+				p2[i] = 128
+			}
+		} else if fixture%4 == 1 {
+			for i := range p1 {
+				p1[i] = 255
+			}
+			clear(p2)
+		} else if fixture%4 == 2 {
+			clear(p1)
+			for i := range p2 {
+				p2[i] = 255
+			}
+		}
+		var ff, mf [8]int16
+		for i := range ff {
+			// Every int16 bit pattern appears in both quantization tables.
+			ff[i], mf[i] = int16(fixture*8+i), int16(65535-fixture*8-i)
+		}
+		assertSkipDctQuantRaw(t, fixture, p1, 3, stride1, p2, 5, stride2, ff, mf)
+	}
+}
+
+func TestSkipDctQuantRawQPAndEdges(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 unavailable")
+	}
+	rng := rand.New(rand.NewPCG(264, 865))
+	edges := [...]int16{-32768, -32767, -1, 0, 1, 16383, 16384, 32766, 32767}
+	for fixture := 0; fixture < 52*16; fixture++ {
+		stride := []int{8, 32, 1984}[fixture%3]
+		p1, p2 := make([]byte, 7*stride+8), make([]byte, 7*stride+8)
+		for i := range p1 {
+			p1[i], p2[i] = byte(rng.Uint32()), byte(rng.Uint32())
+		}
+		ff, mf := g_kiQuantInterFF[fixture%52], g_kiQuantMF[fixture%52]
+		if fixture%3 == 0 {
+			for i := range ff {
+				ff[i], mf[i] = edges[(fixture+i)%len(edges)], edges[(fixture/3+i)%len(edges)]
+			}
+		}
+		assertSkipDctQuantRaw(t, fixture, p1, 0, stride, p2, 0, stride, ff, mf)
+	}
+}
+
+func assertSkipDctQuantRaw(t *testing.T, fixture int, p1 []byte, off1, stride1 int, p2 []byte, off2, stride2 int, ff, mf [8]int16) {
+	t.Helper()
+	var got, want [68]int16
+	var gotMax, wantMax [8]int16
+	for i := range got {
+		got[i], want[i] = -12345, -12345
+	}
+	for i := range gotMax {
+		gotMax[i], wantMax[i] = -23456, -23456
+	}
+	beforeFF, beforeMF := ff, mf
+	// Independent scalar transform plus the historical SSE2 quantizer also
+	// defines signed FF/MF behavior outside the scalar quantizer's domain.
+	WelsDctFourT4_c(want[1:65], p1, off1, int32(stride1), p2, off2, int32(stride2))
+	quantFour4x4MaxSSE2(want[1:65], ff[:], mf[:], wantMax[1:5])
+	skipDctQuant8x8AVX2((*[64]int16)(got[1:65]), &p1[off1], stride1, &p2[off2], stride2, &ff, &mf, (*[4]int16)(gotMax[1:5]))
+	if got != want || gotMax != wantMax || ff != beforeFF || mf != beforeMF {
+		t.Fatalf("fixture%d stride%d/%d: fused coefficients/maxima/tables/canaries differ", fixture, stride1, stride2)
+	}
+}
+
+func TestSkipDctQuantEligibility(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 unavailable")
+	}
+	for _, stride := range []int32{0, 1, 16, 32, 1984} {
+		s := newSkipDctQuantPixelsState(stride, 32, 0)
+		handled, accepted := trySkipDctQuantPixels(&s.ctx, &s.cache, s.source, s.cache.SPicData.iEncMbOff[0], stride, 32)
+		if !handled || !accepted {
+			t.Fatalf("stride%d: ordinary builtin path did not use fusion", stride)
+		}
+	}
+	for _, name := range []string{"custom", "scalar", "nil", "short", "negative", "QP52", "nil-levels", "FF-alias", "MF-alias"} {
+		t.Run(name, func(t *testing.T) {
+			s := newSkipDctQuantPixelsState(32, 32, 0)
+			qp := uint8(32)
+			switch name {
+			case "custom":
+				dct := s.functions.pfDctFourT4
+				s.functions.pfDctFourT4 = func(d []int16, a []byte, ao int, as int32, p []byte, po int, ps int32) { dct(d, a, ao, as, p, po, ps) }
+			case "scalar":
+				s.functions.pfDctFourT4 = WelsDctFourT4_c
+			case "nil":
+				s.functions.pfDctFourT4 = nil
+			case "short":
+				s.cache.pCoeffLevel = s.cache.pCoeffLevel[:255]
+			case "negative":
+				s.layer.iEncStride[0] = -32
+			case "QP52":
+				qp = 52
+			case "nil-levels":
+				s.cache.pDct = nil
+			case "FF-alias":
+				qp = 0
+				s.cache.pCoeffLevel = unsafe.Slice(&g_kiQuantInterFF[0][0], 256)
+			case "MF-alias":
+				qp = 0
+				s.cache.pCoeffLevel = unsafe.Slice(&g_kiQuantMF[0][0], 256)
+			}
+			beforeCoefficients, beforePrediction, beforeLevels := s.coefficients, s.prediction, s.levels
+			beforeFF, beforeMF := g_kiQuantInterFF, g_kiQuantMF
+			handled, accepted := trySkipDctQuantPixels(&s.ctx, &s.cache, s.source, s.cache.SPicData.iEncMbOff[0], s.layer.iEncStride[0], qp)
+			if handled || accepted || s.coefficients != beforeCoefficients || s.prediction != beforePrediction || s.levels != beforeLevels ||
+				g_kiQuantInterFF != beforeFF || g_kiQuantMF != beforeMF {
+				t.Fatal("ineligible input was consumed or modified")
+			}
+		})
+	}
+}
+
+// Raw-only numbers are diagnostic. The baseline-compatible complete callers
+// above decide whether identity/validation overhead is repaid in production.
+func BenchmarkSkipDctQuantRaw(b *testing.B) {
+	if !cpu.X86.HasAVX2 {
+		b.Skip("AVX2 unavailable")
+	}
+	for _, stride := range []int{32, 1984} {
+		b.Run(fmt.Sprintf("stride%d", stride), func(b *testing.B) {
+			p1, p2 := make([]byte, 7*stride+8), make([]byte, 7*16+8)
+			for i := range p1 {
+				p1[i] = byte(i*29 + 17)
+			}
+			for i := range p2 {
+				p2[i] = byte(i*13 + 71)
+			}
+			var dct [64]int16
+			var maximum [4]int16
+			ff, mf := g_kiQuantInterFF[32], g_kiQuantMF[32]
+			b.ReportAllocs()
+			for b.Loop() {
+				skipDctQuant8x8AVX2(&dct, &p1[0], stride, &p2[0], 16, &ff, &mf, &maximum)
+			}
+			dctBenchmarkSink = dct[0] + maximum[0]
+		})
+	}
+}
diff --git a/pkg/h264/internal/encoder/skip_dct_quant_bench_test.go b/pkg/h264/internal/encoder/skip_dct_quant_bench_test.go
new file mode 100644
index 0000000..dabab78
--- /dev/null
+++ b/pkg/h264/internal/encoder/skip_dct_quant_bench_test.go
@@ -0,0 +1,111 @@
+package encoder
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+type skipDctQuantPixelsState struct {
+	ctx          sWelsEncCtx
+	layer        SDqLayer
+	functions    SWelsFuncPtrList
+	mb           SMB
+	cache        SMbCache
+	coefficients [400]int16
+	prediction   [400]byte
+	levels       SDCTCoeff
+	source       []byte
+	alias        [1024]int16
+}
+
+func newSkipDctQuantPixelsState(stride int32, qp uint8, pattern int) *skipDctQuantPixelsState {
+	s := &skipDctQuantPixelsState{}
+	s.ctx.pFuncList, s.ctx.pCurDqLayer = &s.functions, &s.layer
+	s.layer.iEncStride[0], s.mb.uiLumaQp = stride, qp
+	WelsInitEncodingFuncs(&s.functions, common.WelsCPUFeatureDetect(nil))
+	s.cache.pCoeffLevel, s.cache.pSkipMb = s.coefficients[8:392], s.prediction[8:392]
+	s.cache.pDct = &s.levels
+	absStride := int(stride)
+	if absStride < 0 {
+		absStride = -absStride
+	}
+	s.source = make([]byte, 7+15*absStride+16+9)
+	for i := range s.source {
+		s.source[i] = 128
+	}
+	for i := range s.prediction {
+		s.prediction[i] = 128
+	}
+	for i := range s.coefficients {
+		s.coefficients[i] = int16(i*101 + 17)
+	}
+	for i := range s.levels.iLumaBlock {
+		s.levels.iLumaBlock[i] = int16(i*71 - 3001)
+	}
+	for i := range s.alias {
+		s.alias[i] = int16(i*1701 + 13)
+	}
+	offset := 7
+	if stride < 0 {
+		offset += 15 * absStride
+	}
+	s.cache.SPicData.pEncMb[0], s.cache.SPicData.iEncMbOff[0] = s.source, offset
+	for y := 0; y < 16; y++ {
+		for x := 0; x < 16; x++ {
+			v := byte(128)
+			switch {
+			case pattern >= 1 && pattern <= 4:
+				if (y/8)*2+x/8 == pattern-1 {
+					v = 255
+				}
+			case pattern == 5:
+				if (y*16+x)%53 == 0 {
+					v = 129
+				}
+			case pattern == 6:
+				v = byte(125 + (x*7+y*11)%7)
+			case pattern == 7:
+				v = byte((x*73 + y*151) & 255)
+			}
+			s.source[offset+y*int(stride)+x] = v
+		}
+	}
+	return s
+}
+
+var skipDctQuantPixelsBenchmarkSink bool
+
+// Baseline-compatible complete lazy caller: includes the function-identity
+// check, full-span preflight, transform, quantization, score and scan work.
+func BenchmarkSkipDctQuantPixels(b *testing.B) {
+	for _, stride := range []int32{32, 1984} {
+		for pattern, name := range []string{"Zero", "Reject0", "Reject1", "Reject2", "Reject3", "Sparse", "Dense", "FullRange", "WrappedZero"} {
+			b.Run(fmt.Sprintf("%s/stride%d", name, stride), func(b *testing.B) {
+				s := newSkipDctQuantPixelsState(stride, 32, pattern)
+				if name == "WrappedZero" {
+					dct := s.functions.pfDctFourT4
+					s.functions.pfDctFourT4 = func(d []int16, a []byte, ao int, as int32, c []byte, co int, cs int32) {
+						dct(d, a, ao, as, c, co, cs)
+					}
+				}
+				var got bool
+				b.ReportAllocs()
+				for b.Loop() {
+					got = welsTryPYskipPixels(&s.ctx, &s.mb, &s.cache)
+				}
+				skipDctQuantPixelsBenchmarkSink = got
+			})
+		}
+	}
+	b.Run("BackwardZero", func(b *testing.B) {
+		s := newSkipDctQuantPixelsState(-32, 32, 0)
+		var got bool
+		b.ReportAllocs()
+		for b.Loop() {
+			got = welsTryPYskipPixels(&s.ctx, &s.mb, &s.cache)
+		}
+		skipDctQuantPixelsBenchmarkSink = got
+	})
+}
diff --git a/pkg/h264/internal/encoder/skip_dct_quant_caller_bench_test.go b/pkg/h264/internal/encoder/skip_dct_quant_caller_bench_test.go
new file mode 100644
index 0000000..1feb9f5
--- /dev/null
+++ b/pkg/h264/internal/encoder/skip_dct_quant_caller_bench_test.go
@@ -0,0 +1,147 @@
+package encoder
+
+import (
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+const skipDctQuantCallerStride = 64
+const skipDctQuantCallerOrigin = 20*skipDctQuantCallerStride + 20
+
+type skipDctQuantCallerState struct {
+	ctx          sWelsEncCtx
+	layer        SDqLayer
+	functions    SWelsFuncPtrList
+	alternate    SWelsFuncPtrList
+	md           SWelsMD
+	blocks       [4]SMB
+	cache        SMbCache
+	refPic       SPicture
+	decPic       SPicture
+	enc          [3][4096]byte
+	ref          [3][4096]byte
+	prediction   [416]byte
+	coefficients [416]int16
+	levels       SDCTCoeff
+	alternateSad int32
+}
+
+// Production initialization keeps the fixture independent of SMB's field
+// representation, and the timed function is the existing entry in both trees.
+func newSkipDctQuantCallerState(scenario string, flags uint32, useSAD bool) *skipDctQuantCallerState {
+	s := &skipDctQuantCallerState{}
+	s.layer = SDqLayer{iMbWidth: 2, iMbHeight: 2, iEncStride: [3]int32{64, 64, 64},
+		pRefPic: &s.refPic, pDecPic: &s.decPic, sMbDataP: s.blocks[:]}
+	s.layer.sLayerInfo.pPpsP = &SWelsPPS{}
+	s.layer.sSliceEncCtx.iMbNumInFrame = 4
+	s.layer.sSliceEncCtx.pOverallMbMap = make([]uint16, 4)
+	s.refPic.iLineSize = [3]int32{64, 64, 64}
+	s.refPic.iPictureType = common.I_SLICE
+	s.refPic.pMbSkipSad = make([]int32, 4)
+	s.decPic.sMvList = make([]SMVUnitXY, 4)
+	s.ctx = sWelsEncCtx{pCurDqLayer: &s.layer, pFuncList: &s.functions,
+		pStrideTab: &SStrideTables{}, pMvUnitBlock4x4: make([]SMVUnitXY, 4*16),
+		pRefIndexBlock4x4: make([]int8, 4*4), pSadCostMb: make([]int32, 4),
+		pIntra4x4PredModeBlocks: make([]int8, 4*8), pNonZeroCountBlocks: make([]int8, 4*24)}
+	s.ctx.pStrideTab.pMbIndexX[0] = []int16{0, 1, 0, 1}
+	s.ctx.pStrideTab.pMbIndexY[0] = []int16{0, 0, 1, 1}
+	s.ctx.pStrideTab.pStrideEncBlockOffset[0] = make([]int32, 24)
+	InitMbInfo(&s.ctx, s.blocks[:], &s.layer, 0, 4)
+	mb := &s.blocks[1]
+	mb.uiLumaQp, mb.uiChromaQp, mb.uiCbp = 32, 32, 0x3f
+	mb.sP16x16Mv = SMVUnitXY{17, -19}
+	*mb.pSadCost = -37
+	for i := range mb.sMv {
+		mb.sMv[i] = SMVUnitXY{int16(i + 1), int16(-i - 1)}
+	}
+	for i := range mb.pRefIndex {
+		mb.pRefIndex[i] = 2
+	}
+	s.md = SWelsMD{bMdUsingSad: useSAD, iCostLuma: -71, iCostChroma: -73,
+		iCostSkipMb: -79, iSadPredSkip: 0}
+	s.alternateSad = -101
+	for plane := range 3 {
+		for i := range s.enc[plane] {
+			s.enc[plane][i], s.ref[plane][i] = 128, 128
+		}
+		s.cache.SPicData.pEncMb[plane] = s.enc[plane][:]
+		s.cache.SPicData.pRefMb[plane] = s.ref[plane][:]
+		s.cache.SPicData.iEncMbOff[plane] = skipDctQuantCallerOrigin
+		s.cache.SPicData.iRefMbOff[plane] = skipDctQuantCallerOrigin
+	}
+	for i := range s.prediction {
+		s.prediction[i] = 0xa5
+	}
+	for i := range s.coefficients {
+		s.coefficients[i] = int16(i*71 + 13)
+	}
+	for i := range s.levels.iLumaBlock {
+		s.levels.iLumaBlock[i] = int16(i*37 - 1701)
+	}
+	for i := range s.levels.iChromaBlock {
+		s.levels.iChromaBlock[i] = int16(i*19 - 701)
+	}
+	s.cache.pSkipMb = s.prediction[16:400]
+	s.cache.pCoeffLevel = s.coefficients[16:400]
+	s.cache.pDct = &s.levels
+	// Available zero-reference neighbors produce a zero skip predictor.
+	for i := range s.cache.sMvComponents.iRefIndexCache {
+		s.cache.sMvComponents.iRefIndexCache[i] = 0
+	}
+	if scenario != "Direct" {
+		s.enc[0][skipDctQuantCallerOrigin] = 129 // one nonzero SAD, quantized away at QP 32
+	}
+	switch scenario {
+	case "PredThreshold":
+		s.md.iSadPredSkip = 2
+	case "RefThreshold":
+		s.refPic.iPictureType = common.P_SLICE
+		s.refPic.pMbSkipSad[1] = 2
+		s.cache.uiRefMbType = common.MB_TYPE_SKIP
+	case "RejectLuma", "RejectU", "RejectV":
+		plane, size := 0, 16
+		if scenario == "RejectU" {
+			plane, size = 1, 8
+		} else if scenario == "RejectV" {
+			plane, size = 2, 8
+		}
+		for y := range size {
+			for x := range size {
+				s.enc[plane][skipDctQuantCallerOrigin+y*skipDctQuantCallerStride+x] = 255
+			}
+		}
+	}
+	WelsInitEncodingFuncs(&s.functions, flags)
+	WelsInitSampleSadFunc(&s.functions, flags)
+	common.InitMcFunc(&s.functions.sMcFuncs, flags)
+	s.functions.pfUpdateMbMv = UpdateMbMv_c
+	return s
+}
+
+var skipDctQuantCallerBenchmarkSink bool
+
+func BenchmarkSkipDctQuantCaller(b *testing.B) {
+	flags := common.WelsCPUFeatureDetect(nil)
+	for _, scenario := range []string{"Direct", "PredThreshold", "RefThreshold", "RejectLuma", "RejectU", "RejectV", "TransformSuccess"} {
+		for _, useSAD := range []bool{true, false} {
+			mode := "SAD"
+			if !useSAD {
+				mode = "SATD"
+			}
+			b.Run(scenario+"/"+mode, func(b *testing.B) {
+				s := newSkipDctQuantCallerState(scenario, flags, useSAD)
+				want := scenario != "RejectLuma" && scenario != "RejectU" && scenario != "RejectV"
+				if got := WelsMdPSkipEnc(&s.ctx, &s.md, &s.blocks[1], &s.cache); got != want {
+					b.Fatalf("fixture returned %v, want %v", got, want)
+				}
+				var got bool
+				b.ReportAllocs()
+				for b.Loop() {
+					got = WelsMdPSkipEnc(&s.ctx, &s.md, &s.blocks[1], &s.cache)
+				}
+				skipDctQuantCallerBenchmarkSink = got
+			})
+		}
+	}
+}
