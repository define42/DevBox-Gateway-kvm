@@ -0,0 +1,35 @@
+//go:build amd64
+
+package encoder
+
+// Each descriptor remains fully tracked by Go. The leaf assembly reads these
+// four 32-byte records but never modifies or retains their pointers.
+type sampleAvgSatdCandidate struct {
+	a, b             *byte
+	aStride, bStride int
+}
+
+//go:noescape
+func satdAvgFourAVX2(enc *byte, encStride int, candidates *[4]sampleAvgSatdCandidate,
+	width, height int, costs *[4]int32)
+
+// Only meRefineQuarPixelFused calls this entry, after validating all input and
+// output spans and excluding aliases that could alter sequential behavior.
+func sampleAvgSatdFourValidated(enc *byte, encStride int, params *SQuarRefineParams,
+	width, height int) (costs [4]int32) {
+	var candidates [4]sampleAvgSatdCandidate
+	for i := range candidates {
+		stride := params.iStrideA
+		if i >= 2 {
+			stride = params.iStrideB
+		}
+		candidates[i] = sampleAvgSatdCandidate{
+			a:       &params.pSrcA[i][params.iSrcAOff[i]],
+			b:       &params.pSrcB[i][params.iSrcBOff[i]],
+			aStride: ME_REFINE_BUF_STRIDE,
+			bStride: int(stride),
+		}
+	}
+	satdAvgFourAVX2(enc, encStride, &candidates, width, height, &costs)
+	return costs
+}
diff --git a/pkg/h264/internal/encoder/sample_quarter_four_amd64.s b/pkg/h264/internal/encoder/sample_quarter_four_amd64.s
new file mode 100644
index 0000000..75139c8
--- /dev/null
+++ b/pkg/h264/internal/encoder/sample_quarter_four_amd64.s
@@ -0,0 +1,252 @@
+//go:build amd64
+
+// The packed sum/difference SATD reduction follows OpenH264's AVX2
+// implementation in codec/common/x86/satd_sad.asm.
+// Copyright (c) 2009-2013, Cisco Systems. All rights reserved.
+// BSD-2-Clause; see LICENSE-OpenH264 in the repository root.
+
+#include "textflag.h"
+
+// Y8-Y11 retain the encoded horizontal pair sums/differences for one band.
+// Y12-Y15 retain four independent dword accumulators across all bands.
+// Y0-Y7 are scratch, so no source rows or transformed source pairs need to
+// be loaded again between candidates. All loads are exactly 8 or 16 bytes.
+#define FOUR_CANDIDATE(A, B, AS, BS) \
+    MOVQ A(R8), BX; \
+    MOVQ B(R8), SI; \
+    MOVQ AS(R8), DX; \
+    MOVQ BS(R8), DI; \
+    MOVQ R11, R12; \
+    IMULQ DX, R12; \
+    ADDQ R12, BX; \
+    MOVQ R11, R12; \
+    IMULQ DI, R12; \
+    ADDQ R12, SI
+
+#define FOUR_ENC16(Y) \
+    VBROADCASTI128 (AX), Y; \
+    VPMADDUBSW ·satdPairSigns(SB), Y, Y; \
+    ADDQ CX, AX
+
+#define FOUR_ROW16(ENC, OUT) \
+    VBROADCASTI128 (BX), OUT; \
+    VBROADCASTI128 (SI), Y4; \
+    VPAVGB Y4, OUT, OUT; \
+    VPMADDUBSW ·satdPairSigns(SB), OUT, OUT; \
+    VPSUBW OUT, ENC, OUT; \
+    ADDQ DX, BX; \
+    ADDQ DI, SI
+
+// Rows y and y+4 occupy independent lanes; each eight-byte row is
+// duplicated inside its lane to produce both horizontal sums/differences.
+#define FOUR_ENC8(Y) \
+    VPBROADCASTQ (AX), Y; \
+    VPBROADCASTQ (AX)(CX*4), Y4; \
+    VPBLENDD $0xf0, Y4, Y, Y; \
+    VPMADDUBSW ·satdPairSigns8(SB), Y, Y; \
+    ADDQ CX, AX
+
+#define FOUR_ROW8(ENC, OUT) \
+    VPBROADCASTQ (BX), OUT; \
+    VPBROADCASTQ (BX)(DX*4), Y4; \
+    VPBLENDD $0xf0, Y4, OUT, OUT; \
+    VPBROADCASTQ (SI), Y4; \
+    VPBROADCASTQ (SI)(DI*4), Y5; \
+    VPBLENDD $0xf0, Y5, Y4, Y4; \
+    VPAVGB Y4, OUT, OUT; \
+    VPMADDUBSW ·satdPairSigns8(SB), OUT, OUT; \
+    VPSUBW OUT, ENC, OUT; \
+    ADDQ DX, BX; \
+    ADDQ DI, SI
+
+// A final four-row band has a zero high lane. VEX XMM writes clear the
+// high lane; do not broadcast these rows into both lanes and count twice.
+#define FOUR_ENC8LOW(X, Y) \
+    VMOVQ (AX), X; \
+    VPUNPCKLQDQ X, X, X; \
+    VPMADDUBSW ·satdPairSigns8(SB), Y, Y; \
+    ADDQ CX, AX
+
+#define FOUR_ROW8LOW(ENC, X, Y) \
+    VMOVQ (BX), X; \
+    VMOVQ (SI), X4; \
+    VPAVGB X4, X, X; \
+    VPUNPCKLQDQ X, X, X; \
+    VPMADDUBSW ·satdPairSigns8(SB), Y, Y; \
+    VPSUBW Y, ENC, Y; \
+    ADDQ DX, BX; \
+    ADDQ DI, SI
+
+// Same 4x4 butterflies and absolute-max normalization as satdRowsAVX2.
+// Maxima and their pair sums fit signed words for all byte inputs; only
+// cross-band accumulation needs dwords. The four candidates never share
+// an accumulator, including when their input buffers overlap.
+#define FOUR_TRANSFORM(ACC) \
+    VPADDW Y2, Y0, Y4; \
+    VPADDW Y3, Y1, Y5; \
+    VPSUBW Y2, Y0, Y6; \
+    VPSUBW Y3, Y1, Y7; \
+    VPADDW Y5, Y4, Y0; \
+    VPADDW Y7, Y6, Y1; \
+    VPSUBW Y7, Y6, Y2; \
+    VPSUBW Y5, Y4, Y3; \
+    VPABSW Y0, Y0; \
+    VPABSW Y1, Y1; \
+    VPABSW Y2, Y2; \
+    VPABSW Y3, Y3; \
+    VPBLENDW $0xaa, Y1, Y0, Y4; \
+    VPSLLD $16, Y1, Y1; \
+    VPSRLD $16, Y0, Y0; \
+    VPOR Y0, Y1, Y1; \
+    VPMAXUW Y4, Y1, Y1; \
+    VPBLENDW $0xaa, Y3, Y2, Y4; \
+    VPSLLD $16, Y3, Y3; \
+    VPSRLD $16, Y2, Y2; \
+    VPOR Y2, Y3, Y3; \
+    VPMAXUW Y4, Y3, Y3; \
+    VPADDW Y3, Y1, Y0; \
+    VPMADDWD ·satdFourOnes(SB), Y0, Y0; \
+    VPADDD Y0, ACC, ACC
+
+#define FOUR_REDUCE(Y, X, OFFSET) \
+    VEXTRACTI128 $1, Y, X0; \
+    VPADDD X, X0, X0; \
+    VPSHUFD $0x4e, X0, X1; \
+    VPADDD X1, X0, X0; \
+    VPSHUFD $0xb1, X0, X1; \
+    VPADDD X1, X0, X0; \
+    VMOVD X0, OFFSET(AX)
+
+// Typed-pointer ABI: enc, stride, *[4]candidate, width, height, *[4]int32.
+// Candidate records contain a,b pointers and a,b strides at offsets 0,8,16,24.
+// The Go caller has checked all spans and all output/input disjointness.
+// This leaf does not retain pointers, write input memory or touch Go's R14.
+TEXT ·satdAvgFourAVX2(SB), NOSPLIT, $0-48
+    MOVQ enc+0(FP), AX
+    MOVQ encStride+8(FP), CX
+    MOVQ candidates+16(FP), R8
+    MOVQ width+24(FP), R10
+    MOVQ height+32(FP), R9
+    XORQ R11, R11
+    VPXOR Y12, Y12, Y12
+    VPXOR Y13, Y13, Y13
+    VPXOR Y14, Y14, Y14
