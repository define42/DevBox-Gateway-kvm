+//go:build amd64
+
+package common
+
+import (
+	"unsafe"
+
+	"golang.org/x/sys/cpu"
+)
+
+//go:noescape
+func mcChroma8SSSE3(src *byte, srcStride int, dst *byte, dstStride, height int, weights uint32)
+
+func initMcChromaSSSE3(funcs *SMcFunc, flags uint32) {
+	if flags&WELS_CPU_SSSE3 != 0 && cpu.X86.HasSSSE3 {
+		funcs.PMcChromaFunc = McChroma_ssse3
+	}
+}
+
+// McChroma_ssse3 uses paired byte multiply-adds for width eight. Keep integer
+// copies and narrower interpolation in this dispatcher so they do not pay for
+// an extra call through the SSE2 wrapper. Span and alias checks match that wrapper.
+func McChroma_ssse3(src []byte, srcOff int, srcStride int32, dst []byte, dstOff int, dstStride int32, mvX, mvY int16, width, height int32) {
+	if width <= 0 || height <= 0 {
+		return
+	}
+	if mvX&7 == 0 && mvY&7 == 0 {
+		if height == 16 && (width == 8 || width == 16) {
+			mcCopySSE2(src, srcOff, srcStride, dst, dstOff, dstStride, width, height)
+		} else {
+			McCopy_c(src, srcOff, srcStride, dst, dstOff, dstStride, width, height)
+		}
+		return
+	}
+	if width != 2 && width != 4 && width != 8 {
+		McChroma_c(src, srcOff, srcStride, dst, dstOff, dstStride, mvX, mvY, width, height)
+		return
+	}
+	// Validate against length, including the extra source column and row.
+	// Checking before slicing also handles a short slice with excess capacity.
+	first, last := int64(srcOff), int64(srcOff)+int64(height)*int64(srcStride)
+	if last < first {
+		first, last = last, first
+	}
+	checkSIMDSpan(src, first, last+int64(width))
+	srcFirst, srcLast := first, last+int64(width)
+	first, last = int64(dstOff), int64(dstOff)+int64(height-1)*int64(dstStride)
+	if last < first {
+		first, last = last, first
+	}
+	checkSIMDSpan(dst, first, last+int64(width)-1)
+	// Shifted aliases depend on the scalar pixel-by-pixel access order.
+	srcStart := uintptr(unsafe.Pointer(&src[srcFirst]))
+	srcEnd := uintptr(unsafe.Pointer(&src[srcLast]))
+	dstStart := uintptr(unsafe.Pointer(&dst[first]))
+	dstEnd := uintptr(unsafe.Pointer(&dst[last+int64(width)-1]))
+	if srcStart <= dstEnd && dstStart <= srcEnd {
+		McChroma_c(src, srcOff, srcStride, dst, dstOff, dstStride, mvX, mvY, width, height)
+		return
+	}
+	w := G_kuiABCD[mvY&7][mvX&7]
+	if width == 8 && cpu.X86.HasSSSE3 {
+		weights := uint32(w[0]) | uint32(w[1])<<8 | uint32(w[2])<<16 | uint32(w[3])<<24
+		mcChroma8SSSE3(&src[srcOff], int(srcStride), &dst[dstOff], int(dstStride), int(height), weights)
+		return
+	}
+	weights := uint64(w[0]) | uint64(w[1])<<16 | uint64(w[2])<<32 | uint64(w[3])<<48
+	mcChromaSSE2(src[srcOff:], int(srcStride), dst[dstOff:], int(dstStride), int(width), int(height), weights)
+}
diff --git a/pkg/h264/internal/common/chroma_ssse3_amd64.s b/pkg/h264/internal/common/chroma_ssse3_amd64.s
new file mode 100644
index 0000000..93221b3
--- /dev/null
+++ b/pkg/h264/internal/common/chroma_ssse3_amd64.s
@@ -0,0 +1,51 @@
+//go:build amd64
+
+// Paired-byte chroma interpolation and row reuse follow OpenH264's
+// McChromaWidthEq8_ssse3 in codec/common/x86/mc_chroma.asm.
+// Copyright (c) 2009-2013, Cisco Systems. All rights reserved.
+// BSD-2-Clause; see LICENSE-OpenH264 in the repository root.
+
+#include "textflag.h"
+
+// The checked caller supplies disjoint input/output spans and positive height.
+// Each source row contains exactly nine accessible bytes. Two overlapping
+// eight-byte loads form its eight adjacent pairs without native's wider reads.
+// Weights are in [0,64] and sum to 64. Each PMADDUBSW pair is <=255*64=16320;
+// the combined rounded sum is <=16352, so signed-word saturation never occurs.
+TEXT ·mcChroma8SSSE3(SB), NOSPLIT, $0-44
+    MOVQ src+0(FP), AX
+    MOVQ srcStride+8(FP), CX
+    MOVQ dst+16(FP), BX
+    MOVQ dstStride+24(FP), DX
+    MOVQ height+32(FP), DI
+    MOVL weights+40(FP), X4
+    MOVOU X4, X5
+    PSHUFLW $0, X4, X4
+    PSHUFL $0, X4, X4
+    PSHUFLW $0x55, X5, X5
+    PSHUFL $0, X5, X5
+    MOVL $0x00200020, R8
+    MOVL R8, X6
+    PSHUFL $0, X6, X6
+
+    MOVQ (AX), X0
+    MOVQ 1(AX), X1
+    PUNPCKLBW X1, X0
+chroma_ssse3_row:
+    ADDQ CX, AX
+    MOVQ (AX), X1
+    MOVQ 1(AX), X2
+    PUNPCKLBW X2, X1
+    MOVOU X1, X3
+    PMADDUBSW X4, X0
+    PMADDUBSW X5, X1
+    PADDW X1, X0
+    PADDW X6, X0
+    PSRLW $6, X0
+    PACKUSWB X0, X0
+    MOVQ X0, (BX)
+    MOVOU X3, X0
+    ADDQ DX, BX
+    DECQ DI
+    JNZ chroma_ssse3_row
+    RET
diff --git a/pkg/h264/internal/common/chroma_ssse3_amd64_test.go b/pkg/h264/internal/common/chroma_ssse3_amd64_test.go
new file mode 100644
index 0000000..580ca8b
--- /dev/null
+++ b/pkg/h264/internal/common/chroma_ssse3_amd64_test.go
@@ -0,0 +1,130 @@
+//go:build amd64
+
+package common
+
+import (
+	"bytes"
+	"fmt"
+	"math/rand"
+	"reflect"
+	"testing"
+)
+
+func requireChromaSSSE3(t *testing.T) {
+	t.Helper()
+	if WelsCPUFeatureDetect(nil)&WELS_CPU_SSSE3 == 0 {
+		t.Skip("SSSE3 required")
+	}
+}
+
+func TestChromaSSSE3Dispatch(t *testing.T) {
+	var funcs SMcFunc
+	for _, flags := range []uint32{0, WELS_CPU_SSE2, WELS_CPU_SSE2 | WELS_CPU_SSSE3, 0} {
+		InitMcFunc(&funcs, flags)
+		want := PWelsMcFunc(McChroma_c)
+		if flags&WELS_CPU_SSE2 != 0 {
+			want = McChroma_sse2
+		}
+		if flags&WELS_CPU_SSSE3 != 0 && WelsCPUFeatureDetect(nil)&WELS_CPU_SSSE3 != 0 {
+			want = McChroma_ssse3
+		}
+		if reflect.ValueOf(funcs.PMcChromaFunc).Pointer() != reflect.ValueOf(want).Pointer() {
+			t.Fatalf("flags=%x selected unexpected chroma implementation", flags)
+		}
+	}
+}
+
+func TestChromaSSSE3MatchesScalar(t *testing.T) {
+	requireChromaSSSE3(t)
+	rng := rand.New(rand.NewSource(264833))
+	for _, size := range [][2]int32{{8, 1}, {8, 2}, {8, 3}, {8, 4}, {8, 5}, {8, 8}, {8, 9}, {8, 16}, {8, 17}, {4, 8}, {2, 4}, {3, 5}, {16, 16}} {
+		t.Run(fmt.Sprintf("%dx%d", size[0], size[1]), func(t *testing.T) {
+			for pattern := range 4 {
+				const srcOff, dstOff, srcStride, dstStride = 3, 5, 23, 21
+				src := make([]byte, srcOff+int(size[1])*srcStride+int(size[0])+1)
+				rng.Read(src)
+				for i := range src {
+					switch pattern {
+					case 0:
+						src[i] = 0
+					case 1:
+						src[i] = 255
+					case 2:
+						src[i] = byte(255 * (i & 1))
+					}
+				}
+				srcBefore := bytes.Clone(src)
+				for dx := int16(-8); dx < 8; dx++ {
+					for dy := int16(-8); dy < 8; dy++ {
+						got := bytes.Repeat([]byte{0xa5}, dstOff+(int(size[1])-1)*dstStride+int(size[0])+7)
+						want := bytes.Clone(got)
+						McChroma_c(src, srcOff, srcStride, want, dstOff, dstStride, dx, dy, size[0], size[1])
+						McChroma_ssse3(src, srcOff, srcStride, got, dstOff, dstStride, dx, dy, size[0], size[1])
+						if !bytes.Equal(got, want) || !bytes.Equal(src, srcBefore) {
+							t.Fatalf("pattern=%d MV(%d,%d): output or input differs", pattern, dx, dy)
+						}
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestChromaSSSE3SignedStridesAndAliases(t *testing.T) {
+	requireChromaSSSE3(t)
+	for _, strides := range [][2]int32{{0, 0}, {1, 2}, {3, 5}, {19, 13}, {-19, 13}, {19, -13}, {-19, -13}} {
+		for _, height := range []int32{7, 8} {
+			for _, delta := range []int{-1, 0, 1, 20, 400} {
+				got := make([]byte, 1024)
+				for i := range got {
+					got[i] = byte(i*37 + 11)
+				}
+				want := bytes.Clone(got)
+				McChroma_c(want, 256, strides[0], want, 256+delta, strides[1], -3, 5, 8, height)
+				McChroma_ssse3(got, 256, strides[0], got, 256+delta, strides[1], -3, 5, 8, height)
+				if !bytes.Equal(got, want) {
+					t.Fatalf("strides=%v height=%d delta=%d: aliased output differs", strides, height, delta)
+				}
+			}
+			// Disjoint planes force the new kernel for each unusual stride.
+			src, got, want := make([]byte, 1024), make([]byte, 1024), make([]byte, 1024)
+			for i := range src {
+				src[i] = byte(i*13 + i/19)
+			}
+			McChroma_c(src, 256, strides[0], want, 256, strides[1], 3, -5, 8, height)
+			McChroma_ssse3(src, 256, strides[0], got, 256, strides[1], 3, -5, 8, height)
+			if !bytes.Equal(got, want) {
+				t.Fatalf("strides=%v height=%d: disjoint output differs", strides, height)
+			}
+		}
+	}
+}
+
+func TestChromaSSSE3VisibleBounds(t *testing.T) {
+	requireChromaSSSE3(t)
+	for _, phase := range [][2]int16{{3, 5}, {0, 5}, {5, 0}} {
+		for _, field := range []string{"source", "destination", "negative-source", "negative-destination", "overflowing-source", "overflowing-destination"} {
+			t.Run(fmt.Sprintf("%v/%s", phase, field), func(t *testing.T) {
+				src, dst := make([]byte, 256), make([]byte, 256)
+				srcOff, dstOff := 1, 3
+				switch field {
+				case "source":
+					src = src[:srcOff+8*16+8]
+				case "destination":
+					dst = dst[:dstOff+7*16+7]
+				case "negative-source":
+					srcOff = -1
+				case "negative-destination":
+					dstOff = -1
+				case "overflowing-source":
+					srcOff = int(^uint(0) >> 1)
+				case "overflowing-destination":
+					dstOff = int(^uint(0) >> 1)
+				}
+				requireSIMDBoundsPanic(t, func() {
+					McChroma_ssse3(src, srcOff, 16, dst, dstOff, 16, phase[0], phase[1], 8, 8)
+				})
+			})
+		}
+	}
+}
