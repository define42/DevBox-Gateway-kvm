+++ b/pkg/h264/internal/encoder/quant_max_bench_amd64_test.go
@@ -0,0 +1,40 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"fmt"
+	"testing"
+)
+
+// This file also compiles against the SSE2-only baseline. Include input restore
+// and the production bounds/dispatch wrapper, as used by the skip decision.
+func BenchmarkQuantFour4x4MaxChecked(b *testing.B) {
+	for _, qp := range []int{10, 26, 42} {
+		for _, density := range []string{"zero", "sparse", "dense", "extremes"} {
+			b.Run(fmt.Sprintf("QP%d/%s", qp, density), func(b *testing.B) {
+				var input, dct [64]int16
+				for i := range input {
+					switch density {
+					case "sparse":
+						if i%11 == 0 {
+							input[i] = int16(i*17 - 300)
+						}
+					case "dense":
+						input[i] = int16(i*71 - 2000)
+					case "extremes":
+						input[i] = [...]int16{-32768, -32767, -1, 0, 1, 32766, 32767}[i%7]
+					}
+				}
+				ff, mf := g_kiQuantInterFF[qp], g_kiQuantMF[qp]
+				var maxima [4]int16
+				b.ReportAllocs()
+				b.SetBytes(128)
+				for b.Loop() {
+					dct = input
+					WelsQuantFour4x4Max_sse2(dct[:], ff[:], mf[:], maxima[:])
+				}
+			})
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/quant_max_guard_linux_amd64_test.go b/pkg/h264/internal/encoder/quant_max_guard_linux_amd64_test.go
new file mode 100644
index 0000000..6937e10
--- /dev/null
+++ b/pkg/h264/internal/encoder/quant_max_guard_linux_amd64_test.go
@@ -0,0 +1,40 @@
+//go:build linux && amd64
+
+package encoder
+
+import (
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/cpu"
+)
+
+func TestQuantMaxGuardPages(t *testing.T) {
+	words := func(n int) []int16 {
+		buffer := idctGuardedBuffer(t, n*2)
+		return unsafe.Slice((*int16)(unsafe.Pointer(&buffer[0])), n)
+	}
+	for _, direct := range []bool{false, true} {
+		if direct && !cpu.X86.HasAVX2 {
+			continue
+		}
+		dct, ff, mf, maxima := words(64), words(8), words(8), words(4)
+		for i := range dct {
+			dct[i] = int16(i*701 - 20000)
+		}
+		copy(ff, g_kiQuantInterFF[20][:])
+		copy(mf, g_kiQuantMF[20][:])
+		var want [64]int16
+		copy(want[:], dct)
+		var wantMax [4]int16
+		WelsQuantFour4x4Max_c(want[:], ff, mf, wantMax[:])
+		if direct {
+			quantFour4x4MaxAVX2((*[64]int16)(dct), (*[8]int16)(ff), (*[8]int16)(mf), (*[4]int16)(maxima))
+		} else {
+			WelsQuantFour4x4Max_sse2(dct, ff, mf, maxima)
+		}
+		if *(*[64]int16)(dct) != want || *(*[4]int16)(maxima) != wantMax || *(*[8]int16)(ff) != g_kiQuantInterFF[20] || *(*[8]int16)(mf) != g_kiQuantMF[20] {
+			t.Fatalf("direct%t: coefficients, maxima or source tables differ", direct)
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/quant_scan_avx2_amd64_test.go b/pkg/h264/internal/encoder/quant_scan_avx2_amd64_test.go
