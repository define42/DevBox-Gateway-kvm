+package encoder
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+var interLumaBookkeepingBenchmarkSink uint8
+
+// The unchanged public entry and the same residual reset are timed in both
+// trees. Inputs remain representative after every iteration's dequantization.
+func BenchmarkInterLumaBookkeeping(b *testing.B) {
+	for _, qp := range []uint8{20, 32} {
+		for _, content := range []string{"Dense", "Motion", "Sparse", "Zero"} {
+			b.Run(fmt.Sprintf("%s/QP%d", content, qp), func(b *testing.B) {
+				var input, residual [384]int16
+				for i := range input {
+					value := int16((i*1701+13)%2049 - 1024)
+					switch content {
+					case "Motion":
+						if i%7 >= 3 {
+							value = 0
+						}
+					case "Sparse":
+						if i%17 != 0 {
+							value = 0
+						}
+						value /= 8
+					case "Zero":
+						value = 0
+					}
+					input[i] = value
+				}
+				var functions SWelsFuncPtrList
+				flags := common.WelsCPUFeatureDetect(nil)
+				WelsInitEncodingFuncs(&functions, flags)
+				WelsInitReconstructionFuncs(&functions, flags)
+				functions.pfSetMemZeroSize64 = WelsSetMemZero_c
+				var dct SDCTCoeff
+				var nonzero [24]int8
+				mb := SMB{uiLumaQp: qp, pNonZeroCount: nonzero[:]}
+				cache := SMbCache{pCoeffLevel: residual[:], pDct: &dct}
+				b.ReportAllocs()
+				for b.Loop() {
+					residual = input
+					mb.uiCbp = 0x30
+					WelsEncInterY(&functions, &mb, &cache)
+				}
+				interLumaBookkeepingBenchmarkSink = mb.uiCbp
+			})
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/inter_luma_bookkeeping_test.go b/pkg/h264/internal/encoder/inter_luma_bookkeeping_test.go
new file mode 100644
index 0000000..14d7a18
--- /dev/null
+++ b/pkg/h264/internal/encoder/inter_luma_bookkeeping_test.go
@@ -0,0 +1,266 @@
+package encoder
+
+import (
+	"fmt"
+	"math/bits"
+	"math/rand"
+	"reflect"
+	"testing"
+	"unsafe"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+type interLumaCallbackEvent struct {
+	kind     byte
+	offset   int
+	length   int
+	size     int32
+	cbp      uint8
+	counts   [24]int8
+	residual [64]int16
+}
+
+type interLumaBookkeepingState struct {
+	backing         [1024]int16
+	residual        [384]int16
+	dct             SDCTCoeff
+	counts          [32]int8
+	alternateCounts [32]int8
+	mb              SMB
+	cache           SMbCache
+	functions       SWelsFuncPtrList
+	events          []interLumaCallbackEvent
+}
+
+func newInterLumaBookkeepingState(input [384]int16, qp, cbp uint8, mutate bool) *interLumaBookkeepingState {
+	s := &interLumaBookkeepingState{residual: input}
+	for i := range s.dct.iLumaBlock {
+		s.dct.iLumaBlock[i] = -12345
+	}
+	for i := range s.dct.iChromaBlock {
+		s.dct.iChromaBlock[i] = 23456
+	}
+	for i := range s.dct.iLumaI16x16Dc {
+		s.dct.iLumaI16x16Dc[i] = int16(100 + i)
+	}
+	s.dct.iChromaDc = [2][4]int16{{11, 13, 17, 19}, {23, 29, 31, 37}}
+	for i := range s.counts {
+		s.counts[i], s.alternateCounts[i] = int8(17+i), int8(71+i)
+	}
+	s.mb = SMB{uiMbType: common.MB_TYPE_16x16, uiLumaQp: qp, uiChromaQp: 31, uiCbp: cbp, pNonZeroCount: s.counts[:24]}
+	s.cache = SMbCache{pCoeffLevel: s.residual[:], pDct: &s.dct}
+	WelsInitEncodingFuncs(&s.functions, 0)
+	WelsInitReconstructionFuncs(&s.functions, 0)
+	s.functions.pfGetNoneZeroCount = WelsGetNoneZeroCount_c
+	record := func(kind byte, data []int16, size int32) {
+		event := interLumaCallbackEvent{kind: kind, length: len(data), size: size, cbp: s.mb.uiCbp}
+		event.offset = int(uintptr(unsafe.Pointer(&data[0]))-uintptr(unsafe.Pointer(&s.cache.pCoeffLevel[0]))) / 2
+		copy(event.counts[:], s.mb.pNonZeroCount)
+		copy(event.residual[:], data)
+		s.events = append(s.events, event)
+	}
+	mutateState := func() {
+		if mutate && len(s.events) == 1 {
+			s.mb.uiCbp ^= 0x80
+			s.mb.pNonZeroCount = s.alternateCounts[:24]
+			s.cache.pCoeffLevel[192] = 17
+		}
+	}
+	s.functions.pfSetMemZeroSize64 = func(data []int16, size int32) {
+		record('z', data, size)
+		WelsSetMemZero_c(data, size)
+		mutateState()
+	}
+	s.functions.pfDequantizationFour4x4 = func(data []int16, factors []uint16) {
+		record('d', data, 128)
+		WelsDequantFour4x4_c(data, factors)
+		mutateState()
+	}
+	return s
+}
+
+func compareInterLumaBookkeeping(t *testing.T, input [384]int16, qp, cbp uint8, mutate bool) {
+	t.Helper()
+	got := newInterLumaBookkeepingState(input, qp, cbp, mutate)
+	want := newInterLumaBookkeepingState(input, qp, cbp, mutate)
+	WelsEncInterY(&got.functions, &got.mb, &got.cache)
+	// Existing frozen pre-fusion reference independently scans, scores and
+	// counts coefficients instead of using the candidate's masks/bookkeeping.
+	coefficientInterYReference(&want.functions, &want.mb, &want.cache)
+	checkInterLumaBookkeepingStates(t, got, want)
+}
+
+func checkInterLumaBookkeepingStates(t *testing.T, got, want *interLumaBookkeepingState) {
+	t.Helper()
+	if got.backing != want.backing || got.residual != want.residual || got.dct != want.dct || got.counts != want.counts ||
+		got.alternateCounts != want.alternateCounts || got.mb.uiCbp != want.mb.uiCbp ||
+		got.mb.uiLumaQp != want.mb.uiLumaQp || got.mb.uiChromaQp != want.mb.uiChromaQp ||
+		!reflect.DeepEqual(got.events, want.events) {
+		t.Fatalf("state or callback trace differs: CBP=%#x/%#x events=%v/%v", got.mb.uiCbp, want.mb.uiCbp, got.events, want.events)
+	}
+	gotAlternate := &got.mb.pNonZeroCount[0] == &got.alternateCounts[0]
+	wantAlternate := &want.mb.pNonZeroCount[0] == &want.alternateCounts[0]
+	if gotAlternate != wantAlternate {
+		t.Fatal("callback-selected nonzero buffer changed")
+	}
+}
+
+func interLumaUnitInput(t *testing.T, qp, index, level int) int16 {
+	t.Helper()
+	ff, mf := int(g_kiQuantInterFF[qp][index&7]), int(g_kiQuantMF[qp][index&7])
+	value := (level*65536+mf-1)/mf - ff
+	if value < 0 || value > 32767 || int(wels_NEW_QUANT(int16(value), int16(ff), int16(mf))) != level {
+		t.Fatalf("cannot construct QP%d position%d quantized level%d", qp, index, level)
+	}
+	return int16(value)
+}
+
+func TestInterLumaBookkeepingThresholds(t *testing.T) {
+	// A lone block in each group has precisely this run score. Cases straddle
+	// both the macroblock threshold six and the retained-group threshold four.
+	masks := [...]uint16{0, 1 << 3, 1 << 1, 1, 1 | 1<<4, 1 | 1<<2, 3}
+	scan := [...]int{0, 1, 4, 8, 5, 2, 3, 6, 9, 12, 13, 10, 7, 11, 14, 15}
+	for qp := range 52 {
+		for _, scores := range [][4]int{{0, 0, 0, 0}, {3, 2, 0, 0}, {3, 3, 0, 0}, {4, 1, 0, 0}, {4, 2, 0, 0}, {5, 1, 0, 0}, {6, 0, 0, 0}, {1, 4, 5, 6}, {6, 5, 4, 3}} {
+			t.Run(fmt.Sprintf("QP%d/scores%v", qp, scores), func(t *testing.T) {
+				var input [384]int16
+				for i := 256; i < len(input); i++ {
+					input[i] = int16(i*17 + 3)
+				}
+				for group, score := range scores {
+					for position, index := range scan {
+						if masks[score]&(1<<position) != 0 {
+							input[group*64+index] = interLumaUnitInput(t, qp, index, 1)
+							if (group+position)&1 != 0 {
+								input[group*64+index] = -input[group*64+index]
+							}
+						}
+					}
+				}
+				for _, cbp := range []uint8{0, 0x30, 0xa5} {
+					compareInterLumaBookkeeping(t, input, uint8(qp), cbp, false)
+				}
+			})
+		}
+	}
+}
+
+func TestInterLumaBookkeepingRandomAndCallbacks(t *testing.T) {
+	rng := rand.New(rand.NewSource(0x26416))
+	for qp := range 52 {
+		for fixture := range 18 {
+			var input [384]int16
+			for i := range input {
+				switch fixture % 3 {
+				case 0:
+					input[i] = int16(rng.Uint32())
+				case 1:
+					input[i] = [...]int16{-32768, -32767, -1, 0, 1, 32766, 32767}[rng.Intn(7)]
+				case 2:
+					if rng.Intn(4) == 0 {
+						input[i] = int16(rng.Intn(513) - 256)
+					}
+				}
+			}
+			compareInterLumaBookkeeping(t, input, uint8(qp), uint8(fixture*37), fixture&1 != 0)
+		}
+	}
+}
+
+func TestInterLumaBookkeepingAliases(t *testing.T) {
+	for _, qp := range []uint8{0, 20, 32, 51} {
+		for _, shift := range []int{-64, 0, 4, 64} {
+			for _, countsOffset := range []int{-1, 0, 31, 192} {
+				for _, mutate := range []bool{false, true} {
+					t.Run(fmt.Sprintf("QP%d/residual%d/counts%d/mutate%t", qp, shift, countsOffset, mutate), func(t *testing.T) {
+						setup := func() *interLumaBookkeepingState {
+							s := newInterLumaBookkeepingState([384]int16{}, qp, 0x30, mutate)
+							for i := range s.backing {
+								s.backing[i] = int16(i*713 + 19 + int(qp))
+							}
+							// SDCTCoeff contains only int16 arrays. This one backing
+							// allocation deliberately crosses residual/scan boundaries.
+							s.cache.pDct = (*SDCTCoeff)(unsafe.Pointer(&s.backing[256]))
+							s.cache.pCoeffLevel = s.backing[256+shift : 256+shift+384]
+							if countsOffset >= 0 {
+								s.mb.pNonZeroCount = unsafe.Slice((*int8)(unsafe.Pointer(&s.backing[256+countsOffset])), 24)
+							}
+							return s
+						}
+						got, want := setup(), setup()
+						WelsEncInterY(&got.functions, &got.mb, &got.cache)
+						interLumaFrozenBookkeeping(&want.functions, &want.mb, &want.cache)
+						checkInterLumaBookkeepingStates(t, got, want)
+					})
+				}
+			}
+		}
+	}
+}
+
+// Frozen immediately before this bookkeeping change. Unlike the independent
+// pre-fusion reference above, this retains already-established mask semantics
+// when nonzero counts, scanned levels and residuals deliberately alias.
+func interLumaFrozenBookkeeping(pFuncList *SWelsFuncPtrList, pCurMb *SMB, pMbCache *SMbCache) {
+	pfSetMemZeroSize64 := pFuncList.pfSetMemZeroSize64
+	pfDequantizationFour4x4 := pFuncList.pfDequantizationFour4x4
+	pRes := pMbCache.pCoeffLevel
+	iSingleCtrMb := int32(0)
+	var iSingleCtr8x8 [4]int32
+	pBlock := pMbCache.pDct.iLumaBlock[:]
+	uiQp := pCurMb.uiLumaQp
+	pMF := g_kiQuantMF[uiQp][:]
+	pFF := g_kiQuantInterFF[uiQp][:]
+	var aMax [16]int16
+	var masks [16]uint16
+	iNoneZeroCount := int32(0)
+
+	quantScanLuma(pRes, pBlock, pFF, pMF, aMax[:], masks[:])
+
+	iResOff := 0
+	iBlockOff := 0
+	for i := 0; i < 4; i++ {
+		iSingleCtr8x8[i] = 0
+		for j := 0; j < 4; j++ {
+			if aMax[(i<<2)+j] != 0 {
+				mask := masks[(i<<2)+j]
+				if aMax[(i<<2)+j] > 1 {
+					iSingleCtr8x8[i] += 9
+				} else if iSingleCtr8x8[i] < 6 {
+					iSingleCtr8x8[i] += coefficientScoreMask(mask)
+				}
+			}
+			iResOff += 16
+			iBlockOff += 16
+		}
+		iSingleCtrMb += iSingleCtr8x8[i]
+	}
+	iBlockOff -= 256
+	iResOff -= 256
+
+	clear(pCurMb.pNonZeroCount[:16])
+
+	if iSingleCtrMb < 6 { //from JVT-O079
+		pfSetMemZeroSize64(pRes[iResOff:], 768) // confirmed_safe_unsafe_usage
+	} else {
+		kpNoneZeroCountIdx := common.G_kuiMbCountScan4Idx[:]
+		for i := 0; i < 4; i++ {
+			if iSingleCtr8x8[i] >= 4 {
+				for j := 0; j < 4; j++ {
+					iNoneZeroCount = int32(bits.OnesCount16(masks[(i<<2)+j]))
+					pCurMb.pNonZeroCount[kpNoneZeroCountIdx[0]] = int8(iNoneZeroCount)
+					kpNoneZeroCountIdx = kpNoneZeroCountIdx[1:]
+					iBlockOff += 16
+				}
+				pfDequantizationFour4x4(pRes[iResOff:], common.G_kuiDequantCoeff[uiQp][:])
+				pCurMb.uiCbp |= uint8(1 << i)
+			} else { // set zero for an 8x8 pBlock
+				pfSetMemZeroSize64(pRes[iResOff:], 128) // confirmed_safe_unsafe_usage
+				kpNoneZeroCountIdx = kpNoneZeroCountIdx[4:]
+				iBlockOff += 64
+			}
+			iResOff += 64
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/intra_word_pred_bench_test.go b/pkg/h264/internal/encoder/intra_word_pred_bench_test.go
new file mode 100644
index 0000000..6a97e8d
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_word_pred_bench_test.go
@@ -0,0 +1,43 @@
+package encoder
+
+import (
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+	"testing"
+)
+
+var i4WordCostSink int32
+
+func BenchmarkI4WordPredictors(b *testing.B) {
+	var funcs SWelsFuncPtrList
+	WelsInitIntraPredFuncs(&funcs, 0)
+	WelsInitSampleSadFunc(&funcs, common.WELS_CPU_SSE2)
+	for _, tc := range []struct {
+		name string
+		mode int
+	}{{"DC", common.I4_PRED_DC}, {"H", common.I4_PRED_H}, {"V", common.I4_PRED_V}} {
+		for _, withSAD := range []bool{false, true} {
+			name := tc.name
+			if withSAD {
+				name += "AndSAD"
+			}
+			b.Run(name, func(b *testing.B) {
+				ref, enc, dst := make([]byte, 16384), make([]byte, 16384), make([]byte, 16)
+				for i := range ref {
+					ref[i] = byte(i*17 + 7)
+					enc[i] = byte(i*19 + 11)
+				}
+				fn := funcs.pfGetLumaI4x4Pred[tc.mode]
+				sad := funcs.sSampleDealingFuncs.pfSampleSad[BLOCK_4x4]
+				var cost int32
+				b.ReportAllocs()
+				for b.Loop() {
+					fn(dst, 0, ref, 2049, 2048)
+					if withSAD {
+						cost = sad(dst, 0, 4, enc, 0, 2048)
+					}
+				}
+				i4WordCostSink = cost
+			})
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/intra_word_pred_test.go b/pkg/h264/internal/encoder/intra_word_pred_test.go
new file mode 100644
index 0000000..ff2b421
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_word_pred_test.go
@@ -0,0 +1,166 @@
+package encoder
+
+import (
+	"bytes"
+	"fmt"
+	"math/rand"
+	"testing"
+)
+
+var i4WordCases = []struct {
+	name      string
+	got, want PGetIntraPredFunc
+}{
+	{"V", WelsI4x4LumaPredV_c, legacyI4WordWelsI4x4LumaPredV_c},
+	{"H", WelsI4x4LumaPredH_c, legacyI4WordWelsI4x4LumaPredH_c},
+	{"DC", WelsI4x4LumaPredDc_c, legacyI4WordWelsI4x4LumaPredDc_c},
+	{"DCLeft", WelsI4x4LumaPredDcLeft_c, legacyI4WordWelsI4x4LumaPredDcLeft_c},
+	{"DCTop", WelsI4x4LumaPredDcTop_c, legacyI4WordWelsI4x4LumaPredDcTop_c},
+	{"DCNA", WelsI4x4LumaPredDcNA_c, legacyI4WordWelsI4x4LumaPredDcNA_c},
+}
+
+func TestI4WordPredictorParity(t *testing.T) {
+	rng := rand.New(rand.NewSource(4257))
+	for _, tc := range i4WordCases {
+		for _, stride := range []int32{-31, 0, 1, 4, 31, 2048} {
+			t.Run(fmt.Sprintf("%s/stride%d", tc.name, stride), func(t *testing.T) {
+				for pattern := 0; pattern < 25; pattern++ {
+					for _, alias := range []bool{false, true} {
+						for _, dstOff := range []int{0, 3, 8188, 8191, 8192, 8193, 8196} {
+							ref := make([]byte, 16384)
+							rng.Read(ref)
+							if pattern < 2 {
+								for i := range ref {
+									ref[i] = byte(pattern * 255)
+								}
+							}
+							a, z := bytes.Repeat([]byte{0x5a}, 16384), bytes.Repeat([]byte{0x5a}, 16384)
+							ar, zr := bytes.Clone(ref), bytes.Clone(ref)
+							if alias {
+								a, z = ar, zr
+							}
+							tc.got(a, dstOff, ar, 8192, stride)
+							tc.want(z, dstOff, zr, 8192, stride)
+							if !bytes.Equal(a, z) || !bytes.Equal(ar, zr) {
+								t.Fatalf("pattern=%d alias=%v offset=%d", pattern, alias, dstOff)
+							}
+						}
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestI4WordFillAllValues(t *testing.T) {
+	for value := 0; value < 256; value++ {
+		for off := 0; off < 17; off++ {
+			a, z := bytes.Repeat([]byte{0xa5}, 33), bytes.Repeat([]byte{0xa5}, 33)
+			WelsFillingPred1to16_c(a, off, byte(value))
+			legacyI4WordWelsFillingPred1to16_c(z, off, byte(value))
+			if !bytes.Equal(a, z) {
+				t.Fatalf("value=%d offset=%d", value, off)
+			}
+		}
+	}
+}
+
+func legacyI4WordWelsFillingPred1to16_c(pPred []uint8, iPredOff int, kuiSrc uint8) {
+	legacyI4WordintraPredFillBytes(pPred[iPredOff:iPredOff+16], kuiSrc)
+}
+
+func legacyI4WordintraPredFillBytes(p []uint8, v uint8) {
+	for i := range p {
+		p[i] = v
+	}
+}
+
+func legacyI4WordWelsI4x4LumaPredV_c(pPred []uint8, iPredOff int, pRef []uint8, iRefOff int, kiStride int32) {
+	var uiSrcx2 [8]uint8
+	top := iRefOff - int(kiStride)
+	copy(uiSrcx2[0:4], pRef[top:top+4])
+	copy(uiSrcx2[4:8], pRef[top:top+4])
+
+	WelsFillingPred8to16_c(pPred, iPredOff, uiSrcx2[:])
+}
+
+func legacyI4WordWelsI4x4LumaPredH_c(pPred []uint8, iPredOff int, pRef []uint8, iRefOff int, kiStride int32) {
+	kiStridex2Left := int((kiStride << 1) - 1)
+	kiStridex3Left := int(kiStride) + kiStridex2Left
+	kuiHor1 := pRef[iRefOff-1]
+	kuiHor2 := pRef[iRefOff+int(kiStride)-1]
+	kuiHor3 := pRef[iRefOff+kiStridex2Left]
+	kuiHor4 := pRef[iRefOff+kiStridex3Left]
+	var uiSrc [16]uint8
+	legacyI4WordintraPredFillBytes(uiSrc[0:4], kuiHor1)
+	legacyI4WordintraPredFillBytes(uiSrc[4:8], kuiHor2)
+	legacyI4WordintraPredFillBytes(uiSrc[8:12], kuiHor3)
+	legacyI4WordintraPredFillBytes(uiSrc[12:16], kuiHor4)
+
+	WelsFillingPred8x2to16_c(pPred, iPredOff, uiSrc[:])
+}
+
+func legacyI4WordWelsI4x4LumaPredDc_c(pPred []uint8, iPredOff int, pRef []uint8, iRefOff int, kiStride int32) {
+	s := int(kiStride)
+	r := func(k int) int32 { return int32(pRef[iRefOff+k]) }
+	kuiDcValue := uint8((r(-1) + r(s-1) + r((s<<1)-1) + r((s<<1)+s-1) +
+		r(-s) + r(1-s) + r(2-s) + r(3-s) + 4) >> 3)
+
+	legacyI4WordWelsFillingPred1to16_c(pPred, iPredOff, kuiDcValue)
+}
+
+func legacyI4WordWelsI4x4LumaPredDcLeft_c(pPred []uint8, iPredOff int, pRef []uint8, iRefOff int, kiStride int32) {
+	s := int(kiStride)
+	r := func(k int) int32 { return int32(pRef[iRefOff+k]) }
+	kuiDcValue := uint8((r(-1) + r(s-1) + r((s<<1)-1) + r((s<<1)+s-1) + 2) >> 2)
+
+	legacyI4WordWelsFillingPred1to16_c(pPred, iPredOff, kuiDcValue)
+}
+
+func legacyI4WordWelsI4x4LumaPredDcTop_c(pPred []uint8, iPredOff int, pRef []uint8, iRefOff int, kiStride int32) {
+	s := int(kiStride)
+	r := func(k int) int32 { return int32(pRef[iRefOff+k]) }
+	kuiDcValue := uint8((r(-s) + r(1-s) + r(2-s) + r(3-s) + 2) >> 2)
+
+	legacyI4WordWelsFillingPred1to16_c(pPred, iPredOff, kuiDcValue)
+}
+
+func legacyI4WordWelsI4x4LumaPredDcNA_c(pPred []uint8, iPredOff int, pRef []uint8, iRefOff int, kiStride int32) {
+	const kuiDcValue = 0x80
+
+	legacyI4WordWelsFillingPred1to16_c(pPred, iPredOff, kuiDcValue)
+}
+
+func TestI4WordExactInputAndOutputSpans(t *testing.T) {
+	// These dimensions give each predictor exactly its last required input byte.
+	for _, tc := range []struct {
+		name      string
+		fn        PGetIntraPredFunc
+		size, off int
+		stride    int32
+	}{
+		{"V", WelsI4x4LumaPredV_c, 4, 4, 4},
+		{"H", WelsI4x4LumaPredH_c, 13, 1, 4},
+		{"DC", WelsI4x4LumaPredDc_c, 16, 4, 4},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ref := make([]byte, tc.size)
+			for i := range ref {
+				ref[i] = byte(i * 17)
+			}
+			dst := make([]byte, 16)
+			tc.fn(dst, 0, ref, tc.off, tc.stride)
+			mustPanic := func(fn func()) {
+				t.Helper()
+				defer func() {
+					if recover() == nil {
+						t.Fatal("short buffer accepted")
+					}
+				}()
+				fn()
+			}
+			mustPanic(func() { tc.fn(make([]byte, 15), 0, ref, tc.off, tc.stride) })
+			mustPanic(func() { tc.fn(dst, 0, ref[:len(ref)-1:len(ref)-1], tc.off, tc.stride) })
+		})
+	}
+}
diff --git a/pkg/h264/internal/encoder/quant_max_avx2_amd64_test.go b/pkg/h264/internal/encoder/quant_max_avx2_amd64_test.go
new file mode 100644
index 0000000..9fcf312
--- /dev/null
+++ b/pkg/h264/internal/encoder/quant_max_avx2_amd64_test.go
@@ -0,0 +1,148 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"math/rand/v2"
+	"testing"
+
+	"golang.org/x/sys/cpu"
+)
+
+func TestQuantMaxAVX2MatchesSSE2(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 unavailable")
+	}
+	rng := rand.New(rand.NewPCG(264, 464))
+	edges := [...]int16{-32768, -32767, -1, 0, 1, 16383, 16384, 32766, 32767}
+	for fixture := range 1024 {
+		var gotDCT [68]int16
+		var gotMax [8]int16
+		var ff, mf [8]int16
+		for i := range gotDCT {
+			gotDCT[i] = -12345
+		}
+		for i := range gotMax {
+			gotMax[i] = -23456
+		}
+		for i := range 64 {
+			// Across fixtures, every signed int16 value reaches the kernel.
+			gotDCT[i+1] = int16(fixture*64 + i)
+		}
+		for i := range ff {
+			switch fixture % 4 {
+			case 0:
+				ff[i], mf[i] = g_kiQuantInterFF[fixture%52][i], g_kiQuantMF[fixture%52][i]
+			case 1:
+				// Preserve the historical SSE2 bit patterns even outside the
+				// nonnegative FF/MF domain shared with the scalar quantizer.
+				ff[i], mf[i] = int16(rng.Uint32()), int16(rng.Uint32())
+			case 2:
+				ff[i], mf[i] = edges[(fixture+i)%len(edges)], edges[(fixture/4+i)%len(edges)]
+			case 3:
+				ff[i], mf[i] = 20000, -1
+			}
+		}
+		wantDCT, wantMax := gotDCT, gotMax
+		beforeFF, beforeMF := ff, mf
+		quantFour4x4MaxSSE2(wantDCT[1:65], ff[:], mf[:], wantMax[1:5])
+		quantFour4x4MaxAVX2((*[64]int16)(gotDCT[1:65]), &ff, &mf, (*[4]int16)(gotMax[1:5]))
+		if gotDCT != wantDCT || gotMax != wantMax || ff != beforeFF || mf != beforeMF {
+			t.Fatalf("fixture%d: coefficients, maxima, tables or canaries differ", fixture)
+		}
+	}
+}
+
+func TestQuantMaxAVX2ZeroAndSignedMaxima(t *testing.T) {
+	if !cpu.X86.HasAVX2 {
+		t.Skip("AVX2 unavailable")
+	}
+	for _, rounding := range []int16{20000, 32767, -1} {
+		for _, multiplier := range []int16{32767, -1} {
+			var ff, mf [8]int16
+			for i := range ff {
+				ff[i], mf[i] = rounding, multiplier
+			}
+			// Zero coefficients can round to nonzero values. Large unsigned
+			// magnitudes can also be negative as signed words, making the
+			// block maximum zero even though its output is nonzero.
+			var got [64]int16
+			for i := 16; i < 32; i++ {
+				got[i] = 32767
+				got[i+16] = -32768
+			}
+			for i := 48; i < 64; i++ {
+				got[i] = int16(1 - 2*(i&1))
+			}
+			want := got
+			var gotMax, wantMax [4]int16
+			quantFour4x4MaxSSE2(want[:], ff[:], mf[:], wantMax[:])
+			quantFour4x4MaxAVX2(&got, &ff, &mf, &gotMax)
+			if got != want || gotMax != wantMax {
+				t.Fatalf("FF%d MF%d: zero sign or signed maximum differs", rounding, multiplier)
+			}
+		}
+	}
+}
+
+func TestQuantMaxCheckedQPAndCoefficientDomain(t *testing.T) {
+	for qp := range 52 {
+		ff, mf := g_kiQuantInterFF[qp], g_kiQuantMF[qp]
+		for fixture := range 1024 {
+			var input [64]int16
+			for i := range input {
+				input[i] = int16(fixture*64 + i)
+			}
+			got, want := input, input
+			var gotMax, wantMax [4]int16
+			WelsQuantFour4x4Max_c(want[:], ff[:], mf[:], wantMax[:])
+			WelsQuantFour4x4Max_sse2(got[:], ff[:], mf[:], gotMax[:])
+			if got != want || gotMax != wantMax {
+				t.Fatalf("QP%d fixture%d: coefficients or maxima differ", qp, fixture)
+			}
+		}
+	}
+}
+
+func TestQuantMaxCheckedAliases(t *testing.T) {
+	// Coefficients occupy words 32..95. Include maxima before, inside, across,
+	// and immediately after that span, with FF/MF also aliasing either output.
+	for _, maxOffset := range []int{0, 28, 29, 31, 32, 33, 47, 48, 63, 64, 79, 80, 93, 95, 96, 97, 120} {
+		for _, ffOffset := range []int{0, 32, 33, 95, 100} {
+			for _, mfOffset := range []int{8, 40, 89, 104} {
+				var got [132]int16
+				for i := range got {
+					got[i] = int16(i*1701 + 13)
+				}
+				want := got
+				quantFour4x4MaxSSE2(want[32:96], want[ffOffset:ffOffset+8], want[mfOffset:mfOffset+8], want[maxOffset:maxOffset+4])
+				WelsQuantFour4x4Max_sse2(got[32:96], got[ffOffset:ffOffset+8], got[mfOffset:mfOffset+8], got[maxOffset:maxOffset+4])
+				if got != want {
+					t.Fatalf("max%d FF%d MF%d: original SSE2 alias semantics changed", maxOffset, ffOffset, mfOffset)
+				}
+			}
+		}
+	}
+}
+
+func TestQuantMaxCheckedBounds(t *testing.T) {
+	for argument, limit := range []int{64, 8, 8, 4} {
+		for length := 0; length < limit; length++ {
+			var storage [84]int16
+			for i := range storage {
+				storage[i] = int16(i*1701 + 13)
+			}
+			before := storage
+			args := [4][]int16{storage[:64], storage[64:72], storage[72:80], storage[80:84]}
+			args[argument] = args[argument][:length]
+			panicked := false
+			func() {
+				defer func() { panicked = recover() != nil }()
+				WelsQuantFour4x4Max_sse2(args[0], args[1], args[2], args[3])
+			}()
+			if !panicked || storage != before {
+				t.Fatalf("argument%d length%d: expected bounds panic before any writes", argument, length)
+			}
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/quant_max_bench_amd64_test.go b/pkg/h264/internal/encoder/quant_max_bench_amd64_test.go
