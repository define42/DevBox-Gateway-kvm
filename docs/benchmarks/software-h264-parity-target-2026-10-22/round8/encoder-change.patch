@@ -0,0 +1,63 @@
+package encoder
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+// Benchmark complete sequences of residual blocks, keeping pending bits between
+// blocks as the frame writer does. The same benchmark file runs on the unpacked
+// baseline; it does not depend on the table's representation.
+func BenchmarkCavlcLevelWriter(b *testing.B) {
+	patterns := []struct {
+		name   string
+		values [16]int16
+	}{
+		{"small", [16]int16{2, -2, 3, -3, 6, -6, 12, -12, 24, -24, 48, -48, 2, -4, 8, -16}},
+		{"boundary", [16]int16{63, -64, 64, -65, 62, -63, 65, -66, 63, -64, 64, -65, 62, -63, 65, -66}},
+		{"mixed", [16]int16{2, -3, 4, -7, 12, -13, 24, -25, 48, -49, 63, -64, 64, -65, 511, -1023}},
+	}
+	for _, end := range []int32{14, 15} {
+		for _, density := range []struct {
+			name   string
+			stride int32
+		}{{"medium", 2}, {"dense", 1}} {
+			for _, pattern := range patterns {
+				b.Run(fmt.Sprintf("end%d/%s/%s", end, density.name, pattern.name), func(b *testing.B) {
+					var blocks [16][16]int16
+					for block := range blocks {
+						for index := int32(0); index <= end; index += density.stride {
+							blocks[block][index] = pattern.values[(int(index)+block)%len(pattern.values)]
+						}
+						for i := 0; i < block%4; i++ {
+							blocks[block][int(end)-i] = int16(1 - 2*(i&1))
+						}
+					}
+					var functions SWelsFuncPtrList
+					var buffer [4096]byte
+					var bits common.SBitStringAux
+					property := int32(LUMA_4x4)
+					if end == 14 {
+						property = int32(LUMA_AC)
+					}
+					common.InitBits(&bits, buffer[:], 0, int32(len(buffer)))
+					for block := range blocks {
+						if result := WriteBlockResidualCavlc(&functions, blocks[block][:], end, 1, property, int8(block), &bits); result != ENC_RETURN_SUCCESS {
+							b.Fatalf("fixture block%d: result%d", block, result)
+						}
+					}
+					b.ReportAllocs()
+					for b.Loop() {
+						common.InitBits(&bits, buffer[:], 0, int32(len(buffer)))
+						for block := range blocks {
+							WriteBlockResidualCavlc(&functions, blocks[block][:], end, 1, property, int8(block), &bits)
+						}
+					}
+					b.ReportMetric(float64(len(blocks)), "blocks/op")
+				})
+			}
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/cavlc_packed_test.go b/pkg/h264/internal/encoder/cavlc_packed_test.go
new file mode 100644
index 0000000..b087247
--- /dev/null
+++ b/pkg/h264/internal/encoder/cavlc_packed_test.go
@@ -0,0 +1,159 @@
+package encoder
+
+import (
+	"bytes"
+	"fmt"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+func TestCavlcPackedLevelTable(t *testing.T) {
+	for adjustment := range cavlcLevelTable {
+		for suffix := 0; suffix < 7; suffix++ {
+			for index, packed := range cavlcLevelTable[adjustment][suffix] {
+				value := int32(index - cavlcLevelLimit)
+				if value == 0 || (adjustment != 0 && (value == 1 || value == -1)) {
+					if packed != 0 {
+						t.Fatalf("unused entry adjustment%d suffix%d value%d: %#x", adjustment, suffix, value, packed)
+					}
+					continue
+				}
+				want, ok := cavlcLevelSymbolSlow(value, int32(suffix), adjustment != 0)
+				got := cavlcLevelSymbol{code: packed & 0xffff, length: uint8(packed >> 16), nextSuffix: uint8(packed >> 24)}
+				if !ok || got != want {
+					t.Fatalf("adjustment%d suffix%d value%d: %+v want %+v, valid=%t", adjustment, suffix, value, got, want, ok)
+				}
+			}
+		}
+		if cavlcLevelTable[adjustment][7] != [2 * cavlcLevelLimit]uint32{} {
+			t.Fatalf("adjustment%d: padding suffix row must remain unused", adjustment)
+		}
+	}
+}
+
+// The packed writer also passes successful escape results through the same
+// word layout. Exhaust all signed coefficient values and every internal suffix
+// to check the packing bounds and the invariant behind the suffix index mask.
+func TestCavlcPackedLevelDomain(t *testing.T) {
+	for adjustment := 0; adjustment <= 1; adjustment++ {
+		for suffix := int32(0); suffix <= 6; suffix++ {
+			for value := int32(-32768); value <= 32767; value++ {
+				if value == 0 || (adjustment != 0 && (value == 1 || value == -1)) {
+					continue
+				}
+				symbol, ok := cavlcLevelSymbolSlow(value, suffix, adjustment != 0)
+				if !ok {
+					continue
+				}
+				if symbol.code >= 1<<13 || symbol.length > 28 || symbol.nextSuffix > 6 {
+					t.Fatalf("packing bounds adjustment%d suffix%d value%d: %+v", adjustment, suffix, value, symbol)
+				}
+				packed := packCavlcLevelSymbol(symbol)
+				if packed&0xffff != symbol.code || uint8(packed>>16) != symbol.length || uint8(packed>>24) != symbol.nextSuffix {
+					t.Fatalf("packing loses bits adjustment%d suffix%d value%d: %+v to %#x", adjustment, suffix, value, symbol, packed)
+				}
+			}
+		}
+	}
+}
+
+func TestCavlcPackedWriterTransitions(t *testing.T) {
+	patterns := [][16]int16{
+		{2, -2, 3, -3, 6, -6, 12, -12, 24, -24, 48, -48, 96, -96, 192, -192},
+		{63, -64, 64, -65, 62, -63, 65, -66, 3, -4, 6, -7, 12, -13, 24, -25},
+		{32767, -32768, 2, -3, 6, -7, 12, -13, 24, -25, 48, -49, 63, -64, 64, -65},
+	}
+	var functions SWelsFuncPtrList
+	for _, end := range []int32{3, 14, 15} {
+		property, nc := int32(LUMA_4x4), int8(3)
+		if end == 3 {
+			property, nc = int32(CHROMA_DC), CHROMA_DC_NC_OFFSET
+		} else if end == 14 {
+			property = int32(LUMA_AC)
+		}
+		for _, stride := range []int32{1, 2} {
+			for _, pattern := range patterns {
+				for trailing := int32(0); trailing <= 3; trailing++ {
+					var coefficients [16]int16
+					for index := int32(0); index <= end; index += stride {
+						coefficients[index] = pattern[index]
+					}
+					for i := int32(0); i < trailing; i++ {
+						coefficients[end-i] = int16(1 - 2*(i&1))
+					}
+					for prefix := 0; prefix < 32; prefix++ {
+						assertCavlcWriterParity(t, &functions, coefficients[:], end, 1, property, nc, prefix)
+						// End 14 with an exact-length input exercises scalar extraction
+						// as well as the full-length SIMD input above.
+						if end == 14 {
+							assertCavlcWriterParity(t, &functions, coefficients[:15], end, 1, property, nc, prefix)
+						}
+					}
+				}
+			}
+		}
+	}
+}
+
+// Only the internally produced suffix is masked. Invalid external indices and
+// partial output failures must keep their existing panic and writer state.
+func TestCavlcPackedWriterFailureParity(t *testing.T) {
+	coefficients := []int16{63, -64, 64, -65, 2, -3, 6, -7, 12, -13, 24, -25, 48, -49, 511, -1023, 2}
+	type failureCase struct {
+		name   string
+		length int
+		end    int32
+		flag   int32
+		nc     int8
+		output int
+	}
+	cases := []failureCase{
+		{"negative-nc", 16, 15, 1, -1, 512},
+		{"large-nc", 16, 15, 1, 18, 512},
+		{"short-input", 15, 15, 1, 3, 512},
+		{"too-many-coefficients", 17, 16, 1, 3, 512},
+		{"negative-end", 16, -1, 1, 3, 512},
+		{"ignored-input", 0, 100, 0, 3, 512},
+		{"ignored-input-invalid-nc", 0, 100, 0, -1, 512},
+	}
+	for size := 0; size < 12; size++ {
+		cases = append(cases, failureCase{fmt.Sprintf("short-output-%d", size), 16, 15, 1, 3, size})
+	}
+	var functions SWelsFuncPtrList
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			for prefix := 0; prefix < 32; prefix++ {
+				gotBuffer := bytes.Repeat([]byte{0xa5}, test.output)
+				wantBuffer := bytes.Clone(gotBuffer)
+				var gotBits, wantBits common.SBitStringAux
+				common.InitBits(&gotBits, gotBuffer, 0, int32(test.output))
+				common.InitBits(&wantBits, wantBuffer, 0, int32(test.output))
+				if prefix != 0 {
+					value := uint32((uint64(1) << uint(prefix)) - 1)
+					common.BsWriteBits(&gotBits, int32(prefix), value)
+					common.BsWriteBits(&wantBits, int32(prefix), value)
+				}
+				gotResult, gotPanic := cavlcPackedCallResult(func() int32 {
+					return WriteBlockResidualCavlc(&functions, coefficients[:test.length], test.end, test.flag, int32(LUMA_4x4), test.nc, &gotBits)
+				})
+				wantResult, wantPanic := cavlcPackedCallResult(func() int32 {
+					return writeBlockResidualCavlcReference(&functions, coefficients[:test.length], test.end, test.flag, int32(LUMA_4x4), test.nc, &wantBits)
+				})
+				if gotResult != wantResult || gotPanic != wantPanic || gotBits.PCurBuf != wantBits.PCurBuf || gotBits.UiCurBits != wantBits.UiCurBits || gotBits.ILeftBits != wantBits.ILeftBits || !bytes.Equal(gotBuffer, wantBuffer) {
+					t.Fatalf("prefix%d: return%d/%d panic%q/%q cursor%d/%d bits%x/%x left%d/%d output%x/%x", prefix, gotResult, wantResult, gotPanic, wantPanic, gotBits.PCurBuf, wantBits.PCurBuf, gotBits.UiCurBits, wantBits.UiCurBits, gotBits.ILeftBits, wantBits.ILeftBits, gotBuffer, wantBuffer)
+				}
+			}
+		})
+	}
+}
+
+func cavlcPackedCallResult(call func() int32) (result int32, panicText string) {
+	defer func() {
+		if value := recover(); value != nil {
+			panicText = fmt.Sprintf("%T: %v", value, value)
+		}
+	}()
+	result = call()
+	return result, ""
+}
diff --git a/pkg/h264/internal/encoder/cavlc_zero_test.go b/pkg/h264/internal/encoder/cavlc_zero_test.go
new file mode 100644
index 0000000..ee058ca
--- /dev/null
+++ b/pkg/h264/internal/encoder/cavlc_zero_test.go
@@ -0,0 +1,92 @@
+package encoder
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+	"unsafe"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+type cavlcZeroWriter func(*SWelsFuncPtrList, []int16, int32, int32, int32, int8, *common.SBitStringAux) int32
+
+func observeCavlcZero(writer cavlcZeroWriter, coeff []int16, end, property int32, nc int8, bits *common.SBitStringAux) (result int32, failure string) {
+	defer func() {
+		if value := recover(); value != nil {
+			failure = fmt.Sprintf("%T: %v", value, value)
+		}
+	}()
+	result = writer(nil, coeff, end, 0, property, nc, bits)
+	return
+}
+
+// Known-zero calls must not inspect coefficients/end/property, and must retain
+// the original writer-before-nC panic order. The reference is the independent
+// pre-optimization arithmetic writer, not a duplicate of the new early branch.
+func TestCavlcKnownZeroStateAndFailures(t *testing.T) {
+	for _, nc := range []int8{-128, -1, 0, 1, 2, 3, 4, 7, 8, 16, 17, 18, 127} {
+		got, gotFailure := observeCavlcZero(WriteBlockResidualCavlc, nil, -1, -1, nc, nil)
+		want, wantFailure := observeCavlcZero(writeBlockResidualCavlcReference, nil, -1, -1, nc, nil)
+		if got != want || gotFailure != wantFailure || gotFailure == "" {
+			t.Fatalf("nil writer nC%d: got %d/%q want %d/%q", nc, got, gotFailure, want, wantFailure)
+		}
+	}
+
+	for _, nc := range []int8{-1, 0, 1, 2, 3, 4, 7, 8, 16, 17, 18, 127} {
+		for _, left := range []int32{-1 << 31, -3, 0, 1, 4, 8, 17, 31, 32, 64, 1<<31 - 1} {
+			for length := 0; length <= 9; length++ {
+				for _, cursor := range []int{-1, 0, 3, 7} {
+					var gotBuffer, wantBuffer [16]byte
+					for i := range gotBuffer {
+						gotBuffer[i], wantBuffer[i] = 0xa5, 0xa5
+					}
+					gotBits := common.SBitStringAux{
+						PBuf: gotBuffer[:length], PCurBuf: cursor, PStartBuf: 17, PEndBuf: -12,
+						UiCurBits: 0x8d23f9ab, ILeftBits: left, IBits: 1234, IIndex: -17,
+					}
+					wantBits := gotBits
+					wantBits.PBuf = wantBuffer[:length]
+					// Nonzero input and invalid metadata must be ignored with flag0.
+					coeff := [1]int16{-32768}
+					got, gotFailure := observeCavlcZero(WriteBlockResidualCavlc, coeff[:], 1<<31-1, -1, nc, &gotBits)
+					want, wantFailure := observeCavlcZero(writeBlockResidualCavlcReference, coeff[:], 1<<31-1, -1, nc, &wantBits)
+					if got != want || gotFailure != wantFailure || gotBuffer != wantBuffer ||
+						!reflect.DeepEqual(gotBits, wantBits) || cap(gotBits.PBuf) != cap(wantBits.PBuf) || coeff[0] != -32768 {
+						t.Fatalf("nC%d left%d length%d cursor%d: got %d/%q %+v want %d/%q %+v, output parity=%t",
+							nc, left, length, cursor, got, gotFailure, gotBits, want, wantFailure, wantBits, gotBuffer == wantBuffer)
+					}
+				}
+			}
+		}
+	}
+}
+
+// A caller can provide a byte view of the writer's scalar state as output.
+// Snapshotting local state before flush must preserve partial writes on panic
+// and the final commit order even when those writes overwrite live fields.
+func TestCavlcKnownZeroAliasedWriterState(t *testing.T) {
+	span := int(unsafe.Sizeof(common.SBitStringAux{}.PCurBuf)) + 8
+	for _, nc := range []int8{0, 2, 4, 8, 17} {
+		for _, left := range []int32{-3, 0, 1, 4, 17, 32} {
+			for length := 0; length <= span; length++ {
+				for _, cursor := range []int{0, 3, 7, span - 4} {
+					gotBits := common.SBitStringAux{
+						PCurBuf: cursor, PStartBuf: 19, PEndBuf: -11,
+						UiCurBits: 0x8d23f9ab, ILeftBits: left, IBits: 1234, IIndex: -17,
+					}
+					wantBits := gotBits
+					gotBits.PBuf = unsafe.Slice((*byte)(unsafe.Pointer(&gotBits.PCurBuf)), span)[:length]
+					wantBits.PBuf = unsafe.Slice((*byte)(unsafe.Pointer(&wantBits.PCurBuf)), span)[:length]
+					got, gotFailure := observeCavlcZero(WriteBlockResidualCavlc, nil, -1, -1, nc, &gotBits)
+					want, wantFailure := observeCavlcZero(writeBlockResidualCavlcReference, nil, -1, -1, nc, &wantBits)
+					if got != want || gotFailure != wantFailure || !reflect.DeepEqual(gotBits, wantBits) ||
+						cap(gotBits.PBuf) != cap(wantBits.PBuf) {
+						t.Fatalf("aliased nC%d left%d length%d cursor%d: got %d/%q %+v want %d/%q %+v",
+							nc, left, length, cursor, got, gotFailure, gotBits, want, wantFailure, wantBits)
+					}
+				}
+			}
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/chroma_decision_reference_test.go b/pkg/h264/internal/encoder/chroma_decision_reference_test.go
new file mode 100644
index 0000000..aae34f0
--- /dev/null
+++ b/pkg/h264/internal/encoder/chroma_decision_reference_test.go
@@ -0,0 +1,88 @@
+package encoder
+
+// Frozen before the chroma decision simplification. Keep the original fused
+// quantize/scan stage for exact alias and malformed-buffer write ordering.
+import (
+	"math"
+	"math/bits"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+func chromaDecisionFrozen(pFuncList *SWelsFuncPtrList, pCurMb *SMB, pMbCache *SMbCache, pRes []int16, iUV int32) {
+	pfSetMemZeroSize64 := pFuncList.pfSetMemZeroSize64
+	pfDequantizationFour4x4 := pFuncList.pfDequantizationFour4x4
+	kiInterFlag := int32(0)
+	if !common.IS_INTRA(pCurMb.uiMbType) {
+		kiInterFlag = 1
+	}
+	kiQp := pCurMb.uiChromaQp
+	var uiNoneZeroCount, uiNoneZeroCountMbDc uint8
+	uiNoneZeroCountOffset := int((iUV - 1) << 1)   //UV==1 or 2
+	uiSubMbIdx := int(16 + ((iUV - 1) << 2))       //uiSubMbIdx == 16 or 20
+	iChromaDc := pMbCache.pDct.iChromaDc[iUV-1][:] //
+	pBlock := pMbCache.pDct.iChromaBlock[((iUV-1)<<2)*16:]
+	var aDct2x2, aMax [4]int16
+	var masks [4]uint16
+	iSingleCtr8x8 := int32(0)
+	pMF := g_kiQuantMF[kiQp][:]
+	iIntraFlag := int32(0)
+	if kiInterFlag == 0 {
+		iIntraFlag = 1
+	}
+	pFF := g_kiQuantInterFF[iIntraFlag*6+int32(kiQp)][:]
+
+	uiNoneZeroCountMbDc = uint8(hadamardQuant2x2(pRes, int16(int32(pFF[0])<<1), pMF[0]>>1, aDct2x2[:], iChromaDc))
+
+	quantScanFour4x4(pRes, pBlock, pFF, pMF, aMax[:], masks[:], true)
+
+	iResOff := 0
+	iBlockOff := 0
+	for j := 0; j < 4; j++ {
+		if aMax[j] != 0 {
+			mask := masks[j]
+			if kiInterFlag != 0 {
+				if aMax[j] > 1 {
+					iSingleCtr8x8 += 9
+				} else if iSingleCtr8x8 < 7 {
+					iSingleCtr8x8 += coefficientScoreMask(mask)
+				}
+			} else {
+				iSingleCtr8x8 = math.MaxInt32
+			}
+		}
+		iResOff += 16
+		iBlockOff += 16
+	}
+	iResOff -= 64
+
+	if iSingleCtr8x8 < 7 { //from JVT-O079
+		pfSetMemZeroSize64(pRes[iResOff:], 128) // confirmed_safe_unsafe_usage
+		pCurMb.pNonZeroCount[16+uiNoneZeroCountOffset] = 0
+		pCurMb.pNonZeroCount[16+uiNoneZeroCountOffset+1] = 0
+		pCurMb.pNonZeroCount[20+uiNoneZeroCountOffset] = 0
+		pCurMb.pNonZeroCount[20+uiNoneZeroCountOffset+1] = 0
+	} else {
+		kpNoneZeroCountIdx := common.G_kuiMbCountScan4Idx[uiSubMbIdx:]
+		iBlockOff -= 64
+		for i := 0; i < 4; i++ {
+			uiNoneZeroCount = uint8(bits.OnesCount16(masks[i]))
+			pCurMb.pNonZeroCount[kpNoneZeroCountIdx[i]] = int8(uiNoneZeroCount)
+			iBlockOff += 16
+		}
+		pfDequantizationFour4x4(pRes[iResOff:], common.G_kuiDequantCoeff[pCurMb.uiChromaQp][:])
+		pCurMb.uiCbp &= 0x0F
+		pCurMb.uiCbp |= 0x20
+	}
+
+	if uiNoneZeroCountMbDc > 0 {
+		WelsDequantIHadamard2x2Dc(aDct2x2[:], common.G_kuiDequantCoeff[kiQp][0])
+		if 2 != (pCurMb.uiCbp >> 4) {
+			pCurMb.uiCbp |= (0x01 << 4)
+		}
+		pRes[iResOff+0] = aDct2x2[0]
+		pRes[iResOff+16] = aDct2x2[1]
+		pRes[iResOff+32] = aDct2x2[2]
+		pRes[iResOff+48] = aDct2x2[3]
+	}
+}
diff --git a/pkg/h264/internal/encoder/chroma_decision_test.go b/pkg/h264/internal/encoder/chroma_decision_test.go
new file mode 100644
index 0000000..d898cb1
--- /dev/null
+++ b/pkg/h264/internal/encoder/chroma_decision_test.go
@@ -0,0 +1,272 @@
+package encoder
+
+import (
+	"fmt"
+	"math/rand"
+	"reflect"
+	"slices"
+	"testing"
+	"unsafe"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+type chromaDecisionEvent struct {
+	kind             byte
+	length, capacity int
+	size             int32
+	cbp, qp          uint8
+	counts           [24]int8
+	residual         [64]int16
+	factors          [8]uint16
+}
+
+type chromaDecisionState struct {
+	backing                 [1024]int16
+	residual, alternate     [80]int16
+	dct, alternateDCT       SDCTCoeff
+	counts, alternateCounts [32]int8
+	mb                      SMB
+	cache                   SMbCache
+	functions               SWelsFuncPtrList
+	res                     []int16
+	events                  []chromaDecisionEvent
+}
+
+func newChromaDecisionState(input [80]int16, qp, cbp uint8, intra bool, mutation int) *chromaDecisionState {
+	s := &chromaDecisionState{residual: input}
+	for i := range s.dct.iLumaBlock {
+		s.dct.iLumaBlock[i] = int16(3000 + i)
+	}
+	for i := range s.dct.iChromaBlock {
+		s.dct.iChromaBlock[i] = int16(-7000 - i)
+	}
+	s.dct.iChromaDc = [2][4]int16{{11, 13, 17, 19}, {23, 29, 31, 37}}
+	s.alternateDCT = s.dct
+	for i := range s.counts {
+		s.counts[i], s.alternateCounts[i] = int8(i+17), int8(i+71)
+	}
+	for i := range s.alternate {
+		s.alternate[i] = int16(1000 + i)
+	}
+	s.res = s.residual[:64]
+	s.mb = SMB{uiMbType: common.MB_TYPE_16x16, uiChromaQp: qp, uiLumaQp: 23, uiCbp: cbp, pNonZeroCount: s.counts[:24]}
+	if intra {
+		s.mb.uiMbType = common.MB_TYPE_INTRA16x16
+	}
+	s.cache = SMbCache{pCoeffLevel: s.res, pDct: &s.dct}
+	WelsInitEncodingFuncs(&s.functions, 0)
+	WelsInitReconstructionFuncs(&s.functions, 0)
+	s.functions.pfGetNoneZeroCount = WelsGetNoneZeroCount_c
+	record := func(kind byte, data []int16, size int32, factors []uint16) {
+		event := chromaDecisionEvent{kind: kind, length: len(data), capacity: cap(data), size: size, cbp: s.mb.uiCbp, qp: s.mb.uiChromaQp}
+		copy(event.counts[:], s.mb.pNonZeroCount)
+		copy(event.residual[:], data)
+		copy(event.factors[:], factors)
+		s.events = append(s.events, event)
+	}
+	mutate := func(data []int16) {
+		if mutation == 0 {
+			return
+		}
+		data[1] ^= 0x123
+		data[63] ^= 0x321
+		if mutation == 2 {
+			panic("chroma decision callback")
+		}
+		s.mb.uiCbp ^= 0xc0
+		s.mb.uiChromaQp = 255 // DC reconstruction must retain the entry QP.
+		s.mb.uiMbType = common.MB_TYPE_SKIP
+		s.mb.pNonZeroCount = s.alternateCounts[:24]
+		if mutation == 3 {
+			s.mb.pNonZeroCount = s.alternateCounts[:18]
+		}
+		s.cache.pCoeffLevel, s.cache.pDct = s.alternate[:], &s.alternateDCT
+	}
+	s.functions.pfSetMemZeroSize64 = func(data []int16, size int32) {
+		record('z', data, size, nil)
+		WelsSetMemZero_c(data, size)
+		mutate(data)
+	}
+	s.functions.pfDequantizationFour4x4 = func(data []int16, factors []uint16) {
+		record('d', data, 128, factors)
+		WelsDequantFour4x4_c(data, factors)
+		mutate(data)
+	}
+	return s
+}
+
+type chromaDecisionWriter func(*SWelsFuncPtrList, *SMB, *SMbCache, []int16, int32)
+
+func callChromaDecision(fn chromaDecisionWriter, s *chromaDecisionState, uv int32) (failure string) {
+	defer func() {
+		if value := recover(); value != nil {
+			failure = fmt.Sprintf("%T: %v", value, value)
+		}
+	}()
+	fn(&s.functions, &s.mb, &s.cache, s.res, uv)
+	return
+}
+
+func compareChromaDecision(t *testing.T, got, want *chromaDecisionState, uv int32, reference chromaDecisionWriter) string {
+	t.Helper()
+	gotPanic, wantPanic := callChromaDecision(WelsEncRecUV, got, uv), callChromaDecision(reference, want, uv)
+	if gotPanic != wantPanic || got.backing != want.backing || got.residual != want.residual || got.alternate != want.alternate ||
+		got.dct != want.dct || got.alternateDCT != want.alternateDCT || got.counts != want.counts || got.alternateCounts != want.alternateCounts ||
+		got.mb.uiCbp != want.mb.uiCbp || got.mb.uiChromaQp != want.mb.uiChromaQp || got.mb.uiLumaQp != want.mb.uiLumaQp || got.mb.uiMbType != want.mb.uiMbType ||
+		!reflect.DeepEqual(got.events, want.events) || !slices.Equal(got.mb.pNonZeroCount, want.mb.pNonZeroCount) || cap(got.mb.pNonZeroCount) != cap(want.mb.pNonZeroCount) ||
+		!slices.Equal(got.cache.pCoeffLevel, want.cache.pCoeffLevel) || cap(got.cache.pCoeffLevel) != cap(want.cache.pCoeffLevel) ||
+		(got.cache.pDct == &got.alternateDCT) != (want.cache.pDct == &want.alternateDCT) {
+		t.Fatalf("UV%d state/trace mismatch: panic=%q/%q CBP=%#x/%#x events=%v/%v", uv, gotPanic, wantPanic, got.mb.uiCbp, want.mb.uiCbp, got.events, want.events)
+	}
+	return gotPanic
+}
+
+func chromaDecisionUnitInput(t *testing.T, qp, index, level int, intra bool) int16 {
+	t.Helper()
+	ffQP := qp
+	if intra {
+		ffQP += 6
+	}
+	ff, mf := int(g_kiQuantInterFF[ffQP][index&7]), int(g_kiQuantMF[qp][index&7])
+	value := (level*65536+mf-1)/mf - ff
+	if value < 0 || value > 32767 || int(wels_NEW_QUANT(int16(value), int16(ff), int16(mf))) != level {
+		t.Fatalf("cannot construct QP%d index%d level%d intra%t", qp, index, level, intra)
+	}
+	return int16(value)
+}
+
+func TestChromaDecisionThresholdParity(t *testing.T) {
+	// AC scan positions, independently listed from the production mask path.
+	scan := [...]int{1, 4, 8, 5, 2, 3, 6, 9, 12, 13, 10, 7, 11, 14, 15}
+	masks := [...]uint16{0, 1 << 3, 1 << 1, 1, 1 | 1<<4, 1 | 1<<2, 3, 3 | 1<<6}
+	for qp := range 52 {
+		for _, scores := range [][4]int{{0, 0, 0, 0}, {6, 0, 0, 0}, {6, 1, 0, 0}, {5, 1, 0, 0}, {5, 2, 0, 0}, {0, 6, 0, 1}, {7, 6, 5, 4}} {
+			for _, intra := range []bool{false, true} {
+				for _, dc := range []bool{false, true} {
+					t.Run(fmt.Sprintf("QP%d/scores%v/intra%t/DC%t", qp, scores, intra, dc), func(t *testing.T) {
+						var input [80]int16
+						for block, score := range scores {
+							for position, index := range scan {
+								if masks[score]&(1<<position) != 0 {
+									input[block*16+index] = chromaDecisionUnitInput(t, qp, index, 1, intra)
+									if (block+position)&1 != 0 {
+										input[block*16+index] = -input[block*16+index]
+									}
+								}
+							}
+							if dc {
+								input[block*16] = [...]int16{2047, -1023, 511, -511}[block]
+							}
+						}
+						for uv := int32(1); uv <= 2; uv++ {
+							cbp := [...]uint8{0, 0x10, 0x2f, 0xe5}[(qp+int(uv))&3]
+							got := newChromaDecisionState(input, uint8(qp), cbp, intra, 0)
+							want := newChromaDecisionState(input, uint8(qp), cbp, intra, 0)
+							if failure := compareChromaDecision(t, got, want, uv, coefficientUVReference); failure != "" {
+								t.Fatalf("valid threshold fixture panicked: %s", failure)
+							}
+						}
+					})
+				}
+			}
+		}
+	}
+}
+
+func TestChromaDecisionRandomAndCallbacks(t *testing.T) {
+	rng := rand.New(rand.NewSource(0x2648c))
+	for qp := range 52 {
+		for fixture := range 12 {
+			var input [80]int16
+			for i := range input {
+				switch fixture % 4 {
+				case 0:
+					input[i] = int16(rng.Uint32())
+				case 1:
+					input[i] = [...]int16{-32768, -32767, -1, 0, 1, 32766, 32767}[rng.Intn(7)]
+				case 2:
+					if i%17 == 0 {
+						input[i] = int16(rng.Intn(33) - 16)
+					}
+				}
+			}
+			for uv := int32(1); uv <= 2; uv++ {
+				for mutation := range 4 {
+					got := newChromaDecisionState(input, uint8(qp), uint8(fixture*37), fixture&1 != 0, mutation)
+					want := newChromaDecisionState(input, uint8(qp), uint8(fixture*37), fixture&1 != 0, mutation)
+					compareChromaDecision(t, got, want, uv, chromaDecisionFrozen)
+				}
+			}
+		}
+	}
+}
+
+func TestChromaDecisionAliasParity(t *testing.T) {
+	for _, qp := range []uint8{0, 20, 32, 51} {
+		for uv := int32(1); uv <= 2; uv++ {
+			for _, shift := range []int{-32, 0, 8, 32, 64} {
+				for _, countsOffset := range []int{-1, 0, 30, 120} {
+					for _, mutation := range []int{0, 1, 3} {
+						setup := func() *chromaDecisionState {
+							s := newChromaDecisionState([80]int16{}, qp, 0xa5, shift&8 != 0, mutation)
+							for i := range s.backing {
+								s.backing[i] = int16(i*713 + int(qp)*37 + 19)
+							}
+							// SDCTCoeff is entirely int16 arrays. Alias the residual
+							// with the current plane's scan storage or adjacent DC.
+							s.cache.pDct = (*SDCTCoeff)(unsafe.Pointer(&s.backing[128]))
+							start := 128 + 272 + int(uv-1)*64 + shift
+							s.res = s.backing[start : start+64]
+							s.cache.pCoeffLevel = s.res
+							if countsOffset >= 0 {
+								s.mb.pNonZeroCount = unsafe.Slice((*int8)(unsafe.Pointer(&s.backing[start])), 160)[countsOffset : countsOffset+24]
+							}
+							return s
+						}
+						got, want := setup(), setup()
+						compareChromaDecision(t, got, want, uv, chromaDecisionFrozen)
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestChromaDecisionMalformedParity(t *testing.T) {
+	for uv := int32(1); uv <= 2; uv++ {
+		for _, keep := range []bool{false, true} {
+			var input [80]int16
+			if keep {
+				for i := range input {
+					input[i] = int16(i*37 + 1000)
+				}
+			}
+			for length := 0; length <= 64; length++ {
+				got, want := newChromaDecisionState(input, 20, 0xa5, false, 0), newChromaDecisionState(input, 20, 0xa5, false, 0)
+				got.res, want.res = got.residual[:length], want.residual[:length]
+				compareChromaDecision(t, got, want, uv, chromaDecisionFrozen)
+			}
+			for length := 0; length <= 24; length++ {
+				got, want := newChromaDecisionState(input, 20, 0xa5, false, 0), newChromaDecisionState(input, 20, 0xa5, false, 0)
+				got.mb.pNonZeroCount, want.mb.pNonZeroCount = got.counts[:length], want.counts[:length]
+				compareChromaDecision(t, got, want, uv, chromaDecisionFrozen)
+			}
+			got, want := newChromaDecisionState(input, 20, 0xa5, false, 0), newChromaDecisionState(input, 20, 0xa5, false, 0)
+			got.functions.pfSetMemZeroSize64, want.functions.pfSetMemZeroSize64 = nil, nil
+			got.functions.pfDequantizationFour4x4, want.functions.pfDequantizationFour4x4 = nil, nil
+			compareChromaDecision(t, got, want, uv, chromaDecisionFrozen)
+		}
+	}
+	for _, uv := range []int32{-1 << 31, -1, 0, 3, 1<<31 - 1} {
+		got, want := newChromaDecisionState([80]int16{}, 20, 0, false, 0), newChromaDecisionState([80]int16{}, 20, 0, false, 0)
+		compareChromaDecision(t, got, want, uv, chromaDecisionFrozen)
+	}
+	for _, qp := range []uint8{52, 255} {
+		got, want := newChromaDecisionState([80]int16{}, qp, 0, false, 0), newChromaDecisionState([80]int16{}, qp, 0, false, 0)
+		compareChromaDecision(t, got, want, 1, chromaDecisionFrozen)
+	}
+	got, want := newChromaDecisionState([80]int16{}, 20, 0, false, 0), newChromaDecisionState([80]int16{}, 20, 0, false, 0)
+	got.cache.pDct, want.cache.pDct = nil, nil
+	compareChromaDecision(t, got, want, 1, chromaDecisionFrozen)
+}
