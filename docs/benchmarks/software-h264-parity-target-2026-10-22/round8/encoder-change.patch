+		b.Skip("AVX2 unavailable")
+	}
+	for _, shape := range [][2]int{{5, 5}, {9, 9}, {17, 17}, {5, 9}, {9, 5}, {9, 17}, {17, 9}, {4, 4}, {8, 8}, {16, 16}} {
