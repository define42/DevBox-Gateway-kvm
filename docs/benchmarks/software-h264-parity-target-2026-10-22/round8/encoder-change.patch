@@ -0,0 +1,55 @@
+package encoder
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+var interLumaBookkeepingBenchmarkSink uint8
+
+// The unchanged public entry and the same residual reset are timed in both
+// trees. Inputs remain representative after every iteration's dequantization.
+func BenchmarkInterLumaBookkeeping(b *testing.B) {
+	for _, qp := range []uint8{20, 32} {
+		for _, content := range []string{"Dense", "Motion", "Sparse", "Zero"} {
+			b.Run(fmt.Sprintf("%s/QP%d", content, qp), func(b *testing.B) {
+				var input, residual [384]int16
+				for i := range input {
+					value := int16((i*1701+13)%2049 - 1024)
+					switch content {
+					case "Motion":
+						if i%7 >= 3 {
+							value = 0
+						}
+					case "Sparse":
+						if i%17 != 0 {
+							value = 0
+						}
+						value /= 8
+					case "Zero":
+						value = 0
+					}
+					input[i] = value
+				}
+				var functions SWelsFuncPtrList
+				flags := common.WelsCPUFeatureDetect(nil)
+				WelsInitEncodingFuncs(&functions, flags)
+				WelsInitReconstructionFuncs(&functions, flags)
+				functions.pfSetMemZeroSize64 = WelsSetMemZero_c
+				var dct SDCTCoeff
+				var nonzero [24]int8
+				mb := SMB{uiLumaQp: qp, pNonZeroCount: nonzero[:]}
+				cache := SMbCache{pCoeffLevel: residual[:], pDct: &dct}
+				b.ReportAllocs()
+				for b.Loop() {
+					residual = input
+					mb.uiCbp = 0x30
+					WelsEncInterY(&functions, &mb, &cache)
+				}
+				interLumaBookkeepingBenchmarkSink = mb.uiCbp
+			})
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/inter_luma_bookkeeping_test.go b/pkg/h264/internal/encoder/inter_luma_bookkeeping_test.go
new file mode 100644
index 0000000..14d7a18
--- /dev/null
+++ b/pkg/h264/internal/encoder/inter_luma_bookkeeping_test.go
@@ -0,0 +1,266 @@
+package encoder
+
+import (
+	"fmt"
+	"math/bits"
+	"math/rand"
+	"reflect"
+	"testing"
+	"unsafe"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+type interLumaCallbackEvent struct {
+	kind     byte
+	offset   int
+	length   int
+	size     int32
+	cbp      uint8
+	counts   [24]int8
+	residual [64]int16
+}
+
+type interLumaBookkeepingState struct {
+	backing         [1024]int16
+	residual        [384]int16
+	dct             SDCTCoeff
+	counts          [32]int8
+	alternateCounts [32]int8
+	mb              SMB
+	cache           SMbCache
+	functions       SWelsFuncPtrList
+	events          []interLumaCallbackEvent
+}
+
+func newInterLumaBookkeepingState(input [384]int16, qp, cbp uint8, mutate bool) *interLumaBookkeepingState {
+	s := &interLumaBookkeepingState{residual: input}
+	for i := range s.dct.iLumaBlock {
+		s.dct.iLumaBlock[i] = -12345
+	}
+	for i := range s.dct.iChromaBlock {
+		s.dct.iChromaBlock[i] = 23456
+	}
+	for i := range s.dct.iLumaI16x16Dc {
+		s.dct.iLumaI16x16Dc[i] = int16(100 + i)
+	}
+	s.dct.iChromaDc = [2][4]int16{{11, 13, 17, 19}, {23, 29, 31, 37}}
+	for i := range s.counts {
+		s.counts[i], s.alternateCounts[i] = int8(17+i), int8(71+i)
+	}
+	s.mb = SMB{uiMbType: common.MB_TYPE_16x16, uiLumaQp: qp, uiChromaQp: 31, uiCbp: cbp, pNonZeroCount: s.counts[:24]}
+	s.cache = SMbCache{pCoeffLevel: s.residual[:], pDct: &s.dct}
+	WelsInitEncodingFuncs(&s.functions, 0)
+	WelsInitReconstructionFuncs(&s.functions, 0)
+	s.functions.pfGetNoneZeroCount = WelsGetNoneZeroCount_c
+	record := func(kind byte, data []int16, size int32) {
+		event := interLumaCallbackEvent{kind: kind, length: len(data), size: size, cbp: s.mb.uiCbp}
+		event.offset = int(uintptr(unsafe.Pointer(&data[0]))-uintptr(unsafe.Pointer(&s.cache.pCoeffLevel[0]))) / 2
+		copy(event.counts[:], s.mb.pNonZeroCount)
+		copy(event.residual[:], data)
+		s.events = append(s.events, event)
+	}
+	mutateState := func() {
+		if mutate && len(s.events) == 1 {
+			s.mb.uiCbp ^= 0x80
+			s.mb.pNonZeroCount = s.alternateCounts[:24]
+			s.cache.pCoeffLevel[192] = 17
+		}
+	}
+	s.functions.pfSetMemZeroSize64 = func(data []int16, size int32) {
+		record('z', data, size)
+		WelsSetMemZero_c(data, size)
+		mutateState()
+	}
+	s.functions.pfDequantizationFour4x4 = func(data []int16, factors []uint16) {
+		record('d', data, 128)
+		WelsDequantFour4x4_c(data, factors)
+		mutateState()
+	}
+	return s
+}
+
+func compareInterLumaBookkeeping(t *testing.T, input [384]int16, qp, cbp uint8, mutate bool) {
+	t.Helper()
+	got := newInterLumaBookkeepingState(input, qp, cbp, mutate)
+	want := newInterLumaBookkeepingState(input, qp, cbp, mutate)
+	WelsEncInterY(&got.functions, &got.mb, &got.cache)
+	// Existing frozen pre-fusion reference independently scans, scores and
+	// counts coefficients instead of using the candidate's masks/bookkeeping.
+	coefficientInterYReference(&want.functions, &want.mb, &want.cache)
+	checkInterLumaBookkeepingStates(t, got, want)
+}
+
+func checkInterLumaBookkeepingStates(t *testing.T, got, want *interLumaBookkeepingState) {
+	t.Helper()
+	if got.backing != want.backing || got.residual != want.residual || got.dct != want.dct || got.counts != want.counts ||
+		got.alternateCounts != want.alternateCounts || got.mb.uiCbp != want.mb.uiCbp ||
+		got.mb.uiLumaQp != want.mb.uiLumaQp || got.mb.uiChromaQp != want.mb.uiChromaQp ||
+		!reflect.DeepEqual(got.events, want.events) {
+		t.Fatalf("state or callback trace differs: CBP=%#x/%#x events=%v/%v", got.mb.uiCbp, want.mb.uiCbp, got.events, want.events)
+	}
+	gotAlternate := &got.mb.pNonZeroCount[0] == &got.alternateCounts[0]
+	wantAlternate := &want.mb.pNonZeroCount[0] == &want.alternateCounts[0]
+	if gotAlternate != wantAlternate {
+		t.Fatal("callback-selected nonzero buffer changed")
+	}
+}
+
+func interLumaUnitInput(t *testing.T, qp, index, level int) int16 {
+	t.Helper()
+	ff, mf := int(g_kiQuantInterFF[qp][index&7]), int(g_kiQuantMF[qp][index&7])
+	value := (level*65536+mf-1)/mf - ff
+	if value < 0 || value > 32767 || int(wels_NEW_QUANT(int16(value), int16(ff), int16(mf))) != level {
+		t.Fatalf("cannot construct QP%d position%d quantized level%d", qp, index, level)
+	}
+	return int16(value)
+}
+
+func TestInterLumaBookkeepingThresholds(t *testing.T) {
+	// A lone block in each group has precisely this run score. Cases straddle
+	// both the macroblock threshold six and the retained-group threshold four.
+	masks := [...]uint16{0, 1 << 3, 1 << 1, 1, 1 | 1<<4, 1 | 1<<2, 3}
+	scan := [...]int{0, 1, 4, 8, 5, 2, 3, 6, 9, 12, 13, 10, 7, 11, 14, 15}
+	for qp := range 52 {
+		for _, scores := range [][4]int{{0, 0, 0, 0}, {3, 2, 0, 0}, {3, 3, 0, 0}, {4, 1, 0, 0}, {4, 2, 0, 0}, {5, 1, 0, 0}, {6, 0, 0, 0}, {1, 4, 5, 6}, {6, 5, 4, 3}} {
+			t.Run(fmt.Sprintf("QP%d/scores%v", qp, scores), func(t *testing.T) {
+				var input [384]int16
+				for i := 256; i < len(input); i++ {
+					input[i] = int16(i*17 + 3)
+				}
+				for group, score := range scores {
+					for position, index := range scan {
+						if masks[score]&(1<<position) != 0 {
+							input[group*64+index] = interLumaUnitInput(t, qp, index, 1)
+							if (group+position)&1 != 0 {
+								input[group*64+index] = -input[group*64+index]
+							}
+						}
+					}
+				}
+				for _, cbp := range []uint8{0, 0x30, 0xa5} {
+					compareInterLumaBookkeeping(t, input, uint8(qp), cbp, false)
+				}
+			})
+		}
+	}
+}
+
+func TestInterLumaBookkeepingRandomAndCallbacks(t *testing.T) {
+	rng := rand.New(rand.NewSource(0x26416))
+	for qp := range 52 {
+		for fixture := range 18 {
+			var input [384]int16
+			for i := range input {
+				switch fixture % 3 {
+				case 0:
+					input[i] = int16(rng.Uint32())
+				case 1:
+					input[i] = [...]int16{-32768, -32767, -1, 0, 1, 32766, 32767}[rng.Intn(7)]
+				case 2:
+					if rng.Intn(4) == 0 {
+						input[i] = int16(rng.Intn(513) - 256)
+					}
+				}
+			}
+			compareInterLumaBookkeeping(t, input, uint8(qp), uint8(fixture*37), fixture&1 != 0)
+		}
+	}
+}
+
+func TestInterLumaBookkeepingAliases(t *testing.T) {
+	for _, qp := range []uint8{0, 20, 32, 51} {
+		for _, shift := range []int{-64, 0, 4, 64} {
+			for _, countsOffset := range []int{-1, 0, 31, 192} {
+				for _, mutate := range []bool{false, true} {
+					t.Run(fmt.Sprintf("QP%d/residual%d/counts%d/mutate%t", qp, shift, countsOffset, mutate), func(t *testing.T) {
+						setup := func() *interLumaBookkeepingState {
+							s := newInterLumaBookkeepingState([384]int16{}, qp, 0x30, mutate)
+							for i := range s.backing {
+								s.backing[i] = int16(i*713 + 19 + int(qp))
+							}
+							// SDCTCoeff contains only int16 arrays. This one backing
+							// allocation deliberately crosses residual/scan boundaries.
+							s.cache.pDct = (*SDCTCoeff)(unsafe.Pointer(&s.backing[256]))
+							s.cache.pCoeffLevel = s.backing[256+shift : 256+shift+384]
+							if countsOffset >= 0 {
+								s.mb.pNonZeroCount = unsafe.Slice((*int8)(unsafe.Pointer(&s.backing[256+countsOffset])), 24)
+							}
+							return s
+						}
+						got, want := setup(), setup()
+						WelsEncInterY(&got.functions, &got.mb, &got.cache)
+						interLumaFrozenBookkeeping(&want.functions, &want.mb, &want.cache)
+						checkInterLumaBookkeepingStates(t, got, want)
+					})
+				}
+			}
+		}
+	}
+}
+
+// Frozen immediately before this bookkeeping change. Unlike the independent
+// pre-fusion reference above, this retains already-established mask semantics
+// when nonzero counts, scanned levels and residuals deliberately alias.
+func interLumaFrozenBookkeeping(pFuncList *SWelsFuncPtrList, pCurMb *SMB, pMbCache *SMbCache) {
+	pfSetMemZeroSize64 := pFuncList.pfSetMemZeroSize64
+	pfDequantizationFour4x4 := pFuncList.pfDequantizationFour4x4
+	pRes := pMbCache.pCoeffLevel
+	iSingleCtrMb := int32(0)
+	var iSingleCtr8x8 [4]int32
+	pBlock := pMbCache.pDct.iLumaBlock[:]
+	uiQp := pCurMb.uiLumaQp
+	pMF := g_kiQuantMF[uiQp][:]
+	pFF := g_kiQuantInterFF[uiQp][:]
+	var aMax [16]int16
+	var masks [16]uint16
+	iNoneZeroCount := int32(0)
+
+	quantScanLuma(pRes, pBlock, pFF, pMF, aMax[:], masks[:])
+
+	iResOff := 0
+	iBlockOff := 0
+	for i := 0; i < 4; i++ {
+		iSingleCtr8x8[i] = 0
+		for j := 0; j < 4; j++ {
+			if aMax[(i<<2)+j] != 0 {
+				mask := masks[(i<<2)+j]
+				if aMax[(i<<2)+j] > 1 {
+					iSingleCtr8x8[i] += 9
+				} else if iSingleCtr8x8[i] < 6 {
+					iSingleCtr8x8[i] += coefficientScoreMask(mask)
+				}
+			}
+			iResOff += 16
+			iBlockOff += 16
+		}
+		iSingleCtrMb += iSingleCtr8x8[i]
+	}
+	iBlockOff -= 256
+	iResOff -= 256
+
+	clear(pCurMb.pNonZeroCount[:16])
+
+	if iSingleCtrMb < 6 { //from JVT-O079
+		pfSetMemZeroSize64(pRes[iResOff:], 768) // confirmed_safe_unsafe_usage
+	} else {
+		kpNoneZeroCountIdx := common.G_kuiMbCountScan4Idx[:]
+		for i := 0; i < 4; i++ {
+			if iSingleCtr8x8[i] >= 4 {
+				for j := 0; j < 4; j++ {
+					iNoneZeroCount = int32(bits.OnesCount16(masks[(i<<2)+j]))
+					pCurMb.pNonZeroCount[kpNoneZeroCountIdx[0]] = int8(iNoneZeroCount)
+					kpNoneZeroCountIdx = kpNoneZeroCountIdx[1:]
+					iBlockOff += 16
+				}
+				pfDequantizationFour4x4(pRes[iResOff:], common.G_kuiDequantCoeff[uiQp][:])
+				pCurMb.uiCbp |= uint8(1 << i)
+			} else { // set zero for an 8x8 pBlock
+				pfSetMemZeroSize64(pRes[iResOff:], 128) // confirmed_safe_unsafe_usage
+				kpNoneZeroCountIdx = kpNoneZeroCountIdx[4:]
+				iBlockOff += 64
+			}
+			iResOff += 64
+		}
+	}
+}
diff --git a/pkg/h264/internal/encoder/intra_plane_full_amd64.go b/pkg/h264/internal/encoder/intra_plane_full_amd64.go
new file mode 100644
index 0000000..75263d6
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_plane_full_amd64.go
@@ -0,0 +1,23 @@
+//go:build amd64
+
+package encoder
+
+// The complete kernels consume every top/left reference before storing output,
+// preserving aliases. They read only the corner, the weighted top samples, and
+// single-byte left samples; no extra horizontal halo is required.
+//
+//go:noescape
+func intraPredPlane16FullSSE2(dst, corner *byte, stride int)
+
+//go:noescape
+func intraPredPlane8FullSSE2(dst, corner *byte, stride int)
+
+func intraPlaneReferencesFit(ref []byte, off int, stride int32, size int) bool {
+	s := int(stride)
+	// Positive strides make the corner and final left sample the endpoints.
+	// Subtract only after off is bounded; size<=16 and int32 strides make the
+	// product safe on amd64. Invalid/nonpositive cases retain the old path,
+	// including its source-first panic order and output slice check.
+	return s > 0 && off > s && off <= len(ref) &&
+		(size-1)*s <= len(ref)-off && size <= len(ref)-(off-s)
+}
diff --git a/pkg/h264/internal/encoder/intra_plane_full_amd64.s b/pkg/h264/internal/encoder/intra_plane_full_amd64.s
new file mode 100644
index 0000000..73fc184
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_plane_full_amd64.s
@@ -0,0 +1,234 @@
+//go:build amd64
+
+// Plane prediction follows the SSE2 reduction used in Cisco OpenH264,
+// codec/encoder/core/x86/intra_pred.asm. Exact byte gathers replace its
+// wider left-column loads so no unchecked horizontal halo is accessed.
+// Copyright (c) 2009-2013, Cisco Systems.
+// All rights reserved.
+// BSD-2-Clause; see LICENSE-OpenH264 in the repository root.
+
+#include "textflag.h"
+
+DATA ·intraPlane16Negative+0(SB)/8, $0xfffbfffafff9fff8
+DATA ·intraPlane16Negative+8(SB)/8, $0xfffffffefffdfffc
+GLOBL ·intraPlane16Negative(SB), RODATA|NOPTR, $16
+
+DATA ·intraPlane16Positive+0(SB)/8, $0x0004000300020001
+DATA ·intraPlane16Positive+8(SB)/8, $0x0008000700060005
+GLOBL ·intraPlane16Positive(SB), RODATA|NOPTR, $16
+
+// Complete 16x16: weighted reductions, rounding, and clipped output.
+TEXT ·intraPredPlane16FullSSE2(SB), NOSPLIT, $0-24
+	MOVQ dst+0(FP), AX
+	MOVQ corner+8(FP), DX
+	MOVQ stride+16(FP), SI
+	PXOR X7, X7
+	MOVQ (DX), X0
+	MOVQ 9(DX), X1
+	PUNPCKLBW X7, X0
+	PUNPCKLBW X7, X1
+	MOVOU ·intraPlane16Negative(SB), X4
+	MOVOU ·intraPlane16Positive(SB), X5
+	PMADDWL X4, X0
+	PMADDWL X5, X1
+	PADDL X1, X0
+	MOVBLZX 16(DX), R8
+
+	// Gather exactly the weighted left samples, omitting the center.
+	LEAQ (SI)(SI*2), R10
+	MOVQ DX, R9
+	MOVBLZX (R9), R11
+	PINSRW $0, R11, X2
+	MOVBLZX (R9)(SI*1), R11
+	PINSRW $1, R11, X2
+	MOVBLZX (R9)(SI*2), R11
+	PINSRW $2, R11, X2
+	MOVBLZX (R9)(R10*1), R11
+	PINSRW $3, R11, X2
+	LEAQ (R9)(SI*4), R9
+	MOVBLZX (R9), R11
+	PINSRW $4, R11, X2
+	MOVBLZX (R9)(SI*1), R11
+	PINSRW $5, R11, X2
+	MOVBLZX (R9)(SI*2), R11
+	PINSRW $6, R11, X2
+	MOVBLZX (R9)(R10*1), R11
+	PINSRW $7, R11, X2
+	LEAQ (DX)(SI*8), R9
+	ADDQ SI, R9
+	MOVBLZX (R9), R11
+	PINSRW $0, R11, X3
+	MOVBLZX (R9)(SI*1), R11
+	PINSRW $1, R11, X3
+	MOVBLZX (R9)(SI*2), R11
+	PINSRW $2, R11, X3
+	MOVBLZX (R9)(R10*1), R11
+	PINSRW $3, R11, X3
+	LEAQ (R9)(SI*4), R9
+	MOVBLZX (R9), R11
+	PINSRW $4, R11, X3
+	MOVBLZX (R9)(SI*1), R11
+	PINSRW $5, R11, X3
+	MOVBLZX (R9)(SI*2), R11
+	PINSRW $6, R11, X3
+	MOVBLZX (R9)(R10*1), R11
+	PINSRW $7, R11, X3
+	ADDL R11, R8
+	SHLL $4, R8
+	PMADDWL X4, X2
+	PMADDWL X5, X3
+	PADDL X3, X2
+
+	// Reduce four dword sums without signed-word overflow.
+	PSHUFL $0x4e, X0, X1
+	PADDL X1, X0
+	PSHUFL $0xb1, X0, X1
+	PADDL X1, X0
+	MOVD X0, BX
+	IMULL $5, BX
+	ADDL $32, BX
+	SARL $6, BX
+	PSHUFL $0x4e, X2, X3
+	PADDL X3, X2
+	PSHUFL $0xb1, X2, X3
+	PADDL X3, X2
+	MOVD X2, DX
+	IMULL $5, DX
+	ADDL $32, DX
+	SARL $6, DX
+
+	// base = a - (size/2-1)*(horizontal+vertical) + 16.
+	MOVL BX, R9
+	ADDL DX, R9
+	IMULL $7, R9
+	SUBL R9, R8
+	ADDL $16, R8
+	MOVD R8, X0
+	PUNPCKLWL X0, X0
+	PSHUFL $0, X0, X0
+	MOVD DX, X1
+	PUNPCKLWL X1, X1
+	PSHUFL $0, X1, X1
+	MOVD BX, X2
+	PUNPCKLWL X2, X2
+	PSHUFL $0, X2, X2
+	MOVOU ·intraPlaneColumns(SB), X3
+	PMULLW X2, X3
+	PADDW X0, X3
+	PSLLW $3, X2
+	MOVQ $16, CX
+plane_full16_loop:
+	MOVOU X3, X4
+	MOVOU X3, X5
+	PADDW X2, X5
+	PSRAW $5, X4
+	PSRAW $5, X5
+	PACKUSWB X5, X4
+	MOVOU X4, (AX)
+	PADDW X1, X3
+	ADDQ $16, AX
+	DECQ CX
+	JNZ plane_full16_loop
+	RET
+
+DATA ·intraPlane8Negative+0(SB)/8, $0xfffffffefffdfffc
+DATA ·intraPlane8Negative+8(SB)/8, $0x0000000000000000
+GLOBL ·intraPlane8Negative(SB), RODATA|NOPTR, $16
+
+DATA ·intraPlane8Positive+0(SB)/8, $0x0004000300020001
+DATA ·intraPlane8Positive+8(SB)/8, $0x0000000000000000
+GLOBL ·intraPlane8Positive(SB), RODATA|NOPTR, $16
+
+// Complete 8x8: weighted reductions, rounding, and clipped output.
+TEXT ·intraPredPlane8FullSSE2(SB), NOSPLIT, $0-24
+	MOVQ dst+0(FP), AX
+	MOVQ corner+8(FP), DX
+	MOVQ stride+16(FP), SI
+	PXOR X7, X7
+	MOVL (DX), X0
+	MOVL 5(DX), X1
+	PUNPCKLBW X7, X0
+	PUNPCKLBW X7, X1
+	MOVOU ·intraPlane8Negative(SB), X4
+	MOVOU ·intraPlane8Positive(SB), X5
+	PMADDWL X4, X0
+	PMADDWL X5, X1
+	PADDL X1, X0
+	MOVBLZX 8(DX), R8
+
+	// Gather exactly the weighted left samples, omitting the center.
+	LEAQ (SI)(SI*2), R10
+	MOVQ DX, R9
+	PXOR X2, X2
+	MOVBLZX (R9), R11
+	PINSRW $0, R11, X2
+	MOVBLZX (R9)(SI*1), R11
+	PINSRW $1, R11, X2
+	MOVBLZX (R9)(SI*2), R11
+	PINSRW $2, R11, X2
+	MOVBLZX (R9)(R10*1), R11
+	PINSRW $3, R11, X2
+	LEAQ (DX)(SI*4), R9
+	ADDQ SI, R9
+	PXOR X3, X3
+	MOVBLZX (R9), R11
+	PINSRW $0, R11, X3
+	MOVBLZX (R9)(SI*1), R11
+	PINSRW $1, R11, X3
+	MOVBLZX (R9)(SI*2), R11
+	PINSRW $2, R11, X3
+	MOVBLZX (R9)(R10*1), R11
+	PINSRW $3, R11, X3
+	ADDL R11, R8
+	SHLL $4, R8
+	PMADDWL X4, X2
+	PMADDWL X5, X3
+	PADDL X3, X2
+
+	// Reduce four dword sums without signed-word overflow.
+	PSHUFL $0x4e, X0, X1
+	PADDL X1, X0
+	PSHUFL $0xb1, X0, X1
+	PADDL X1, X0
+	MOVD X0, BX
+	IMULL $17, BX
+	ADDL $16, BX
+	SARL $5, BX
+	PSHUFL $0x4e, X2, X3
+	PADDL X3, X2
+	PSHUFL $0xb1, X2, X3
+	PADDL X3, X2
+	MOVD X2, DX
+	IMULL $17, DX
+	ADDL $16, DX
+	SARL $5, DX
+
+	// base = a - (size/2-1)*(horizontal+vertical) + 16.
+	MOVL BX, R9
+	ADDL DX, R9
+	IMULL $3, R9
+	SUBL R9, R8
+	ADDL $16, R8
+	MOVD R8, X0
+	PUNPCKLWL X0, X0
+	PSHUFL $0, X0, X0
+	MOVD DX, X1
+	PUNPCKLWL X1, X1
+	PSHUFL $0, X1, X1
+	MOVD BX, X2
+	PUNPCKLWL X2, X2
+	PSHUFL $0, X2, X2
+	MOVOU ·intraPlaneColumns(SB), X3
+	PMULLW X2, X3
+	PADDW X0, X3
+	MOVQ $8, CX
+plane_full8_loop:
+	MOVOU X3, X4
+	PSRAW $5, X4
+	PACKUSWB X4, X4
+	MOVQ X4, (AX)
+	PADDW X1, X3
+	ADDQ $8, AX
+	DECQ CX
+	JNZ plane_full8_loop
+	RET
diff --git a/pkg/h264/internal/encoder/intra_plane_full_amd64_test.go b/pkg/h264/internal/encoder/intra_plane_full_amd64_test.go
new file mode 100644
index 0000000..d912dcc
--- /dev/null
+++ b/pkg/h264/internal/encoder/intra_plane_full_amd64_test.go
@@ -0,0 +1,211 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"bytes"
+	"fmt"
+	"math/rand"
+	"testing"
+)
+
+// Independent widened reference: sum weighted differences around the unused
+// center, then evaluate the plane at each output coordinate.
+func planeFullReference(dst []byte, dstOff int, ref []byte, refOff int, stride int32, size int) {
+	s, center := int(stride), size/2-1
+	var horizontal, vertical int64
+	for distance := 1; distance <= size/2; distance++ {
+		horizontal += int64(distance) * (int64(ref[refOff-s+center+distance]) - int64(ref[refOff-s+center-distance]))
+		vertical += int64(distance) * (int64(ref[refOff-1+(center+distance)*s]) - int64(ref[refOff-1+(center-distance)*s]))
+	}
+	if size == 16 {
+		horizontal, vertical = (horizontal*5+32)>>6, (vertical*5+32)>>6
+	} else {
+		horizontal, vertical = (horizontal*17+16)>>5, (vertical*17+16)>>5
+	}
+	base := 16 * (int64(ref[refOff-s+size-1]) + int64(ref[refOff-1+(size-1)*s]))
+	for y := 0; y < size; y++ {
+		for x := 0; x < size; x++ {
+			value := (base + horizontal*int64(x-center) + vertical*int64(y-center) + 16) >> 5
+			if value < 0 {
+				value = 0
+			} else if value > 255 {
+				value = 255
+			}
+			dst[dstOff+y*size+x] = byte(value)
+		}
+	}
+}
+
+func planeFullPredict(size int) PGetIntraPredFunc {
+	if size == 16 {
+		return intra16Plane
+	}
+	return intra8Plane
+}
+
+func planeFullLayout(size int, stride int32) (off, length int) {
+	first, last, s := 0, 0, int(stride)
+	for i := -1; i < size; i++ {
+		first = min(first, i-s, i*s-1)
+		last = max(last, i-s, i*s-1)
+	}
+	return 3 - first, 3 + last - first + 1
+}
+
+func TestIntraPlaneFullStrideAndPatternParity(t *testing.T) {
+	rng := rand.New(rand.NewSource(0x26491a))
+	for _, size := range []int{8, 16} {
+		for _, stride := range []int32{-1984, -33, -1, 0, 1, 2, 7, 16, 17, 33, 1984} {
+			t.Run(fmt.Sprintf("size%d/stride%d", size, stride), func(t *testing.T) {
+				off, length := planeFullLayout(size, stride)
+				ref := make([]byte, length)
+				for pattern := 0; pattern < 40; pattern++ {
+					for i := range ref {
+						switch pattern {
+						case 0, 1, 2:
+							ref[i] = []byte{0, 128, 255}[pattern]
+						case 3:
+							ref[i] = byte((i & 1) * 255)
+						case 4:
+							ref[i] = byte(i * 17)
+						default:
+							ref[i] = byte(rng.Uint32())
+						}
+					}
+					before := bytes.Clone(ref)
+					want := bytes.Repeat([]byte{0xa5}, size*size+10)
+					got := bytes.Clone(want)
+					planeFullReference(want, 5, ref, off, stride, size)
+					planeFullPredict(size)(got, 5, ref, off, stride)
+					if !bytes.Equal(got, want) || !bytes.Equal(ref, before) {
+						t.Fatalf("pattern%d: pixels, canaries, or source differ", pattern)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestIntraPlaneFullWeightedLanesAndExtremes(t *testing.T) {
+	for _, size := range []int{8, 16} {
+		const stride = 33
+		off, length := planeFullLayout(size, stride)
+		ref := make([]byte, length)
+		check := func(label string) {
+			t.Helper()
+			want, got := make([]byte, size*size), make([]byte, size*size)
+			planeFullReference(want, 0, ref, off, stride, size)
+			planeFullPredict(size)(got, 0, ref, off, stride)
+			if !bytes.Equal(got, want) {
+				t.Fatalf("size%d %s: prediction differs", size, label)
+			}
+		}
+		for value := 0; value < 256; value++ {
+			for i := range ref {
+				ref[i] = byte(value)
+			}
+			check(fmt.Sprintf("constant%d", value))
+		}
+		for _, background := range []byte{0, 128, 255} {
+			for i := range ref {
+				ref[i] = background
+			}
+			for lane := -1; lane < size; lane++ {
+				for _, index := range []int{off - stride + lane, off - 1 + lane*stride} {
+					for _, value := range []byte{0, 1, 127, 128, 254, 255} {
+						ref[index] = value
+						check(fmt.Sprintf("lane%d value%d", lane, value))
+					}
+					ref[index] = background
+				}
+			}
+		}
+		for signs := 0; signs < 4; signs++ {
+			for i := -1; i < size; i++ {
+				top, left := byte(0), byte(0)
+				if (i >= size/2) != (signs&1 != 0) {
+					top = 255
+				}
+				if (i >= size/2) != (signs&2 != 0) {
+					left = 255
+				}
+				ref[off-stride+i], ref[off-1+i*stride] = top, left
+			}
+			check(fmt.Sprintf("extreme signs%d", signs))
+		}
+	}
+}
+
+func TestIntraPlaneFullAliases(t *testing.T) {
+	for _, size := range []int{8, 16} {
+		for _, stride := range []int32{-33, -1, 0, 1, 2, 17, 33, 1984} {
+			off, length := planeFullLayout(size, stride)
+			for _, dstOff := range []int{0, max(0, off-int(stride)-1), off - 1, off, length - 1} {
+				want := make([]byte, max(length, dstOff+size*size)+7)
+				for i := range want {
+					want[i] = byte(i*137 + 11)
+				}
+				got := bytes.Clone(want)
+				planeFullReference(want, dstOff, want[:length], off, stride, size)
+				planeFullPredict(size)(got, dstOff, got[:length], off, stride)
+				if !bytes.Equal(got, want) {
+					t.Fatalf("size%d stride%d destination%d: aliased storage differs", size, stride, dstOff)
+				}
+			}
+		}
+	}
+}
+
+// Preserve the old SIMD wrapper exactly for invalid-input behavior; the C
+// predictor has different partial destination writes on short output slices.
+func planeFullLegacy(dst []byte, dstOff int, ref []byte, refOff int, stride int32, size int) {
+	base, horizontal, vertical := intraPlaneCoefficients(ref, refOff, stride, size)
+	intraPredPlaneSSE2(dst[dstOff:dstOff+size*size], base, horizontal, vertical, size)
+}
+
+func planeFullPanic(call func()) (message string) {
+	defer func() {
+		if value := recover(); value != nil {
+			message = fmt.Sprintf("%T: %v", value, value)
+		}
+	}()
+	call()
+	return ""
+}
+
+func TestIntraPlaneFullInvalidInputParity(t *testing.T) {
+	const stride = 33
+	for _, size := range []int{8, 16} {
+		off, length := planeFullLayout(size, stride)
+		type shape struct {
+			refOff, refLen, dstOff, dstLen int
+			stride                         int32
+		}
+		var cases []shape
+		for n := 0; n <= length; n++ {
+			cases = append(cases, shape{off, n, 3, size*size + 3, stride})
+		}
+		for n := 0; n <= size*size+3; n++ {
+			cases = append(cases, shape{off, length, 3, n, stride})
+		}
+		for _, badOff := range []int{-1, 0, int(^uint(0) >> 1), -int(^uint(0)>>1) - 1} {
+			cases = append(cases, shape{badOff, length, 0, 0, stride}, shape{off, length, badOff, size * size, stride})
+		}
+		for _, badStride := range []int32{-2147483648, 2147483647, 0, -33} {
+			cases = append(cases, shape{off, length, 3, size*size + 3, badStride})
+		}
+		for _, tc := range cases {
+			var want [2048]byte
+			for i := range want {
+				want[i] = byte(i*137 + 11)
+			}
+			got := want
+			wantPanic := planeFullPanic(func() { planeFullLegacy(want[:tc.dstLen], tc.dstOff, want[:tc.refLen], tc.refOff, tc.stride, size) })
+			gotPanic := planeFullPanic(func() { planeFullPredict(size)(got[:tc.dstLen], tc.dstOff, got[:tc.refLen], tc.refOff, tc.stride) })
+			if gotPanic != wantPanic || got != want {
+				t.Fatalf("size%d case%+v: panic%q/%q or partial state differs", size, tc, gotPanic, wantPanic)
+			}
+		}
+	}
+}
