+				}
+			}
+			var best, x, y int32
+			b.ReportAllocs()
+			for b.Loop() {
+				best = tc.best
+				x, y = 0, 0
+				WelsMeSadCostSelect(tc.costs[:], table[:], 1024, &best, 28, -12, &x, &y)
