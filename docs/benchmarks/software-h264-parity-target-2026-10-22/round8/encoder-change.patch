diff --git a/pkg/h264/internal/encoder/sample_initial_two_amd64.go b/pkg/h264/internal/encoder/sample_initial_two_amd64.go
new file mode 100644
index 0000000..6f6279f
--- /dev/null
+++ b/pkg/h264/internal/encoder/sample_initial_two_amd64.go
@@ -0,0 +1,62 @@
+//go:build amd64
+
+package encoder
+
+import "github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+
+func initSampleSadTwoSIMD(samples *SSampleDealingFunc, flags uint32) {
+	samples.bSampleSadTwo = flags&common.WELS_CPU_SSE2 != 0
+}
+
+//go:noescape
+func sadTwoSSE2(enc *byte, encStride int, first, second *byte, refStride, width, height int) (firstCost, secondCost int32)
+
+// The existing checked SAD wrappers reject negative strides. Returning false
+// preserves their original panic order for malformed inputs, including slice
+// lengths shorter than capacity. Zero and overlapping rows remain valid.
+func initialSadBlockValid(buf []byte, off int, stride int32, width, height int) bool {
+	span := int64(height-1)*int64(stride) + int64(width)
+	return stride >= 0 && off >= 0 && int64(off) <= int64(len(buf))-span
+}
+
+// meInitialSadTwo has no indirect calls: all pointers passed to assembly stay
+// tracked and noescape, including a caller's stack-local motion state. It is
+// only called for one already-clipped, distinct MVC and the unmodified built-in
+// SAD table capability.
+func meInitialSadTwo(me *SWelsME, initial, mvc SMVUnitXY, initialOff int,
+	encStride, refStride int32) (best SMVUnitXY, bestOff int, bestCost int32, ok bool) {
+	width, height := 8, 8
+	switch me.uiBlockSize {
+	case BLOCK_16x16:
+		width, height = 16, 16
+	case BLOCK_16x8:
+		width, height = 16, 8
+	case BLOCK_8x16:
+		height = 16
+	case BLOCK_8x8:
+	case BLOCK_8x4:
+		height = 4
+	default:
+		return SMVUnitXY{}, 0, 0, false
+	}
+	// Preserve the legacy int32 multiplication/addition before conversion to int.
+	mvcOff := me.iRefMbOff + int(int32(mvc.iMvY)*refStride+int32(mvc.iMvX))
+	if !initialSadBlockValid(me.pEncMb, me.iEncMbOff, encStride, width, height) ||
+		!initialSadBlockValid(me.pRefMb, initialOff, refStride, width, height) ||
+		!initialSadBlockValid(me.pRefMb, mvcOff, refStride, width, height) {
+		return SMVUnitXY{}, 0, 0, false
+	}
+	first, second := sadTwoSSE2(&me.pEncMb[me.iEncMbOff], int(encStride),
+		&me.pRefMb[initialOff], &me.pRefMb[mvcOff], int(refStride), width, height)
+	// Read MVD entries in the same order as the two original candidates. All
+	// pixel reads above are validated and read-only, so table panics retain the
+	// original observable state. A tie always retains the initial predictor.
+	first += COST_MVD(me.pMvdCost, me.iMvdCostOff,
+		int32(initial.iMvX)*4-int32(me.sMvp.iMvX), int32(initial.iMvY)*4-int32(me.sMvp.iMvY))
+	second += COST_MVD(me.pMvdCost, me.iMvdCostOff,
+		int32(mvc.iMvX)*4-int32(me.sMvp.iMvX), int32(mvc.iMvY)*4-int32(me.sMvp.iMvY))
+	if second < first {
+		return mvc, mvcOff, second, true
+	}
+	return initial, initialOff, first, true
+}
diff --git a/pkg/h264/internal/encoder/sample_initial_two_amd64.s b/pkg/h264/internal/encoder/sample_initial_two_amd64.s
new file mode 100644
index 0000000..9f2dff7
--- /dev/null
+++ b/pkg/h264/internal/encoder/sample_initial_two_amd64.s
@@ -0,0 +1,100 @@
+//go:build amd64
+
+#include "textflag.h"
+
+// Two independent SADs with one encoded load per row. Exact-width loads,
+// independent accumulators and four-row bands; no stores to input buffers.
+// Width is 8 or 16; height is a positive multiple of four through 16.
+// func sadTwoSSE2(enc *byte, encStride int, first, second *byte, refStride, width, height int) (firstCost, secondCost int32)
+TEXT ·sadTwoSSE2(SB), NOSPLIT, $0-64
+	MOVQ enc+0(FP), AX
+	MOVQ encStride+8(FP), CX
+	MOVQ first+16(FP), DX
+	MOVQ second+24(FP), SI
+	MOVQ refStride+32(FP), BX
+	MOVQ height+48(FP), DI
+	SHRQ $2, DI
+	LEAQ (CX)(CX*2), R8
+	LEAQ (BX)(BX*2), R9
+	PXOR X6, X6
+	PXOR X7, X7
+	PXOR X8, X8
+	PXOR X9, X9
+	CMPQ width+40(FP), $16
+	JE sad_two_16
+sad_two_8:
+	MOVQ (AX), X0
+	MOVQ (AX)(CX*1), X1
+	MOVHPS (AX)(CX*2), X0
+	MOVHPS (AX)(R8*1), X1
+	MOVQ (DX), X2
+	MOVQ (DX)(BX*1), X3
+	MOVHPS (DX)(BX*2), X2
+	MOVHPS (DX)(R9*1), X3
+	MOVQ (SI), X4
+	MOVQ (SI)(BX*1), X5
+	MOVHPS (SI)(BX*2), X4
+	MOVHPS (SI)(R9*1), X5
+	PSADBW X0, X2
+	PSADBW X1, X3
+	PSADBW X0, X4
+	PSADBW X1, X5
+	PADDD X2, X6
+	PADDD X3, X7
+	PADDD X4, X8
+	PADDD X5, X9
+	LEAQ (AX)(CX*4), AX
+	LEAQ (DX)(BX*4), DX
+	LEAQ (SI)(BX*4), SI
+	DECQ DI
+	JNZ sad_two_8
+	JMP sad_two_reduce
+sad_two_16:
+	MOVOU (AX), X0
+	MOVOU (DX), X2
+	MOVOU (SI), X4
+	PSADBW X0, X2
+	PSADBW X0, X4
+	PADDD X2, X6
+	PADDD X4, X8
+	MOVOU (AX)(CX*1), X0
+	MOVOU (DX)(BX*1), X2
+	MOVOU (SI)(BX*1), X4
+	PSADBW X0, X2
+	PSADBW X0, X4
+	PADDD X2, X7
+	PADDD X4, X9
+	MOVOU (AX)(CX*2), X0
+	MOVOU (DX)(BX*2), X2
+	MOVOU (SI)(BX*2), X4
+	PSADBW X0, X2
+	PSADBW X0, X4
+	PADDD X2, X6
+	PADDD X4, X8
+	MOVOU (AX)(R8*1), X0
+	MOVOU (DX)(R9*1), X2
+	MOVOU (SI)(R9*1), X4
+	PSADBW X0, X2
+	PSADBW X0, X4
+	PADDD X2, X7
+	PADDD X4, X9
+	LEAQ (AX)(CX*4), AX
+	LEAQ (DX)(BX*4), DX
+	LEAQ (SI)(BX*4), SI
+	DECQ DI
+	JNZ sad_two_16
+sad_two_reduce:
+	PADDD X7, X6
+	PADDD X9, X8
+	MOVOU X6, X0
+	MOVOU X8, X1
+	PSRLDQ $8, X0
+	PSRLDQ $8, X1
+	PADDD X0, X6
+	PADDD X1, X8
+	// MOVD is a 64-bit store in the Go assembler; returns are int32.
+	MOVQ X6, AX
+	MOVL AX, firstCost+56(FP)
+	MOVQ X8, AX
+	MOVL AX, secondCost+60(FP)
+	RET
diff --git a/pkg/h264/internal/encoder/sample_initial_two_amd64_test.go b/pkg/h264/internal/encoder/sample_initial_two_amd64_test.go
new file mode 100644
index 0000000..81b8c20
--- /dev/null
+++ b/pkg/h264/internal/encoder/sample_initial_two_amd64_test.go
@@ -0,0 +1,374 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"fmt"
+	"math"
+	"math/rand"
+	"reflect"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+)
+
+func initialTwoScalar(a []byte, aOff, aStride int, b []byte, bOff, bStride, width, height int) int32 {
+	var sum int32
+	for y := range height {
+		for x := range width {
+			d := int32(a[aOff+y*aStride+x]) - int32(b[bOff+y*bStride+x])
+			if d < 0 {
+				d = -d
+			}
+			sum += d
+		}
+	}
+	return sum
+}
+
+func TestInitialSadTwoKernelParity(t *testing.T) {
+	rng := rand.New(rand.NewSource(211))
+	for _, width := range []int{8, 16} {
+		for _, height := range []int{4, 8, 12, 16} {
+			for _, stride := range []int{0, 3, width, 31, 2048, -31} {
+				t.Run(fmt.Sprintf("%dx%d/stride%d", width, height, stride), func(t *testing.T) {
+					spanStride := stride
+					if spanStride < 0 {
+						spanStride = -spanStride
+					}
+					length := (height-1)*spanStride + width + 7
+					a, first, second := make([]byte, length), make([]byte, length), make([]byte, length)
+					off := 3
+					if stride < 0 {
+						off += (height - 1) * spanStride
+					}
+					check := func() {
+						t.Helper()
+						want0 := initialTwoScalar(a, off, stride, first, off, stride, width, height)
+						want1 := initialTwoScalar(a, off, stride, second, off, stride, width, height)
+						got0, got1 := sadTwoSSE2(&a[off], stride, &first[off], &second[off], stride, width, height)
+						if got0 != want0 || got1 != want1 {
+							t.Fatalf("got=(%d,%d), want=(%d,%d)", got0, got1, want0, want1)
+						}
+					}
+					for scenario := range 16 {
+						for i := range a {
+							a[i], first[i], second[i] = byte(rng.Intn(256)), byte(rng.Intn(256)), byte(rng.Intn(256))
+							if scenario < 8 {
+								a[i], first[i], second[i] = byte((scenario&1)*255), byte(((scenario>>1)&1)*255), byte(((scenario>>2)&1)*255)
+							}
+						}
+						check()
+					}
+					clear(a)
+					clear(first)
+					clear(second)
+					for y := range height {
+						for x := range width {
+							at := off + y*stride + x
+							a[at], first[at], second[at] = 91, 255, 3
+							check()
+							a[at], first[at], second[at] = 0, 0, 0
+						}
+					}
+					for i := range a {
+						a[i] = byte(rng.Intn(256))
+					}
+					// All inputs may alias, including different offsets into one allocation.
+					got0, got1 := sadTwoSSE2(&a[off], stride, &a[off], &a[off+1], stride, width, height)
+					want := initialTwoScalar(a, off, stride, a, off+1, stride, width, height)
+					if got0 != 0 || got1 != want {
+						t.Fatalf("alias got=(%d,%d), want=(0,%d)", got0, got1, want)
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestInitialSadTwoMixedStrides(t *testing.T) {
+	for _, width := range []int{8, 16} {
+		for _, height := range []int{4, 8, 16} {
+			for _, strides := range [][2]int{{0, 31}, {31, 0}, {3, 33}, {17, 33}, {-33, 17}, {17, -33}} {
+				makeBlock := func(stride, seed int) ([]byte, int) {
+					absStride, off := stride, 3
+					if stride < 0 {
+						absStride = -stride
+						off += (height - 1) * absStride
+					}
+					buf := make([]byte, (height-1)*absStride+width+3)
+					for i := range buf {
+						buf[i] = byte(i*37 + seed)
+					}
+					return buf, off
+				}
+				a, aOff := makeBlock(strides[0], 3)
+				first, refOff := makeBlock(strides[1], 17)
+				second, _ := makeBlock(strides[1], 99)
+				got0, got1 := sadTwoSSE2(&a[aOff], strides[0], &first[refOff], &second[refOff], strides[1], width, height)
+				want0 := initialTwoScalar(a, aOff, strides[0], first, refOff, strides[1], width, height)
+				want1 := initialTwoScalar(a, aOff, strides[0], second, refOff, strides[1], width, height)
+				if got0 != want0 || got1 != want1 {
+					t.Fatalf("%dx%d strides=%v: got=(%d,%d), want=(%d,%d)", width, height, strides, got0, got1, want0, want1)
+				}
+			}
+		}
+	}
+}
+
+type initialTwoOutcome struct {
+	mv, directional SMVUnitXY
+	refOff          int
+	cost, satd      uint32
+	directionalCost int32
+	mvcCount        uint8
+	early           bool
+	panicText       string
+	callbackState   []int64
+}
+
+func initialTwoRun(f *initialTwoFixture, enabled, direction bool) (out initialTwoOutcome) {
+	f.funcs.sSampleDealingFuncs.bSampleSadTwo = enabled
+	f.funcs.pfCheckDirectionalMv = func(pSad PSampleSadSatdCostFunc, me *SWelsME, min, max SMVUnitXY, encStride, refStride int32, cost *int32) bool {
+		out.callbackState = append(out.callbackState, int64(me.sMv.iMvX), int64(me.sMv.iMvY), int64(me.iRefMbOff), int64(me.uiSadCost), int64(*cost), int64(encStride), int64(refStride), int64(f.slice.uiMvcNum))
+		if direction {
+			*cost = 2
+			return true
+		}
+		return false
+	}
+	defer func() {
+		if value := recover(); value != nil {
+			out.panicText = fmt.Sprint(value)
+		}
+		out.mv, out.directional = f.me.sMv, f.me.sDirectionalMv
+		out.refOff, out.cost, out.satd = f.me.iRefMbOff, f.me.uiSadCost, f.me.uiSatdCost
+		out.directionalCost = f.me.iDirectionalSadCost
+		out.mvcCount = f.slice.uiMvcNum
+	}()
+	out.early = WelsMotionEstimateInitialPoint(&f.funcs, &f.me, &f.slice, f.stride, f.stride)
+	return out
+}
+
+func TestInitialSadTwoWholeSearchParity(t *testing.T) {
+	for _, shape := range initialTwoShapes {
+		for _, scenario := range []string{"mvcWins", "mvpWins", "tie", "duplicate", "fiveMVC", "zeroMVC", "clipped", "negativeRound", "costWins", "zeroStride", "overlapStride", "inputAlias"} {
+			for _, direction := range []bool{false, true} {
+				for _, early := range []uint32{0, 90000} {
+					t.Run(fmt.Sprintf("%dx%d/%s/direction%v/early%d", shape[0], shape[1], scenario, direction, early), func(t *testing.T) {
+						var outcomes [2]initialTwoOutcome
+						for route := range outcomes {
+							f := newInitialTwoFixture(shape[0], shape[1], uint8(shape[2]), 32, scenario)
+							f.me.uSadPredISatd = early
+							switch scenario {
+							case "clipped":
+								f.me.sMvp, f.slice.sMvc[0] = SMVUnitXY{-100, 100}, SMVUnitXY{100, -100}
+							case "negativeRound":
+								f.me.sMvp, f.slice.sMvc[0] = SMVUnitXY{-3, -6}, SMVUnitXY{-5, -7}
+							case "costWins":
+								clear(f.me.pRefMb)
+								clear(f.me.pEncMb)
+								f.me.pMvdCost[512] = 60000
+							case "zeroStride":
+								f.stride = 0
+							case "overlapStride":
+								f.stride = 3
+							case "inputAlias":
+								f.me.pEncMb, f.me.iEncMbOff = f.me.pRefMb, f.me.iRefMbOff+1
+							}
+							outcomes[route] = initialTwoRun(f, route == 1, direction)
+						}
+						if outcomes[0].panicText != "" || !reflect.DeepEqual(outcomes[0], outcomes[1]) {
+							t.Fatalf("legacy=%+v\nbatch=%+v", outcomes[0], outcomes[1])
+						}
+						if scenario == "tie" && !direction && outcomes[1].mv != (SMVUnitXY{}) {
+							t.Fatalf("tie replaced MVP: %+v", outcomes[1])
+						}
+					})
+				}
+			}
+		}
+	}
+}
+
+func TestInitialSadTwoMalformedFallback(t *testing.T) {
+	for _, scenario := range []string{"shortEnc", "shortRef", "empty", "encOff", "refOff", "negativeStride", "hugeStride", "overflowOff", "mvdFirst", "mvdSecond", "tooManyMVC"} {
+		t.Run(scenario, func(t *testing.T) {
+			var outcomes [2]initialTwoOutcome
+			for route := range outcomes {
+				f := newInitialTwoFixture(16, 16, BLOCK_16x16, 32, "mvcWins")
+				switch scenario {
