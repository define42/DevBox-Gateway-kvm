@@ -0,0 +1,61 @@
+//go:build linux && amd64
+
+package encoder
+
+import (
+	"fmt"
+	"testing"
+
+	"golang.org/x/sys/cpu"
+	"golang.org/x/sys/unix"
+)
+
+func TestIntraVaaSIMDExactRowsGuardPages(t *testing.T) {
+	if !cpu.X86.HasSSSE3 {
+		t.Skip("SSSE3 unavailable")
+	}
+	page := unix.Getpagesize()
+	for _, atEnd := range []bool{false, true} {
+		t.Run(fmt.Sprintf("atEnd%v", atEnd), func(t *testing.T) {
+			mapping, err := unix.Mmap(-1, 0, 33*page, unix.PROT_READ|unix.PROT_WRITE, unix.MAP_ANON|unix.MAP_PRIVATE)
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() {
+				if err := unix.Munmap(mapping); err != nil {
+					t.Error(err)
+				}
+			})
+			start := page
+			if atEnd {
+				start += page - 16
+			}
+			for y := range 16 {
+				for x := range 16 {
+					mapping[start+y*2*page+x] = byte(y*37 + x*19 + 7)
+				}
+			}
+			for p := range 33 {
+				prot := unix.PROT_NONE
+				if p&1 != 0 {
+					prot = unix.PROT_READ
+				}
+				if err := unix.Mprotect(mapping[p*page:(p+1)*page], prot); err != nil {
+					t.Fatal(err)
+				}
+			}
+			end := start + 30*page + 16
+			src := mapping[start:end:end]
+			for _, stride := range []int32{int32(2 * page), -int32(2 * page), 0} {
+				off := 0
+				if stride < 0 {
+					off = 30 * page
+				}
+				want := intraVaaReference(src, off, stride)
+				if got := AnalysisVaaInfoIntra_ssse3(src, off, stride); got != want {
+					t.Fatalf("stride=%d: got=%d want=%d", stride, got, want)
+				}
+			}
+		})
+	}
+}
diff --git a/pkg/h264/internal/encoder/vaa_intra_simd_amd64.go b/pkg/h264/internal/encoder/vaa_intra_simd_amd64.go
new file mode 100644
index 0000000..5b3f7b2
--- /dev/null
+++ b/pkg/h264/internal/encoder/vaa_intra_simd_amd64.go
@@ -0,0 +1,29 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+	"golang.org/x/sys/cpu"
+)
+
+//go:noescape
+func intraVaaSSSE3(src *byte, stride int) int32
+
+func initIntraVaaSIMD(funcs *SWelsFuncPtrList, flags uint32) {
+	if flags&common.WELS_CPU_SSSE3 != 0 && cpu.X86.HasSSSE3 {
+		funcs.pfGetVarianceFromIntraVaa = AnalysisVaaInfoIntra_ssse3
+	}
+}
+
+// AnalysisVaaInfoIntra_ssse3 computes the variance of sixteen floored 4x4
+// means. Every source row is checked before the exact sixteen-byte SIMD load.
+func AnalysisVaaInfoIntra_ssse3(src []byte, off int, stride int32) int32 {
+	// Retain the scalar signed-stride path and its int32-derived row offsets
+	// when multiplying the stride by four would overflow that representation.
+	if !cpu.X86.HasSSSE3 || stride < 0 || stride > (1<<31-1)/4 {
+		return AnalysisVaaInfoIntra_c(src, off, stride)
+	}
+	checkSampleSIMDBlock(src, off, stride, 16, 16)
+	return intraVaaSSSE3(&src[off], int(stride))
+}
diff --git a/pkg/h264/internal/encoder/vaa_intra_simd_amd64.s b/pkg/h264/internal/encoder/vaa_intra_simd_amd64.s
new file mode 100644
index 0000000..d7142d3
--- /dev/null
+++ b/pkg/h264/internal/encoder/vaa_intra_simd_amd64.s
@@ -0,0 +1,66 @@
+//go:build amd64
+
+// Four-by-four means and variance follow AnalysisVaaInfoIntra_ssse3 in
+// OpenH264's codec/common/x86/vaa.asm.
+// Copyright (c) 2010-2013, Cisco Systems. All rights reserved.
+// BSD-2-Clause; see LICENSE-OpenH264 in the repository root.
+
+#include "textflag.h"
+
+// The checked caller supplies sixteen complete rows. Read-only overlapping
+// rows and zero stride are valid. Each byte pair sums to at most 510, each
+// 4x4 sum to 4080 and each mean to 255. The mean sum is at most 4080; its
+// square (16646400) and all sixteen squared means (1040400) fit in int32.
+// func intraVaaSSSE3(src *byte, stride int) int32
+TEXT ·intraVaaSSSE3(SB), NOSPLIT, $0-20
+    MOVQ src+0(FP), AX
+    MOVQ stride+8(FP), CX
+    LEAQ (CX)(CX*2), DX
+    MOVL $0x01010101, R8
+    MOVL R8, X7
+    PSHUFL $0, X7, X7
+    PXOR X6, X6
+    PXOR X8, X8
+    PXOR X9, X9
+    MOVQ $4, DI
+intra_vaa_rows:
+    MOVOU (AX), X0
+    MOVOU (AX)(CX*1), X1
+    MOVOU (AX)(CX*2), X2
+    MOVOU (AX)(DX*1), X3
+    PMADDUBSW X7, X0
+    PMADDUBSW X7, X1
+    PMADDUBSW X7, X2
+    PMADDUBSW X7, X3
+    PADDW X1, X0
+    PADDW X3, X2
+    PADDW X2, X0
+    PHADDW X6, X0
+    PSRLW $4, X0
+    PADDW X0, X8
+    PMADDWL X0, X0
+    PADDD X0, X9
+    LEAQ (AX)(CX*4), AX
+    DECQ DI
+    JNZ intra_vaa_rows
+
+    // The four accumulated mean columns occupy only the low four words.
+    MOVOU X8, X0
+    PSRLDQ $4, X0
+    PADDW X0, X8
+    MOVOU X8, X0
+    PSRLDQ $2, X0
+    PADDW X0, X8
+    MOVL X8, CX
+    ANDL $0xffff, CX
+    IMULL CX, CX
+    SHRL $4, CX
+
+    // PMADDWD formed two useful dwords per band; the remaining two are zero.
+    MOVOU X9, X0
+    PSRLDQ $4, X0
+    PADDD X0, X9
+    MOVL X9, AX
+    SUBL CX, AX
+    MOVL AX, ret+16(FP)
+    RET
diff --git a/pkg/h264/internal/encoder/vaa_intra_simd_amd64_test.go b/pkg/h264/internal/encoder/vaa_intra_simd_amd64_test.go
new file mode 100644
index 0000000..9a80ff7
--- /dev/null
+++ b/pkg/h264/internal/encoder/vaa_intra_simd_amd64_test.go
@@ -0,0 +1,168 @@
+//go:build amd64
+
+package encoder
+
+import (
+	"bytes"
+	"fmt"
+	"math/rand"
+	"reflect"
+	"testing"
+
+	"github.com/define42/DevBox-Gateway-kvm/pkg/h264/internal/common"
+	"golang.org/x/sys/cpu"
+)
+
+// Use direct spatial indexing and int64 reduction independently of both the
+// scalar implementation's block offsets and the SIMD pairwise row reduction.
+func intraVaaReference(src []byte, off int, stride int32) int32 {
+	var sum, squares int64
+	for by := range 4 {
+		for bx := range 4 {
+			var total int64
+			for y := range 4 {
+				for x := range 4 {
+					total += int64(src[off+(by*4+y)*int(stride)+bx*4+x])
+				}
+			}
+			mean := total / 16
+			sum += mean
+			squares += mean * mean
+		}
+	}
+	return int32(squares - sum*sum/16)
+}
+
+func TestIntraVaaSIMDDispatch(t *testing.T) {
+	var funcs SWelsFuncPtrList
+	for _, flags := range []uint32{0, common.WELS_CPU_SSE2, common.WELS_CPU_SSSE3, 0} {
+		InitIntraAnalysisVaaInfo(&funcs, flags)
+		want := reflect.ValueOf(AnalysisVaaInfoIntra_c).Pointer()
+		if flags&common.WELS_CPU_SSSE3 != 0 && cpu.X86.HasSSSE3 {
+			want = reflect.ValueOf(AnalysisVaaInfoIntra_ssse3).Pointer()
+		}
+		if got := reflect.ValueOf(funcs.pfGetVarianceFromIntraVaa).Pointer(); got != want {
+			t.Fatalf("flags=%x selected unexpected intra analysis", flags)
+		}
+		if reflect.ValueOf(funcs.pfGetMbSignFromInterVaa).Pointer() != reflect.ValueOf(MdInterAnalysisVaaInfo_c).Pointer() ||
+			reflect.ValueOf(funcs.pfUpdateMbMv).Pointer() != reflect.ValueOf(UpdateMbMv_c).Pointer() {
+			t.Fatal("intra dispatch changed an unrelated callback")
+		}
+	}
+}
+
+func TestIntraVaaSIMDParity(t *testing.T) {
+	rng := rand.New(rand.NewSource(0x264a))
+	for _, stride := range []int32{0, 1, 3, 7, 15, 16, 17, 31, 64, 2048, -1, -3, -16, -31} {
+		t.Run(fmt.Sprintf("stride%d", stride), func(t *testing.T) {
+			absStride := int(stride)
+			if absStride < 0 {
+				absStride = -absStride
+			}
+			for offset := range 8 {
+				off := offset
+				if stride < 0 {
+					off += 15 * absStride
+				}
+				src := make([]byte, offset+15*absStride+16)
+				for pattern := range 40 {
+					rng.Read(src)
+					for i := range src {
+						switch pattern {
+						case 0:
+							src[i] = 0
+						case 1:
+							src[i] = 255
+						case 2:
+							src[i] = byte((i & 1) * 255)
+						case 3:
+							src[i] = byte(i*17 + i/7)
+						}
+					}
+					before := bytes.Clone(src)
+					want := intraVaaReference(src, off, stride)
+					if got := AnalysisVaaInfoIntra_c(src, off, stride); got != want {
+						t.Fatalf("scalar offset=%d pattern=%d: got=%d want=%d", offset, pattern, got, want)
+					}
+					if got := AnalysisVaaInfoIntra_ssse3(src, off, stride); got != want {
+						t.Fatalf("SIMD offset=%d pattern=%d: got=%d want=%d", offset, pattern, got, want)
+					}
+					if !bytes.Equal(src, before) {
+						t.Fatal("analysis modified input")
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestIntraVaaSIMDFloorAndLanes(t *testing.T) {
+	const stride, off = 23, 3
+	src := make([]byte, off+15*stride+16)
+	for y := range 16 {
+		for x := range 16 {
+			at := off + y*stride + x
+			for _, value := range []byte{15, 16, 31, 32, 127, 255} {
+				src[at] = value
+				mean := int32(value / 16)
+				want := mean*mean - mean*mean/16
+				if got := AnalysisVaaInfoIntra_ssse3(src, off, stride); got != want {
+					t.Fatalf("pixel(%d,%d)=%d: got=%d want=%d", x, y, value, got, want)
+				}
+			}
+			src[at] = 0
+		}
+	}
+	// Constant blocks exercise every mean lane and the maximum variance.
+	for pattern := range 3 {
+		for y := range 16 {
+			for x := range 16 {
+				block := (y/4)*4 + x/4
+				value := byte(255)
+				if pattern == 0 {
+					value = byte((block & 1) * 255)
+				}
+				if pattern == 1 {
+					value = byte(block * 17)
+				}
+				src[off+y*stride+x] = value
+			}
+		}
+		want := intraVaaReference(src, off, stride)
+		if pattern == 0 && want != 260100 {
+			t.Fatalf("maximum variance oracle=%d", want)
+		}
+		if pattern == 2 && want != 0 {
+			t.Fatalf("constant variance oracle=%d", want)
+		}
+		if got := AnalysisVaaInfoIntra_ssse3(src, off, stride); got != want {
+			t.Fatalf("block pattern=%d: got=%d want=%d", pattern, got, want)
+		}
+	}
+}
+
+func TestIntraVaaSIMDVisibleBounds(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		off    int
+		stride int32
+		length int
+	}{
+		{"short-with-capacity", 3, 32, 3 + 15*32 + 15},
+		{"short-zero-stride", 0, 0, 15},
+		{"negative-offset", -1, 32, 1024},
+		{"overflowing-offset", int(^uint(0) >> 1), 32, 1024},
+		{"negative-stride-low-end", 15*32 - 1, -32, 1024},
+		{"negative-stride-high-end", 15 * 32, -32, 15*32 + 15},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			src := make([]byte, 2048)[:tc.length]
+			defer func() {
+				if recover() == nil {
+					t.Fatal("invalid visible span did not panic")
+				}
+			}()
+			AnalysisVaaInfoIntra_ssse3(src, tc.off, tc.stride)
+		})
+	}
+}
