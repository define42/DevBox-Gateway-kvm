+	MOVQ (DX)(BX*2), X2
+	MOVQ (DX)(R9*1), X3
+	MOVQ X0, (AX)
+	MOVQ X1, (AX)(CX*1)
+	MOVQ X2, (AX)(CX*2)
+	MOVQ X3, (AX)(R8*1)
+	LEAQ (DX)(BX*4), DX
+	LEAQ (AX)(CX*4), AX
+	MOVQ (DX), X0
+	MOVQ (DX)(BX*1), X1
+	MOVQ (DX)(BX*2), X2
+	MOVQ (DX)(R9*1), X3
+	MOVQ X0, (AX)
+	MOVQ X1, (AX)(CX*1)
+	MOVQ X2, (AX)(CX*2)
+	MOVQ X3, (AX)(R8*1)
+	LEAQ (DX)(BX*4), DX
+	LEAQ (AX)(CX*4), AX
+	MOVQ (DX), X0
+	MOVQ (DX)(BX*1), X1
+	MOVQ (DX)(BX*2), X2
+	MOVQ (DX)(R9*1), X3
+	MOVQ X0, (AX)
+	MOVQ X1, (AX)(CX*1)
+	MOVQ X2, (AX)(CX*2)
+	MOVQ X3, (AX)(R8*1)
+	LEAQ (DX)(BX*4), DX
+	LEAQ (AX)(CX*4), AX
+	MOVQ (DX), X0
+	MOVQ (DX)(BX*1), X1
+	MOVQ (DX)(BX*2), X2
+	MOVQ (DX)(R9*1), X3
+	MOVQ X0, (AX)
+	MOVQ X1, (AX)(CX*1)
+	MOVQ X2, (AX)(CX*2)
+	MOVQ X3, (AX)(R8*1)
