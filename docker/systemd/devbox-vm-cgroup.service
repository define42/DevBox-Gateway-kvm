[Unit]
Description=Prepare the delegated DevBox VM memory and process cgroup
Before=docker.service

[Service]
Type=exec
Slice=devbox.slice
Delegate=memory pids
DelegateSubgroup=supervisor
ExecStart=/usr/bin/sleep infinity
ExecStartPost=/usr/local/libexec/devbox-prepare-cgroup

[Install]
WantedBy=multi-user.target
